# CPalius CMF — statik analiz yapılandırması
#
# NEDEN "phpstan.neon.dist"?
#   ".dist" sürümü depoya girer ve herkes için geçerli olan taban
#   yapılandırmadır. Bir geliştirici yerel olarak ezmek isterse yanına
#   "phpstan.neon" koyar; PHPStan onu tercih eder, ".dist" bozulmaz.
#   (phpunit.xml.dist ile aynı gerekçe.)
#
# NEDEN BASELINE VAR?
#   Bu kod tabanı 511 dosyaya kadar hiç level 0'ın üstünde analiz edilmedi.
#   Bütün mevcut borcu tek seferde temizlemeye çalışmak ya haftalar sürer ya
#   da aceleyle yapılmış, test edilmemiş bir refactor dalgası üretir. Bunun
#   yerine borç "phpstan-baseline.neon" dosyasında DONDURULUYOR: bugünkü
#   hatalar CI'ı kırmaz, ama YENİ yazılan her satır tam seviyede denetlenir.
#   Baseline bir hedef değil, küçülmesi gereken bir bakiyedir — bir dosyaya
#   dokunduğunda oradaki girdileri de temizlemek beklenen davranıştır.

includes:
    - phpstan-baseline.neon
    - cp-includes/vendor/phpstan/phpstan-symfony/extension.neon
    - cp-includes/vendor/phpstan/phpstan-symfony/rules.neon
    - cp-includes/vendor/phpstan/phpstan-doctrine/extension.neon
    - cp-includes/vendor/phpstan/phpstan-doctrine/rules.neon
    - cp-includes/vendor/phpstan/phpstan-phpunit/extension.neon
    - cp-includes/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    # Seviye 6: tip belirtimi eksikliklerini (iterable value type, eksik
    # @param/@return) yakalar ama henüz katı boolean/karşılaştırma kurallarını
    # (7-8, null güvenliği) dayatmaz. Baseline sayesinde bugünden itibaren
    # yazılan kod bu seviyede tutuluyor; hedef kademeli olarak 8'e çıkmak.
    level: 6

    paths:
        - cp-core/src
        - cp-core/tests
        - cp-content/modules

    # "Pristine Root" düzeni: vendor standart yerinde değil, PHPStan'in
    # otomatik keşfi bu yüzden çalışmaz ve yollar açıkça verilmelidir.
    tmpDir: cp-core/var/.phpstan

    excludePaths:
        analyseAndScan:
            - cp-core/var/*
            - cp-content/themes/*/vendor/*
            # Modül iskeleti şablonları geçerli PHP değil, yer tutucu içerir.
            - cp-core/src/Core/Module/Skeleton/*
            - cp-content/modules/*/Resources/skeleton/*

    # Symfony eklentisi servis tiplerini ve konteyner çağrılarını
    # anlayabilmek için derlenmiş konteyneri okur. CI'da "cache:warmup"
    # bu dosyayı analizden ÖNCE üretir (bkz. .github/workflows/ci.yml).
    symfony:
        containerXmlPath: cp-core/var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: cp-core/tests/console-application.php

    # Doctrine eklentisi repository dönüş tiplerini ve DQL'i doğrulayabilmek
    # için gerçek EntityManager'a ihtiyaç duyar.
    doctrine:
        objectManagerLoader: cp-core/tests/phpstan-object-manager.php

    # NOT: "cp-core, Modules\ import etmez" çekirdek kuralı burada DEĞİL,
    # CI'da ayrı bir adım olarak denetleniyor (.github/workflows/ci.yml →
    # "Çekirdek izolasyon kuralı"). PHPStan çekirdeğinde sınıf-adı yasaklama
    # kuralı yok; bunun için ek bir eklenti (spaze/phpstan-disallowed-calls)
    # kurmak gerekirdi ve tek bir grep'in yapacağı iş için yeni bağımlılık
    # eklemek manifestonun "gereksiz soyutlama yok" kuralına aykırı.

    # ignoreErrors bilinçli olarak BOŞ. Mevcut borcun tamamı
    # phpstan-baseline.neon içinde, dosya ve satır bazında, sayılabilir
    # hâlde duruyor. Geniş desenli bir "ignoreErrors" kuralı aynı hatayı
    # gelecekte de sessizce yutardı; baseline ise bakiyeyi görünür tutar ve
    # dosyaya dokunan bir sonraki geliştiriciyi temizlemeye zorlar.
