{% extends '@CpaliusWebsiteTheme/layout.html.twig' %}

{% block title %}CPalius CMF — Yeni Nesil İçerik Yönetim Framework'ü | PHP 8.2+ &amp; Symfony 7.4{% endblock %}
{% block meta_description %}CPalius CMF: PHP 8.2+ ve Symfony 7.4 LTS üzerine inşa edilmiş, kurumsal seviyede güvenli, modüler ve genişletilebilir içerik yönetim framework'ü. Açık kaynak, topluluk destekli.{% endblock %}

{% block content %}
{% for portalBlock in portalBlocks|default([]) %}
    {% include '@CpaliusWebsiteTheme/partials/portal/' ~ portalBlock.id ~ '.html.twig' ignore missing with {
        portalBlock: portalBlock,
        data: portalData[portalBlock.id]|default({})
    } only %}
{% endfor %}
{% endblock %}
