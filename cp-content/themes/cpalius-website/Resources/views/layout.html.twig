<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    {% block seo %}
        {% set seo_title %}{% block title %}CPalius CMF{% endblock %}{% endset %}
        {% set seo_description %}{% block meta_description %}{{ 'website.layout.meta_description'|trans }}{% endblock %}{% endset %}
        {% set seo_robots %}{% block meta_robots %}index, follow{% endblock %}{% endset %}
        {% set seo_keywords %}{% block meta_keywords %}{% endblock %}{% endset %}
        {{ cp_seo_head({
            title: seo_title,
            description: seo_description,
            robots: seo_robots,
        }) }}
        {% if seo_keywords|trim %}
            <meta name="keywords" content="{{ seo_keywords|trim|e('html_attr') }}">
        {% endif %}
    {% endblock %}

    <link rel="icon" type="image/png" href="{{ cp_appearance().favicon }}">

    {#
        Typefaces are served from this installation, not from a font CDN. A page
        that fetches its fonts from a third party reports every reader to that
        third party on every request, which is not a trade a site should make by
        default for a typeface it could simply ship.
    #}
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">

    <link rel="stylesheet" href="/themes/cpalius-website/dist/style.css">

    {#
        Generated by AACP → Appearance → Fonts. Linked after the theme so its
        :root block overrides the theme's default stacks; absent until an
        operator installs a font, in which case the theme defaults stand.
    #}
    {% set cpFonts = cp_font_stylesheet() %}
    {% if cpFonts %}<link rel="stylesheet" href="{{ cpFonts }}">{% endif %}

    {% if cp_appearance().og %}
        <meta property="og:image" content="{{ cp_appearance().og }}">
    {% endif %}
    <style{{ csp_nonce_attr() }}>{{ cp_appearance_css() }}</style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <a class="skip-link" href="#main">{{ 'website.skip_to_content'|trans }}</a>
    {% include '@Theme/partials/header.html.twig' %}

    <main id="main">
    {% block content %}{% endblock %}
    </main>

    {% include '@Theme/partials/footer.html.twig' %}

    <script type="application/json" id="cp-media-picker-i18n">{{ {
        title: 'media.picker.title'|trans,
        close: 'media.picker.close'|trans,
        loading: 'media.picker.loading'|trans,
        uploadFailed: 'media.picker.upload_failed'|trans,
        listFailed: 'media.picker.list_failed'|trans,
    }|json_encode|raw }}</script>
    <script{{ csp_nonce_attr() }} src="/themes/cpalius-website/dist/main.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
