{% extends '@Theme/forum/layout.html.twig' %}

{% block title %}{{ 'forum.access.title'|trans }} — {{ lockedSection.title }}{% endblock %}

{% block forum_breadcrumbs %}
    {% include '@Theme/forum/partials/_breadcrumbs.html.twig' with {
        breadcrumbs: breadcrumbs|default([]),
        forumHome: forumHome|default({title: 'forum.breadcrumb.home_title'|trans}),
    } %}
{% endblock %}

{% block forum_content %}
    <div class="forum-gate fade-in">
        <div class="forum-gate__icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
        <h1 class="forum-gate__title">{{ 'forum.access.title'|trans }}</h1>
        <p class="forum-gate__lead">{{ 'forum.access.lead'|trans({title: lockedSection.title}) }}</p>
        <form method="post" action="{{ path('forum_section_unlock', {sectionSlug: section.slug}) }}" class="forum-gate__form">
            <input type="hidden" name="_token" value="{{ csrf_token('forum_section_unlock') }}">
            <label class="forum-gate__label" for="forum-section-secret">{{ 'forum.access.secret'|trans }}</label>
            <input type="password" name="secret" id="forum-section-secret" class="form-control" required autocomplete="current-password">
            <button type="submit" class="btn btn-primary">{{ 'forum.access.submit'|trans }}</button>
        </form>
    </div>
{% endblock %}
