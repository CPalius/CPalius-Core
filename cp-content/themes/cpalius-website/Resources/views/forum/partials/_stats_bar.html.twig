{% set forumStats = forum_board_stats() %}
{% set online = forum_online_presence() %}
{% set newest = forum_newest_member() %}
<aside class="forum-stats fade-in" aria-label="{{ 'stats.bar.title'|trans({}, 'forums') }}">
    <div class="forum-stats__inner">
        <div class="forum-stats__left">
            <div class="forum-stats__online">
                <span class="forum-stats__count">
                    <span><i class="bi bi-broadcast"></i></span>
                    <span>
                        {{ 'stats.online.now'|trans({}, 'forums') }}<br>
                        {# One icon per kind instead of a single total: "84 online"
                           tells an operator nothing when most of it is crawlers. #}
                        <span class="forum-online-kinds">
                            <span class="forum-online-kind forum-online-kind--member" title="{{ 'stats.online.kind.member'|trans }}">
                                <i class="bi bi-person-fill" aria-hidden="true"></i>
                                <b>{{ online.memberCount|number_format(0, ',', '.') }}</b>
                                <span class="forum-online-kind__label">{{ 'stats.online.kind.member'|trans }}</span>
                            </span>
                            <span class="forum-online-kind forum-online-kind--guest" title="{{ 'stats.online.kind.guest'|trans }}">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                <b>{{ online.guestCount|number_format(0, ',', '.') }}</b>
                                <span class="forum-online-kind__label">{{ 'stats.online.kind.guest'|trans }}</span>
                            </span>
                            <span class="forum-online-kind forum-online-kind--spider" title="{{ 'stats.online.kind.spider'|trans }}">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <b>{{ online.spiderCount|default(0)|number_format(0, ',', '.') }}</b>
                                <span class="forum-online-kind__label">{{ 'stats.online.kind.spider'|trans }}</span>
                            </span>
                            <span class="forum-online-kind forum-online-kind--bot" title="{{ 'stats.online.kind.bot'|trans }}">
                                <i class="bi bi-robot" aria-hidden="true"></i>
                                <b>{{ online.botCount|default(0)|number_format(0, ',', '.') }}</b>
                                <span class="forum-online-kind__label">{{ 'stats.online.kind.bot'|trans }}</span>
                            </span>
                        </span>
                    </span>
                </span>
                <span class="forum-stats__link">
                    <a href="{{ forum_online_url() }}" title="{{ 'stats.online.members_link'|trans({}, 'forums') }}">
                        <i class="bi bi-list-check"></i>
                        <span>{{ 'stats.online.members_link'|trans({}, 'forums') }}</span>
                    </a>
                </span>
            </div>
            <div class="forum-stats__vb">
                <div class="forum-stats__threads">
                    <span><i class="bi bi-pen"></i></span>
                    <span>{{ 'stats.threads'|trans({}, 'forums') }}<br><b>{{ forumStats.topics|number_format(0, ',', '.') }}</b></span>
                </div>
                <div class="forum-stats__posts">
                    <span><i class="bi bi-chat-dots"></i></span>
                    <span>{{ 'stats.posts'|trans({}, 'forums') }}<br><b>{{ forumStats.posts|number_format(0, ',', '.') }}</b></span>
                </div>
                <div class="forum-stats__users">
                    <span><i class="bi bi-person"></i></span>
                    <span>{{ 'stats.users'|trans({}, 'forums') }}<br><b>{{ forumStats.users|number_format(0, ',', '.') }}</b></span>
                </div>
            </div>
        </div>
        <div class="forum-stats__right">
            <span><i class="bi bi-person-plus"></i></span>
            <span>
                {{ 'stats.newest'|trans({}, 'forums') }}<br>
                {% if newest %}
                    <a href="{{ path('forum_profile', {username: newest.slug}) }}">{{ newest.name }}</a>
                {% else %}
                    <b>{{ 'stats.newest.empty'|trans({}, 'forums') }}</b>
                {% endif %}
            </span>
        </div>
    </div>
</aside>
