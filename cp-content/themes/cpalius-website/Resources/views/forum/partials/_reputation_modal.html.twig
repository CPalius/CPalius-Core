<dialog class="forum-rep-modal" data-rep-modal>
    <form method="post" action="{{ path('forum_give_reputation', {username: targetUser.profileSlug}) }}" class="forum-rep-modal__form">
        <header class="forum-rep-modal__header">
            <h2>{{ 'forum.rep.modal_title'|trans({'name': targetUser.publicName}) }}</h2>
            <button type="button" class="forum-tool-btn" data-rep-close aria-label="{{ 'forum.action.cancel'|trans }}"><i class="bi bi-x-lg"></i></button>
        </header>

        <div class="forum-field">
            <label>{{ 'forum.rep.value'|trans }}</label>
            <div class="forum-rep-modal__values">
                <label><input type="radio" name="value" value="1" checked> +1</label>
                <label><input type="radio" name="value" value="-1"> −1</label>
            </div>
        </div>

        <div class="forum-field">
            <label for="forum-rep-reason">{{ 'forum.rep.reason_label'|trans }}</label>
            <select name="reason" id="forum-rep-reason" required>
                {% for reason in repReasons %}
                    <option value="{{ reason }}">{{ ('forum.rep.reason.' ~ reason)|trans }}</option>
                {% endfor %}
            </select>
        </div>

        {% if fixedTopicId %}
            <input type="hidden" name="topic_id" value="{{ fixedTopicId }}">
        {% else %}
            {# A free-text link, not a picker. The picker could only list topics
               the recipient had posted in, so there was routinely nothing to
               pick and the form could not be submitted at all. #}
            <div class="forum-field">
                <label for="forum-rep-topic-url">{{ 'forum.rep.topic_url_label'|trans }}</label>
                <input type="url" name="topic_url" id="forum-rep-topic-url" maxlength="500"
                       inputmode="url" placeholder="{{ 'forum.rep.topic_url_placeholder'|trans }}">
                <p class="forum-field-hint">{{ 'forum.rep.topic_url_hint'|trans }}</p>
            </div>
        {% endif %}

        {% if fixedPostId %}
            <input type="hidden" name="post_id" value="{{ fixedPostId }}">
        {% endif %}

        <div class="forum-field">
            <label for="forum-rep-comment">{{ 'forum.rep.comment_label'|trans }}</label>
            <textarea name="comment" id="forum-rep-comment" rows="3" maxlength="500" placeholder="{{ 'forum.rep.comment_placeholder'|trans }}"></textarea>
        </div>

        <div class="forum-form__actions">
            <input type="hidden" name="_token" value="{{ csrf_token('forum_give_reputation') }}">
            <button type="button" class="btn btn-sm btn-outline" data-rep-close>{{ 'forum.action.cancel'|trans }}</button>
            <button type="submit" class="btn btn-primary btn-sm">{{ 'forum.action.give_rep'|trans }}</button>
        </div>
    </form>
</dialog>
