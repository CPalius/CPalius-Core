{#
    CPalius Forum Engine konu durum ikonu
    (tasinmis > okunmadi > sabit+kilitli > sabit > kilitli > populer > ozel).

    Beklenen degiskenler: topic, hotThreshold (int), unread (bool, opsiyonel)
#}
{% set icon = 'bi-chat-square-text' %}
{% set extraClass = '' %}

{% if topic.movedToTopic %}
    {% set icon = 'bi-arrow-right-circle' %}
    {% set extraClass = 'is-moved' %}
{% elseif unread|default(false) %}
    {% set icon = 'bi-flag-fill' %}
    {% set extraClass = 'is-unread' %}
{% elseif topic.isLocked and topic.sticky %}
    {% set icon = 'bi-megaphone-fill' %}
    {% set extraClass = 'is-sticky' %}
{% elseif topic.sticky %}
    {% set icon = 'bi-pin-angle-fill' %}
    {% set extraClass = 'is-sticky' %}
{% elseif topic.isLocked %}
    {% set icon = 'bi-lock-fill' %}
    {% set extraClass = 'is-locked' %}
{% elseif topic.postCount >= hotThreshold %}
    {% set icon = 'bi-fire' %}
    {% set extraClass = 'is-hot' %}
{% elseif topic.isPrivate %}
    {% set icon = 'bi-eye-slash' %}
    {% set extraClass = 'is-private' %}
{% endif %}

<span class="forum-topic__icon {{ extraClass }}"><i class="bi {{ icon }}"></i></span>
