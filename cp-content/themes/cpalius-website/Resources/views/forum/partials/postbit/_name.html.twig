{# Postbit block: display name. Expects post. #}
<div class="forum-postbit__name">
    {% if post.author %}
        <a href="{{ path('forum_profile', {username: post.author.profileSlug}) }}"
           class="forum-mention" data-mention="{{ post.author.profileSlug }}">{{ post.posterName }}</a>
    {% else %}
        {{ post.posterName }}
    {% endif %}
</div>
