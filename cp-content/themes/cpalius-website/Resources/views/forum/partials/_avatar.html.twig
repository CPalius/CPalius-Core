{#
    CPalius Forum Engine — avatar (görsel veya baş harf).
    Beklenen: name (string), size (xs|sm|md|lg|xl), user (User|null), avatarUrl (string|null), online (bool)
#}
{% set resolvedUrl = avatarUrl|default(user is defined and user ? forum_user_avatar_url(user) : null) %}
{% set palette = ['#4A7C9B', '#4AADE4', '#C8A86E', '#8B9DAF', '#3A6A87', '#a371f7', '#e8590c'] %}
{% set initial = name|default('?')|trim|first|upper %}
{% set colorIndex = name is not empty ? (name|length * 7 + (name|trim|length)) % (palette|length) : 0 %}
{% set sizeKey = size|default('md') %}
{% if resolvedUrl %}
    <span class="forum-avatar forum-avatar--{{ sizeKey }}{{ square|default(false) ? ' forum-avatar--square' : '' }} forum-avatar--image">
        <img src="{{ resolvedUrl }}" alt="{{ name|default('') }}" loading="lazy" decoding="async">
        {% if online|default(false) %}
            <span class="forum-avatar__presence forum-avatar__presence--online" title="{{ 'presence.online'|trans({}, 'forums') }}"></span>
        {% endif %}
    </span>
{% else %}
    <span class="forum-avatar forum-avatar--{{ sizeKey }}{{ square|default(false) ? ' forum-avatar--square' : '' }}" style="background: {{ palette[colorIndex] }};" aria-hidden="true">
        {{ initial }}
        {% if online|default(false) %}
            <span class="forum-avatar__presence forum-avatar__presence--online" title="{{ 'presence.online'|trans({}, 'forums') }}"></span>
        {% endif %}
    </span>
{% endif %}
