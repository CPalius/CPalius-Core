{% extends '@Theme/layout.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="/themes/cpalius-website/dist/forum.css">
{% endblock %}

{% block content %}
<section class="section forum-page forum" id="forum" data-unfurl-endpoint="{{ path('forum_unfurl') }}" data-unfurl-token="{{ csrf_token('forum_unfurl') }}" data-i18n-report-prompt="{{ 'forum.js.report_prompt'|trans({}, 'forums') }}" data-i18n-link-copied="{{ 'forum.js.link_copied'|trans({}, 'forums') }}" data-i18n-close="{{ 'forum.js.close'|trans({}, 'forums') }}" data-i18n-prev="{{ 'forum.js.prev'|trans({}, 'forums') }}" data-i18n-next="{{ 'forum.js.next'|trans({}, 'forums') }}">
    <div class="container">
        {% block forum_breadcrumbs %}{% endblock %}

        {% for type, messages in cp_flashes() %}
            {% for message in messages %}
                <div class="forum-flash forum-flash--{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% block forum_content %}{% endblock %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
    <script src="/themes/cpalius-website/dist/forum.js" defer></script>
{% endblock %}
