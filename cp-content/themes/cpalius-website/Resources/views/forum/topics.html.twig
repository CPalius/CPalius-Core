{% extends '@Theme/forum/layout.html.twig' %}

{% block title %}{{ section.title }} — {{ 'forum.breadcrumb.home_title'|trans }} — {{ cp_app_name|default('CPalius CMF') }}{% endblock %}
{% block meta_description %}{{ section.description|default('forum.desc.default'|trans({'title': section.title})) }}{% endblock %}

{% block forum_breadcrumbs %}
    {% include '@Theme/forum/partials/_breadcrumbs.html.twig' with {
        breadcrumbs: breadcrumbs|default([]),
        forumHome: forumHome|default({title: 'forum.breadcrumb.home_title'|trans}),
    } %}
{% endblock %}

{% block forum_content %}
<div class="forum-header fade-in">
    <div class="forum-header__top">
        <div>
            <h1 class="section-title">{{ section.title }}</h1>
            {% if section.description %}<p class="forum-header__desc">{{ section.description }}</p>{% endif %}
        </div>
        <div class="forum-header__actions">
            <div class="forum-stats-inline">
                <span><strong>{{ section.topicCount }}</strong> {{ 'index.topics'|trans({}, 'forums') }}</span>
                <span><strong>{{ section.postCount }}</strong> {{ 'index.messages'|trans({}, 'forums') }}</span>
            </div>
        </div>
    </div>
</div>

{% include '@Theme/forum/partials/_announcements.html.twig' %}

{% if childSections is not empty %}
    <div class="forum-group fade-in">
        <div class="forum-group__title"><i class="bi bi-folder2"></i> {{ 'forum.subforums_title'|trans }}</div>
        <div class="forum-boards">
            {% for child in childSections %}
                {% include '@Theme/forum/partials/_board_row.html.twig' with {board: child} %}
            {% endfor %}
        </div>
    </div>
{% endif %}

{% set langParams = contentLangParams|default({}) %}

<div class="forum-toolbar fade-in">
    <nav class="forum-filters" aria-label="{{ 'filter.all'|trans({}, 'forums') }}">
        <a href="{{ path('forum_section', {sectionSlug: section.slug}|merge(langParams)) }}" class="forum-filters__item {{ (filter|default('all')) == 'all' ? 'is-active' : '' }}">{{ 'filter.all'|trans({}, 'forums') }}</a>
        <a href="{{ path('forum_section', {sectionSlug: section.slug, filter: 'solved'}|merge(langParams)) }}" class="forum-filters__item {{ filter|default('all') == 'solved' ? 'is-active' : '' }}">{{ 'filter.solved'|trans({}, 'forums') }}</a>
        <a href="{{ path('forum_section', {sectionSlug: section.slug, filter: 'latest'}|merge(langParams)) }}" class="forum-filters__item {{ filter|default('all') == 'latest' ? 'is-active' : '' }}">{{ 'filter.latest'|trans({}, 'forums') }}</a>
        <a href="{{ path('forum_section', {sectionSlug: section.slug, filter: 'popular'}|merge(langParams)) }}" class="forum-filters__item {{ filter|default('all') == 'popular' ? 'is-active' : '' }}">{{ 'filter.popular'|trans({}, 'forums') }}</a>
        {% if cp_user() %}
            <a href="{{ path('forum_section', {sectionSlug: section.slug, filter: 'mine'}|merge(langParams)) }}" class="forum-filters__item {{ filter|default('all') == 'mine' ? 'is-active' : '' }}">{{ 'filter.mine'|trans({}, 'forums') }}</a>
        {% endif %}
    </nav>
    {% if canCreateThread|default(false) %}
        <a href="{{ path('forum_new_topic', {sectionSlug: section.slug}) }}" class="btn btn-primary btn-sm forum-btn-compact forum-btn-neon"><i class="bi bi-plus-lg"></i> {{ 'action.new_thread'|trans({}, 'forums') }}</a>
    {% endif %}
</div>

{# A list that silently drops rows is indistinguishable from a quiet board, so
   say when the reader's own filter is the reason. #}
{% if wordFilterActive|default(false) %}
    <p class="forum-word-filter-note fade-in">
        <i class="bi bi-funnel"></i>
        {{ 'forum.word_filter.active_notice'|trans }}
        <a href="{{ path('account_profile') }}">{{ 'forum.word_filter.manage_link'|trans }}</a>
    </p>
{% endif %}

{% if otherLanguageCounts|default([]) is not empty %}
    {% for row in otherLanguageCounts %}
        <div class="forum-lang-banner fade-in">
            <span>{{ 'forum.content_lang.banner'|trans({count: row.count, locale: row.nativeName}) }}</span>
            <a href="{{ path('forum_section', {sectionSlug: section.slug, content_lang: row.code}) }}">{{ 'forum.content_lang.show'|trans }}</a>
        </div>
    {% endfor %}
{% endif %}
{% if contentLang|default(app.request.locale) != 'all' and otherLanguageCounts|default([]) is not empty %}
    <p class="forum-lang-all fade-in">
        <a href="{{ path('forum_section', {sectionSlug: section.slug, content_lang: 'all'}) }}">{{ 'forum.content_lang.all'|trans }}</a>
    </p>
{% endif %}

<div class="forum-topics-head fade-in {{ canInlineMod|default(false) ? 'is-imod' : '' }}" aria-hidden="true">
    {% if canInlineMod|default(false) %}
        <label class="forum-imod-check" title="{{ 'forum.imod.select_all'|trans }}">
            <input type="checkbox" data-imod-select-all>
        </label>
    {% endif %}
    <span></span>
    <span>{{ 'forum.breadcrumb.home_title'|trans }}</span>
    <span>{{ 'stat.reply'|trans({}, 'forums') }}</span>
    <span>{{ 'stat.view'|trans({}, 'forums') }}</span>
    <span>{{ 'index.last_post'|trans({}, 'forums') }}</span>
</div>

<div class="forum-topics fade-in {{ canInlineMod|default(false) ? 'is-imod' : '' }}">
    {% for topic in topics %}
        {% set isUnread = (unreadTopicIds is defined and topic.id in unreadTopicIds|keys) or (lastVisitAt is defined and lastVisitAt and topic.updatedAt > lastVisitAt and unreadTopicIds is not defined) %}
        <div class="forum-topic {{ topic.sticky ? 'forum-topic--sticky' : '' }} {{ topic.isLocked ? 'forum-topic--locked' : '' }} {{ isUnread ? 'forum-topic--unread' : '' }} {{ topic.deleted ? 'forum-topic--deleted' : '' }}" data-topic-id="{{ topic.id }}" data-topic-title="{{ topic.title|e('html_attr') }}">
            {% if canInlineMod|default(false) %}
                <label class="forum-imod-check">
                    <input type="checkbox" form="forum-imod-form" name="topic_ids[]" value="{{ topic.id }}">
                </label>
            {% endif %}
            {% include '@Theme/forum/partials/_topic_icon.html.twig' with {topic: topic, hotThreshold: hotThreshold, unread: isUnread} %}

            <div>
                <div class="forum-topic__title">
                    {% if topic.prefix %}
                        <span class="forum-prefix {{ topic.prefix.cssClass|default('forum-prefix--default') }}" {% if not topic.prefix.cssClass %}style="background: color-mix(in srgb, {{ topic.prefix.color }} 15%, white); color: {{ topic.prefix.color }};"{% endif %}>{{ topic.prefix.title }}</span>
                    {% endif %}
                    <a href="{{ path('forum_topic', {topicId: topic.id, slug: topic.slug}) }}"{% if not forum_guest_hide_content() %} title="{{ topic.preview }}"{% endif %}>{{ topic.title }}</a>
                    {% if topic.locale != app.request.locale or contentLang|default('') == 'all' %}
                        <span class="forum-lang-badge">{{ topic.locale }}</span>
                    {% endif %}
                    {% if topic.sticky and topic.isLocked %}<span class="forum-badge forum-badge--sticky">{{ 'forum.badge.announcement'|trans }}</span>
                    {% elseif topic.sticky %}<span class="forum-badge forum-badge--sticky">{{ 'forum.badge.sticky'|trans }}</span>{% endif %}
                    {% if topic.isLocked and not topic.sticky %}<span class="forum-badge forum-badge--locked">{{ 'forum.badge.locked'|trans }}</span>{% endif %}
                    {% if topic.postCount >= hotThreshold %}<span class="forum-badge forum-badge--hot">{{ 'forum.badge.hot'|trans }}</span>{% endif %}
                    {% if topic.isPrivate %}<span class="forum-badge forum-badge--private">{{ 'forum.badge.private'|trans }}</span>{% endif %}
                </div>
                <div class="forum-topic__meta">
                    <span class="forum-topic__starter">
                        {% include '@Theme/forum/partials/_avatar.html.twig' with {name: topic.firstPosterName, user: topic.firstPoster, size: 'xs'} %}
                        <span>{{ topic.firstPosterName|e('html') }}</span>
                    </span>
                    · {{ topic.createdAt|forum_relative_time }}
                    {% set lastPage = ((topic.postCount - 1) // postsPerPage) + 1 %}
                    {% if lastPage > 1 %}
                        <span class="forum-topic__pages">
                            {% for pageNum in 1..min(lastPage, 5) %}
                                <a href="{{ path('forum_topic', {topicId: topic.id, slug: topic.slug, page: pageNum}) }}">{{ pageNum }}</a>
                            {% endfor %}
                            {% if lastPage > 5 %}<a href="{{ path('forum_topic', {topicId: topic.id, slug: topic.slug, page: lastPage}) }}">…{{ lastPage }}</a>{% endif %}
                        </span>
                    {% endif %}
                </div>
            </div>

            <div class="forum-topic__stat">
                <strong>{{ topic.replyCount|forum_number }}</strong>
                <span>{{ 'stat.reply'|trans({}, 'forums') }}</span>
            </div>
            <div class="forum-topic__stat">
                <strong>{{ topic.viewCount|forum_number }}</strong>
                <span>{{ 'stat.view'|trans({}, 'forums') }}</span>
            </div>

            <div class="forum-topic__activity">
                {% if topic.lastPosterName %}
                    {% include '@Theme/forum/partials/_avatar.html.twig' with {name: topic.lastPosterName, user: topic.lastPoster} %}
                    {% set lastPage = ((topic.postCount - 1) // postsPerPage) + 1 %}
                    <div class="forum-topic__activity-text">
                        <a href="{{ path('forum_topic', {topicId: topic.id, slug: topic.slug, page: lastPage}) }}">{{ topic.lastPosterName }}</a>
                        <time>{{ (topic.lastPostDate ?? topic.updatedAt)|forum_relative_time }}</time>
                    </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="forum-empty">
            <i class="bi bi-chat-square-dots"></i>
            {{ 'empty.no_threads'|trans({}, 'forums') }}
        </div>
    {% endfor %}
</div>

{% include '@Theme/forum/partials/pagination.html.twig' with {
    result: topics,
    route: 'forum_section',
    routeParams: {sectionSlug: section.slug, filter: filter|default('all')}|merge(langParams)
} %}

{% include '@Theme/forum/partials/_inline_mod.html.twig' with { imodScope: 'topics' } %}
{% include '@Theme/forum/partials/_user_rail.html.twig' %}
{% include '@Theme/forum/partials/_stats_bar.html.twig' %}
{% endblock %}
