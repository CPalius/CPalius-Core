{% extends '@Theme/forum/layout.html.twig' %}

{% block title %}{{ 'forum.draft.list'|trans }} — {{ 'forum.breadcrumb.home_title'|trans }}{% endblock %}

{% block forum_breadcrumbs %}
    <nav class="forum-crumb fade-in" aria-label="{{ 'forum.nav_aria'|trans }}">
        <ol class="forum-crumb__list">
            <li><a href="{{ path('theme_cpalius_website_home') }}"><i class="bi bi-house-door"></i></a></li>
            <li><a href="{{ path('forum_index') }}">{{ 'forum.breadcrumb.home_title'|trans }}</a></li>
            <li class="is-active">{{ 'forum.draft.list'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block forum_content %}
{% include '@Theme/forum/partials/_user_rail.html.twig' %}
<div class="forum-header fade-in">
    <h1 class="section-title">{{ 'forum.draft.list'|trans }}</h1>
</div>
<div class="forum-topics fade-in">
    {% for draft in drafts %}
        <div class="forum-topic forum-topic--simple">
            <div class="forum-topic__main">
                <div class="forum-topic__title">
                    {% if draft.topic %}
                        <a href="{{ path('forum_topic', {topicId: draft.topic.id, slug: draft.topic.slug}) }}#reply">{{ draft.topic.title }}</a>
                    {% elseif draft.section %}
                        <a href="{{ path('forum_new_topic', {sectionSlug: draft.section.slug}) }}">{{ draft.title|default('forum.draft.new_topic'|trans) }}</a>
                    {% endif %}
                </div>
                <div class="forum-topic__meta">{{ draft.body|striptags|slice(0, 140) }} · {{ draft.updatedAt|forum_relative_time }}</div>
            </div>
        </div>
    {% else %}
        <div class="forum-empty">{{ 'forum.draft.empty'|trans }}</div>
    {% endfor %}
</div>
{% endblock %}
