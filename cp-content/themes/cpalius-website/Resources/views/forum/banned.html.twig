{% extends '@Theme/forum/layout.html.twig' %}

{% block title %}{{ 'forum.banned.title'|trans }}{% endblock %}

{% block forum_content %}
    <div class="forum-banned fade-in">
        <div class="forum-banned__icon" aria-hidden="true"><i class="bi bi-slash-circle"></i></div>
        <h1 class="forum-banned__title">{{ 'forum.banned.title'|trans }}</h1>
        <p class="forum-banned__lead">
            {% if source|default('ban') == 'filter' %}
                {{ 'forum.banned.filter_lead'|trans }}
            {% else %}
                {{ 'forum.banned.lead'|trans }}
            {% endif %}
        </p>
        {% if reason %}
            <p class="forum-banned__reason">{{ 'forum.banned.reason'|trans({reason: reason}) }}</p>
        {% endif %}
        {% if expiresAt %}
            <p class="forum-banned__expires">{{ 'forum.banned.expires'|trans({date: expiresAt|date('d.m.Y H:i')}) }}</p>
        {% else %}
            <p class="forum-banned__expires">{{ 'forum.banned.permanent'|trans }}</p>
        {% endif %}
    </div>
{% endblock %}
