{% extends '@Theme/layout.html.twig' %}

{% block title %}{{ term ? 'blog.search.title_query'|trans({'term': term}) : 'blog.search.title_default'|trans }} — {{ 'blog.label.blog'|trans }} — {{ cp_app_name|default('CPalius CMF') }}{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}

{% block content %}
{% include '@Theme/blog/partials/hero.html.twig' %}

<section class="section blog-archive-section" id="blog-search">
    <div class="container">
        {% if not (blogHero is defined and blogHero.enabled) %}
            <div class="section-header fade-in">
                <span class="section-label">{{ 'blog.label.blog'|trans }}</span>
                <h2 class="section-title">{{ heading|default(term ? 'blog.search.title_query'|trans({'term': term}) : 'blog.search.title_default'|trans) }}</h2>
            </div>
        {% else %}
            <div class="blog-feed-toolbar fade-in">
                <h2 class="blog-feed-toolbar__title" id="blog-feed">{{ heading|default('blog.search.title_default'|trans) }}</h2>
            </div>
        {% endif %}

        <div class="grid-golden grid-golden--blog">
            <div class="grid-golden-major">
                {% if term == '' %}
                    <p class="section-desc">{{ 'blog.search.empty_prompt'|trans }}</p>
                {% elseif posts is null or posts.isEmpty %}
                    <p class="section-desc">{{ 'blog.search.no_results'|trans({'term': term}) }}</p>
                {% else %}
                    {% include '@Theme/blog/partials/posts_feed.html.twig' with {
                        posts: posts,
                        listLayout: listLayout|default('grid'),
                    } %}

                    {% include '@Theme/blog/partials/pagination.html.twig' with {
                        result: posts,
                        route: 'blog_search',
                        routeParams: {q: term},
                    } %}
                {% endif %}
            </div>

            <aside class="grid-golden-minor" id="blog-sidebar">
                {% include '@Theme/blog/partials/search_widget.html.twig' %}
                {% include '@Theme/blog/partials/widget_sidebar.html.twig' %}
                {% include '@Theme/blog/partials/archive_sidebar.html.twig' %}
            </aside>
        </div>
    </div>
</section>
{% endblock %}
