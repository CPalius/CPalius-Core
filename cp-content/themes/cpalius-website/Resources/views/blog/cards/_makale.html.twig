{#
    Editorial article card — cover on top, serif title feel. Expects: post (Node, type=post).
#}
<article class="slw-feed-card blog-card--makale slw-ctype--makale fade-in">
    {% include '@Theme/blog/partials/_feed_card_cover.html.twig' with { post: post } %}

    <div class="slw-feed-card__body">
        <div class="slw-feed-card__head">
            <span class="slw-type-badge slw-ctype--makale"><span class="slw-type-badge__dot"></span> {{ 'blog.card.type.article'|trans }}</span>
            <time class="slw-detail-meta__item">
                {{ post.publishedAt ? post.publishedAt|date('d.m.Y') : '' }}
            </time>
        </div>
        <h4 class="slw-feed-card__title blog-card__title--editorial">
            <a href="{{ path('blog_show', {_locale: post.locale, slug: post.slug}) }}">{{ post.title }}</a>
        </h4>
        {% include '@Theme/blog/partials/_feed_card_excerpt.html.twig' with { post: post } %}
    </div>
</article>
