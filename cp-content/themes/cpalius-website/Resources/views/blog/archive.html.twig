{% extends '@Theme/layout.html.twig' %}

{% block title %}{{ heading }} — {{ 'blog.label.blog'|trans }} — {{ cp_app_name|default('CPalius CMF') }}{% endblock %}

{% block content %}
{% include '@Theme/blog/partials/hero.html.twig' %}
{% include '@Theme/blog/partials/categories_strip.html.twig' %}
{% include '@Theme/blog/partials/featured_strip.html.twig' %}

<section class="section blog-archive-section" id="blog-archive">
    <div class="container">
        <ul class="slw-breadcrumb fade-in">
            <li><a href="{{ path('blog_index') }}">~</a></li>
            <li>{{ category ? category.slug : 'blog' }}</li>
        </ul>

        {% if not (blogHero is defined and blogHero.enabled) %}
            <div class="section-header fade-in">
                <span class="section-label">{{ category ? 'blog.label.category'|trans : 'blog.label.blog'|trans }}</span>
                <h2 class="section-title">{{ heading }}</h2>
            </div>
        {% else %}
            <div class="blog-feed-toolbar fade-in">
                <h2 class="blog-feed-toolbar__title" id="blog-feed">{{ heading }}</h2>
                <span class="blog-feed-toolbar__layout">{{ posts.totalItems }} {{ 'blog.hero.stat_posts'|trans }}</span>
            </div>
        {% endif %}

        <div class="grid-golden grid-golden--blog">
            <div class="grid-golden-major">
                {% if posts.isEmpty %}
                    <p class="section-desc">{{ 'blog.archive.empty'|trans }}</p>
                {% else %}
                    {% include '@Theme/blog/partials/posts_feed.html.twig' with {
                        posts: posts,
                        listLayout: listLayout|default('grid'),
                    } %}

                    {% include '@Theme/blog/partials/pagination.html.twig' with {
                        result: posts,
                        route: paginationRoute is defined ? paginationRoute : (category ? 'blog_category' : 'blog_index'),
                        routeParams: paginationRouteParams is defined ? paginationRouteParams : (category ? {slug: category.slug} : {}),
                    } %}
                {% endif %}
            </div>

            <aside class="grid-golden-minor" id="blog-sidebar">
                {% include '@Theme/blog/partials/search_widget.html.twig' %}
                {% include '@Theme/blog/partials/widget_sidebar.html.twig' %}
                {% include '@Theme/blog/partials/archive_sidebar.html.twig' %}
            </aside>
        </div>
    </div>
</section>
{% endblock %}
