{% extends '@Theme/layout.html.twig' %}

{% block title %}{{ heading }} — {{ 'blog.label.blog'|trans }} — {{ cp_app_name|default('CPalius CMF') }}{% endblock %}

{% block meta_robots %}noindex, follow{% endblock %}

{% block content %}
<section class="section" id="blog-unavailable">
    <div class="container container-narrow">
        <ul class="slw-breadcrumb fade-in">
            <li><a href="{{ path('blog_index') }}">~/blog</a></li>
            <li>{{ 'blog.front.unavailable.breadcrumb'|trans }}</li>
        </ul>

        <div class="section-header fade-in">
            <span class="section-label">{{ 'blog.label.blog'|trans }}</span>
            <h1 class="section-title">{{ heading }}</h1>
            {% if sourcePost %}
                <p class="section-lead">
                    {{ 'blog.front.unavailable.translation_body'|trans({
                        title: sourcePost.title,
                        locale: sourcePost.locale|upper
                    }) }}
                </p>
            {% else %}
                <p class="section-lead">
                    {{ 'blog.front.unavailable.not_found_body'|trans({slug: requestedSlug}) }}
                </p>
            {% endif %}
        </div>

        <div class="fade-in" style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.5rem;">
            {% if sourcePost %}
                <a class="btn btn-primary" href="{{ path('blog_show', {_locale: sourcePost.locale, slug: sourcePost.slug}) }}">
                    {{ 'blog.front.unavailable.open_original'|trans({locale: sourcePost.locale|upper}) }}
                </a>
            {% endif %}
            <a class="btn btn-secondary" href="{{ path('blog_index') }}">
                {{ 'blog.front.unavailable.back_to_blog'|trans }}
            </a>
            <a class="btn btn-secondary" href="{{ path('theme_cpalius_website_home') }}">
                {{ 'blog.front.unavailable.back_home'|trans }}
            </a>
        </div>
    </div>
</section>
{% endblock %}
