{#
    {% include '@Theme/blog/partials/pagination.html.twig' with {
        result: posts, route: 'blog_index', routeParams: {}
    } %}

    App\Core\Pagination\PaginatedResult için cpalius-website temasının
    (Flat Design / Golden Ratio) sayfalama şeridi. Studio'nun
    twig:studio:pagination bileşeninden BİLİNÇLİ OLARAK ayrıdır: burada
    Tailwind utility class'ları değil, temanın kendi .btn/--cp-* tasarım
    token'ları kullanılır (bkz. dist/style.css).

    Beklenen değişkenler:
      result      (App\Core\Pagination\PaginatedResult)
      route       (string)  path() için route adı
      routeParams (array)   route'un {page} ve {_locale} dışındaki diğer parametreleri
#}
{% set routeParams = routeParams|default({}) %}

{% if result.totalPages > 1 %}
    <nav class="blog-pagination" aria-label="{{ 'blog.pagination.aria_label'|trans }}">
        {% if result.hasPreviousPage %}
            <a href="{{ path(route, routeParams|merge({_locale: app.request.locale, page: result.currentPage - 1})) }}" class="btn btn-outline blog-pagination-prev">
                ‹ {{ 'blog.pagination.previous'|trans }}
            </a>
        {% endif %}

        <span class="blog-pagination-info" style="font-family: var(--slw-font-mono);">
            {{ result.currentPage }} / {{ result.totalPages }}
        </span>

        {% if result.hasNextPage %}
            <a href="{{ path(route, routeParams|merge({_locale: app.request.locale, page: result.currentPage + 1})) }}" class="btn btn-outline blog-pagination-next">
                {{ 'blog.pagination.next'|trans }} ›
            </a>
        {% endif %}
    </nav>
{% endif %}
