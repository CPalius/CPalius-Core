{#
    Blog yazı listesi — blog.list_layout ayarına göre grid veya liste.
    Beklenen: posts (Paginator sonucu), listLayout ('grid'|'list')
#}
{% set layout = listLayout|default('grid') %}

{% if layout == 'list' %}
    <div class="blog-post-list">
        {% for post in posts %}
            {% include '@CpaliusWebsiteTheme/blog/cards/_list_item.html.twig' with { post: post } %}
        {% endfor %}
    </div>
{% else %}
    <div class="features-grid blog-post-grid">
        {% for post in posts %}
            {% set subType = post.getDataValue('post_sub_type', 'makale') %}
            {% include [
                '@CpaliusWebsiteTheme/blog/cards/_' ~ subType ~ '.html.twig',
                '@CpaliusWebsiteTheme/blog/cards/_makale.html.twig',
            ] with { post: post } %}
        {% endfor %}
    </div>
{% endif %}
