{#
    Post list — grid or list per blog.list_layout. Expects: posts, listLayout ('grid'|'list').
#}
{% set layout = listLayout|default('grid') %}

{% if layout == 'list' %}
    <div class="blog-post-list">
        {% for post in posts %}
            {% include '@Theme/blog/cards/_list_item.html.twig' with { post: post } %}
        {% endfor %}
    </div>
{% else %}
    <div class="features-grid blog-post-grid">
        {% for post in posts %}
            {% set subType = post.getDataValue('post_sub_type', 'makale') %}
            {% include [
                '@Theme/blog/cards/_' ~ subType ~ '.html.twig',
                '@Theme/blog/cards/_makale.html.twig',
            ] with { post: post } %}
        {% endfor %}
    </div>
{% endif %}
