{#
    Sidebar author card — public display name and avatar (same as forum); email never shown; bio is sanitised HTML.
#}
{% set displayName = blog_public_display_name(author)|default('blog.author.anonymous'|trans) %}
{% set profileUrl = blog_author_profile_url(author) %}
{% set avatarUrl = blog_user_avatar_url(author) %}
{% set initial = displayName|trim|first|upper %}
<div class="blog-sidebar-widget slw-sidebar-profile">
    <h2 class="blog-sidebar-widget__title">{{ 'blog.sidebar.author_whoami'|trans }}</h2>
    <div class="slw-sidebar-profile__avatar">
        {% if avatarUrl %}
            <img src="{{ avatarUrl|lower ends with '.gif' ? avatarUrl : avatarUrl|cp_thumb(192, 192) }}" alt="{{ displayName }}" loading="lazy" decoding="async" width="96" height="96">
        {% else %}
            <span aria-hidden="true">{{ initial }}</span>
        {% endif %}
    </div>
    {% if profileUrl %}
        <a href="{{ profileUrl }}" class="slw-sidebar-profile__name">{{ displayName }}</a>
    {% else %}
        <strong class="slw-sidebar-profile__name">{{ displayName }}</strong>
    {% endif %}
    {% if author.bio %}
        <div class="slw-sidebar-profile__bio">{{ author.bio|sanitize_html('cpalius_richtext') }}</div>
    {% endif %}
</div>
