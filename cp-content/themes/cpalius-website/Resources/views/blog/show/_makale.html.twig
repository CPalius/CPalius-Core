{#
    Makale show — altın oran editöryel iskelet.
    Beklenen: post, postBody, typeFields, relatedPosts.
#}
<section class="section post-show post-show--makale" id="post-detail">
    <div class="container">
        <div class="grid-golden grid-golden--blog">
            <div class="grid-golden-major">
                <div class="slw-detail-panel slw-detail-panel--makale slw-ctype--makale">
                    <div class="post-body post-body--editorial">
                        {{ postBody|raw }}
                    </div>

                    {% if post.tags is not empty %}
                        <div class="post-tags">
                            {% for tag in post.tags %}
                                <a href="{{ path('blog_tag', {_locale: post.locale, slug: tag.slug}) }}" class="slw-tag-pill">#{{ tag.name }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <aside class="grid-golden-minor">
                {% if post.author %}
                    {% include '@Theme/blog/partials/author_card.html.twig' with { author: post.author } %}
                {% endif %}

                {% include '@Theme/blog/partials/search_widget.html.twig' %}
                {% include '@Theme/blog/partials/widget_sidebar.html.twig' %}
                {% include '@Theme/blog/partials/archive_sidebar.html.twig' %}

                {% if relatedPosts is not empty %}
                    <div class="blog-sidebar-widget">
                        <h5>{{ 'blog.show.related_title'|trans }}</h5>
                        <ul class="slw-related-list">
                            {% for relatedPost in relatedPosts %}
                                <li class="slw-related-list__item">
                                    <a href="{{ path('blog_show', {_locale: relatedPost.locale, slug: relatedPost.slug}) }}">
                                        <span class="slw-related-thumb"><i class="bi bi-journal-code"></i></span>
                                        <span>
                                            <span class="slw-related-list__title">{{ relatedPost.title }}</span>
                                            {% if relatedPost.publishedAt %}
                                                <time datetime="{{ relatedPost.publishedAt|date('c') }}">{{ relatedPost.publishedAt|date('d.m.Y') }}</time>
                                            {% endif %}
                                        </span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </aside>
        </div>
    </div>
</section>
