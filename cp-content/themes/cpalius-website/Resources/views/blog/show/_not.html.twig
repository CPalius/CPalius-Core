{#
    Note show — narrow container, prose body, terminal for code_snippet. SECURITY: code_snippet is never |raw (auto-escape).
#}
<section class="section post-show post-show--not" id="post-detail">
    <div class="container container-narrow">
        {% if postBody %}
            <div class="post-body post-body--note fade-in">{{ postBody|raw }}</div>
        {% endif %}

        {% if typeFields.code_snippet is defined and typeFields.code_snippet %}
            <div class="slw-term-window slw-term-window--note fade-in">
                <div class="slw-term-window__bar">
                    <span class="slw-term-window__dots"><i></i><i></i><i></i></span>
                    <span class="slw-term-window__title">~ {{ post.slug }}.note</span>
                </div>
                <div class="slw-term-window__body">
                    <pre class="slw-term-window__code"><code>{{ typeFields.code_snippet }}</code></pre>
                </div>
            </div>
        {% endif %}

        {% if post.tags is not empty %}
            <div class="post-tags mt-sp-md">
                {% for tag in post.tags %}
                    <a href="{{ path('blog_tag', {_locale: post.locale, slug: tag.slug}) }}" class="slw-tag-pill">#{{ tag.name }}</a>
                {% endfor %}
            </div>
        {% endif %}

        {% include '@Theme/blog/partials/comments.html.twig' with {
            post: post,
            commentContext: commentContext|default({enabled: false, canSubmit: false, threads: [], approvedCount: 0}),
        } %}
    </div>
</section>
