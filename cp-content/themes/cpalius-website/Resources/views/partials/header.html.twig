<nav class="navbar" id="navbar">
    <div class="container navbar-inner">
        <a href="{{ path('theme_cpalius_website_home') }}" class="navbar-brand">
            <img src="/CPalius.png" alt="CPalius CMF" class="navbar-logo">
        </a>

        <button class="navbar-toggle" id="navToggle" aria-label="{{ 'website.nav.toggle_aria'|trans }}" aria-expanded="false" aria-controls="navCollapse">
            <i class="bi bi-list"></i>
        </button>

        <div class="navbar-collapse" id="navCollapse">
            {# Dynamic items from the Menu module #}
            <ul class="navbar-menu" id="navMenu">
                {% for item in cp_menu('header', app.request.locale) %}
                    <li class="{{ item.children is not empty ? 'navbar-menu__item--dropdown' : '' }}">
                        <a href="{{ item.url }}" {{ item.openInNewTab ? 'target="_blank" rel="noopener"' : '' }}>{{ item.label }}</a>
                        {% if item.children is not empty %}
                            <ul class="navbar-submenu">
                                {% for child in item.children %}
                                    <li><a href="{{ child.url }}" {{ child.openInNewTab ? 'target="_blank" rel="noopener"' : '' }}>{{ child.label }}</a></li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </li>
                {% else %}
                    <li><a href="{{ path('theme_cpalius_website_home') }}#about">{{ 'nav.about'|trans({}, 'portal') }}</a></li>
                    <li><a href="{{ path('theme_cpalius_website_home') }}#features">{{ 'nav.features'|trans({}, 'portal') }}</a></li>
                    <li><a href="{{ path('whitepaper_show', {_locale: app.request.locale}) }}">{{ 'nav.whitepaper'|trans({}, 'portal') }}</a></li>
                    <li><a href="{{ path('roadmap_index') }}">{{ 'nav.roadmap'|trans({}, 'portal') }}</a></li>
                {% endfor %}
            </ul>

            {# Fixed items: locale, search, auth or user menu #}
            <div class="navbar-actions">
                {{ cp_locale_switcher('dropdown') }}
                <div class="navbar-search" id="navSearch">
                    <button type="button" class="navbar-search__toggle" id="navSearchToggle" aria-label="{{ 'website.nav.search_toggle_aria'|trans }}" aria-expanded="false" aria-controls="navSearchForm">
                        <i class="bi bi-search"></i>
                    </button>
                    <form class="navbar-search__form" id="navSearchForm" action="{{ path('site_search', {_locale: app.request.locale}) }}" method="get" role="search">
                        <input type="search" name="q" class="navbar-search__input" value="{{ app.request.query.get('q', '') }}" placeholder="{{ 'website.nav.search_placeholder'|trans }}" aria-label="{{ 'website.nav.search_aria'|trans }}">
                    </form>
                </div>

                {% set currentUser = cp_user() %}
                {% if currentUser %}
                    {% set navUnread = cp_notification_unread_count() %}
                    {% set navNotifs = cp_recent_notifications(6) %}
                    {% set navAvatarUrl = cp_current_user_avatar_url() %}
                    <div class="navbar-inbox" id="navInbox">
                        <div class="navbar-alert" data-inbox-channel="notifications">
                            <button type="button" class="navbar-alert__btn" id="navNotifToggle" aria-expanded="false" aria-controls="navNotifBox" aria-label="{{ 'website.nav.notifications'|trans }}">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                <span class="navbar-alert__badge navbar-alert__badge--blue" data-inbox-badge {% if navUnread == 0 %}hidden{% endif %}>{{ navUnread }}</span>
                            </button>
                            <div class="navbar-alert__panel" id="navNotifBox" role="dialog" aria-label="{{ 'website.nav.notifications'|trans }}" hidden>
                                <div class="navbar-notif-box__head">
                                    <strong>{{ 'website.nav.notifications'|trans }}</strong>
                                    <span data-inbox-unread-label>{% if navUnread > 0 %}{{ 'notification.inbox.desc'|trans({count: navUnread}) }}{% endif %}</span>
                                </div>
                                <div class="navbar-notif-box__list" data-inbox-list>
                                    {% for n in navNotifs %}
                                        <a href="{{ n.url }}" class="navbar-notif-box__item {{ n.unread ? 'is-unread' : '' }}" data-inbox-id="{{ n.id }}">
                                            <span class="navbar-notif-box__icon"><i class="bi bi-{{ n.icon }}"></i></span>
                                            <span class="navbar-notif-box__text">
                                                {{ n.text }}
                                                <time datetime="{{ n.created_at }}">{{ n.created_label }}</time>
                                            </span>
                                        </a>
                                    {% else %}
                                        <p class="navbar-notif-box__empty">{{ 'notification.inbox.empty'|trans }}</p>
                                    {% endfor %}
                                </div>
                                <div class="navbar-notif-box__foot">
                                    {% if navUnread > 0 %}
                                        <form method="post" action="{{ path('account_notifications_mark_all') }}" data-inbox-mark-all>
                                            <input type="hidden" name="_token" value="{{ csrf_token('account_notifications') }}">
                                            <button type="submit">{{ 'notification.inbox.mark_all'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    <a href="{{ path('account_notifications') }}">{{ 'forum.notifications.view_all'|trans }}</a>
                                </div>
                            </div>
                        </div>
                        {{ cp_hook('theme.header.alerts', { user: currentUser }) }}
                        <div class="navbar-user" id="navUser">
                            <button type="button" class="navbar-user__trigger" id="navUserTrigger" aria-expanded="false" aria-controls="navUserDropdown">
                                {% if navAvatarUrl %}
                                    <img src="{{ navAvatarUrl }}" alt="" class="navbar-avatar navbar-avatar--image" loading="lazy">
                                {% else %}
                                    <span class="navbar-avatar">{{ currentUser.fullName|default('?')|trim|first|upper }}</span>
                                {% endif %}
                                <span class="navbar-user__name">{{ currentUser.fullName }}</span>
                                <i class="bi bi-chevron-down navbar-user__caret"></i>
                            </button>
                            <div class="navbar-user__dropdown" id="navUserDropdown">
                                <a href="{{ path('forum_profile', {username: currentUser.profileSlug}) }}" class="navbar-user__link">
                                    <i class="bi bi-person-circle"></i> {{ 'website.nav.profile'|trans }}
                                </a>
                                {{ cp_hook('theme.header.user_menu', { user: currentUser }) }}
                                <a href="{{ path('account_profile') }}" class="navbar-user__link">
                                    <i class="bi bi-gear"></i> {{ 'website.nav.account_settings'|trans }}
                                </a>
                                {% if cp_is_granted('system.aacp.access') %}
                                    <a href="{{ path('admin_forum_dashboard') }}" target="_blank" rel="noopener" class="navbar-user__link">
                                        <i class="bi bi-grid-1x2"></i> {{ 'website.nav.studio'|trans }}
                                    </a>
                                    <a href="{{ path('aacp_dashboard') }}" target="_blank" rel="noopener" class="navbar-user__link">
                                        <i class="bi bi-shield-lock"></i> {{ 'website.nav.aacp'|trans }}
                                    </a>
                                {% endif %}
                                <div class="navbar-user__divider"></div>
                                <a href="{{ path('admin_logout') }}" class="navbar-user__link navbar-user__link--danger">
                                    <i class="bi bi-box-arrow-right"></i> {{ 'website.nav.logout'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                    <script type="application/json" id="cp-inbox-pulse">{{ {
                        url: path('account_inbox_pulse'),
                        interval: 8000,
                    }|json_encode|raw }}</script>
                {% else %}
                    <div class="navbar-auth">
                        <a href="{{ path('account_login') }}" class="navbar-btn navbar-btn--ghost">{{ 'website.nav.login'|trans }}</a>
                        <a href="{{ path('account_register') }}" class="navbar-btn navbar-btn--solid">{{ 'website.nav.register'|trans }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
