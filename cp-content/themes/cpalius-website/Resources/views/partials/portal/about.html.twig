{% set t = 'portal' %}
<section class="section" id="about">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'about.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'about.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'about.desc'|trans({}, t) }}</p>
        </div>

        <div class="about-grid">
            <div class="about-problem fade-in-left">
                <div class="problem-card">
                    <h4><i class="bi bi-exclamation-triangle"></i> <span>{{ 'about.problems_title'|trans({}, t) }}</span></h4>

                    <div class="problem-item">
                        <i class="bi bi-x-circle"></i>
                        <div>
                            <strong>{{ 'about.problem_cms_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.problem_cms_text'|trans({}, t) }}</p>
                        </div>
                    </div>

                    <div class="problem-item">
                        <i class="bi bi-x-circle"></i>
                        <div>
                            <strong>{{ 'about.problem_fw_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.problem_fw_text'|trans({}, t) }}</p>
                        </div>
                    </div>

                    <div class="problem-item">
                        <i class="bi bi-x-circle"></i>
                        <div>
                            <strong>{{ 'about.problem_mvc_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.problem_mvc_text'|trans({}, t) }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="about-solution fade-in-right">
                <div class="solution-card">
                    <h4><i class="bi bi-check-circle"></i> <span>{{ 'about.solution_title'|trans({}, t) }}</span></h4>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ 'about.sol_infra_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.sol_infra_text'|trans({}, t) }}</p>
                        </div>
                    </div>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ 'about.sol_components_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.sol_components_text'|trans({}, t) }}</p>
                        </div>
                    </div>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ 'about.sol_modular_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.sol_modular_text'|trans({}, t) }}</p>
                        </div>
                    </div>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ 'about.sol_core_title'|trans({}, t) }}</strong>
                            <p>{{ 'about.sol_core_text'|trans({}, t) }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
