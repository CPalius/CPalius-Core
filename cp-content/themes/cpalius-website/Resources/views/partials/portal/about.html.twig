{% set t = 'portal' %}
<section class="section" id="about">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('about.label') }}</span>
            <h2 class="section-title">{{ hp('about.title') }}</h2>
            <p class="section-desc">{{ hp('about.desc') }}</p>
        </div>

        <div class="about-grid">
            <div class="about-problem fade-in-left">
                <div class="problem-card">
                    <h4><i class="bi bi-exclamation-triangle"></i> <span>{{ hp('about.problems_title') }}</span></h4>

                    <div class="problem-item">
                        <i class="bi bi-x-circle"></i>
                        <div>
                            <strong>{{ hp('about.problem_cms_title') }}</strong>
                            <p>{{ hp('about.problem_cms_text') }}</p>
                        </div>
                    </div>

                    <div class="problem-item">
                        <i class="bi bi-x-circle"></i>
                        <div>
                            <strong>{{ hp('about.problem_fw_title') }}</strong>
                            <p>{{ hp('about.problem_fw_text') }}</p>
                        </div>
                    </div>

                    <div class="problem-item">
                        <i class="bi bi-x-circle"></i>
                        <div>
                            <strong>{{ hp('about.problem_mvc_title') }}</strong>
                            <p>{{ hp('about.problem_mvc_text') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="about-solution fade-in-right">
                <div class="solution-card">
                    <h4><i class="bi bi-check-circle"></i> <span>{{ hp('about.solution_title') }}</span></h4>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ hp('about.sol_infra_title') }}</strong>
                            <p>{{ hp('about.sol_infra_text') }}</p>
                        </div>
                    </div>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ hp('about.sol_components_title') }}</strong>
                            <p>{{ hp('about.sol_components_text') }}</p>
                        </div>
                    </div>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ hp('about.sol_modular_title') }}</strong>
                            <p>{{ hp('about.sol_modular_text') }}</p>
                        </div>
                    </div>

                    <div class="solution-item">
                        <i class="bi bi-check2-circle"></i>
                        <div>
                            <strong>{{ hp('about.sol_core_title') }}</strong>
                            <p>{{ hp('about.sol_core_text') }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
