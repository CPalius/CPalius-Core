{% set t = 'portal' %}
<section class="section" id="entity">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('entity.label') }}</span>
            <h2 class="section-title">{{ hp('entity.title') }}</h2>
            <p class="section-desc">{{ hp('entity.desc') }}</p>
        </div>

        <div class="entity-table-wrapper fade-in">
            <table class="entity-table">
                <thead>
                    <tr>
                        <th>{{ hp('entity.col_feature') }}</th>
                        <th><i class="bi bi-file-text"></i> <span>{{ hp('entity.col_content') }}</span></th>
                        <th><i class="bi bi-briefcase"></i> <span>{{ hp('entity.col_business') }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ hp('entity.row_concept') }}</td>
                        <td>{{ hp('entity.row_concept_content') }}</td>
                        <td>{{ hp('entity.row_concept_business') }}</td>
                    </tr>
                    <tr>
                        <td>{{ hp('entity.row_slug') }}</td>
                        <td>{{ hp('entity.row_slug_content') }}</td>
                        <td>{{ hp('entity.row_slug_business') }}</td>
                    </tr>
                    <tr>
                        <td>{{ hp('entity.row_i18n') }}</td>
                        <td>{{ hp('entity.row_i18n_content') }}</td>
                        <td>{{ hp('entity.row_i18n_business') }}</td>
                    </tr>
                    <tr>
                        <td>{{ hp('entity.row_status') }}</td>
                        <td>{{ hp('entity.row_status_content') }}</td>
                        <td>{{ hp('entity.row_status_business') }}</td>
                    </tr>
                    <tr>
                        <td>{{ hp('entity.row_seo') }}</td>
                        <td>{{ hp('entity.row_seo_content') }}</td>
                        <td>{{ hp('entity.row_seo_business') }}</td>
                    </tr>
                    <tr>
                        <td>{{ hp('entity.row_common') }}</td>
                        <td colspan="2" style="text-align:center;">{{ hp('entity.row_common_value') }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="grid-golden fade-in">
            <div class="grid-golden-major">
                <h3 style="margin-bottom: var(--sp-md);">{{ hp('entity.attr_title_html')|raw }}</h3>
                <p>{{ hp('entity.attr_p1') }}</p>
                <p style="margin-top: var(--sp-sm);"><strong>{{ hp('entity.attr_thanks') }}</strong></p>
                <ul style="margin-top: var(--sp-xs);">
                    <li class="solution-item" style="border:none; padding: var(--sp-xs) 0;">
                        <i class="bi bi-check2-circle" style="color: var(--cp-success);"></i>
                        <span>{{ hp('entity.attr_cap_html')|raw }}</span>
                    </li>
                    <li class="solution-item" style="border:none; padding: var(--sp-xs) 0;">
                        <i class="bi bi-check2-circle" style="color: var(--cp-success);"></i>
                        <span>{{ hp('entity.attr_crud_html')|raw }}</span>
                    </li>
                    <li class="solution-item" style="border:none; padding: var(--sp-xs) 0;">
                        <i class="bi bi-check2-circle" style="color: var(--cp-success);"></i>
                        <span>{{ hp('entity.attr_tenant_html')|raw }}</span>
                    </li>
                    <li class="solution-item" style="border:none; padding: var(--sp-xs) 0;">
                        <i class="bi bi-check2-circle" style="color: var(--cp-success);"></i>
                        <span>{{ hp('entity.attr_audit_html')|raw }}</span>
                    </li>
                </ul>
            </div>
            <div class="grid-golden-minor">
                <div class="cp-resource-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('entity.code_header') }}
                    </div>
                    <pre><span class="comment">#[CpResource(</span>
<span class="comment">    name: 'vehicle',</span>
<span class="comment">    module: 'oto-galeri',</span>
<span class="comment">    capabilities: [</span>
<span class="comment">        'create','edit',</span>
<span class="comment">        'delete','view'</span>
<span class="comment">    ],</span>
<span class="comment">    auditable: true,</span>
<span class="comment">    multiTenant: true,</span>
<span class="comment">    workflow: 'vehicle_lifecycle'</span>
<span class="comment">)]</span>
<span class="keyword">#[ORM\Entity]</span>
<span class="keyword">class</span> <span class="function">Vehicle</span>
{
    <span class="keyword">private</span> ?<span class="function">int</span> $id;
    <span class="keyword">private</span> ?<span class="function">string</span> $plate;
    <span class="keyword">private</span> ?<span class="function">string</span> $brand;
    <span class="keyword">private</span> ?<span class="function">int</span> $price;
}</pre>
                </div>
            </div>
        </div>
    </div>
</section>
