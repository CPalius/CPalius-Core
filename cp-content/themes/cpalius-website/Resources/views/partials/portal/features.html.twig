{% set t = 'portal' %}
<section class="section section-dark" id="features">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('features.label') }}</span>
            <h2 class="section-title">{{ hp('features.title') }}</h2>
            <p class="section-desc">{{ hp('features.desc') }}</p>
        </div>

        <div class="features-grid">
            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                <h4>{{ hp('features.core_title') }}</h4>
                <p>{{ hp('features.core_text') }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="100">
                <div class="feature-icon"><i class="bi bi-database"></i></div>
                <h4>{{ hp('features.hybrid_title') }}</h4>
                <p>{{ hp('features.hybrid_text') }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="200">
                <div class="feature-icon"><i class="bi bi-translate"></i></div>
                <h4>{{ hp('features.i18n_title') }}</h4>
                <p>{{ hp('features.i18n_text') }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-lightning"></i></div>
                <h4>{{ hp('features.origin_title') }}</h4>
                <p>{{ hp('features.origin_text') }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="100">
                <div class="feature-icon"><i class="bi bi-activity"></i></div>
                <h4>{{ hp('features.ops_title') }}</h4>
                <p>{{ hp('features.ops_text') }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="200">
                <div class="feature-icon"><i class="bi bi-puzzle"></i></div>
                <h4>{{ hp('features.extend_title') }}</h4>
                <p>{{ hp('features.extend_text') }}</p>
            </div>
        </div>
    </div>
</section>
