{% set t = 'portal' %}
<section class="section section-dark" id="features">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'features.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'features.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'features.desc'|trans({}, t) }}</p>
        </div>

        <div class="features-grid">
            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-database"></i></div>
                <h4>{{ 'features.hybrid_title'|trans({}, t) }}</h4>
                <p>{{ 'features.hybrid_text'|trans({}, t) }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="100">
                <div class="feature-icon"><i class="bi bi-lightning"></i></div>
                <h4>{{ 'features.index_title'|trans({}, t) }}</h4>
                <p>{{ 'features.index_text'|trans({}, t) }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="200">
                <div class="feature-icon"><i class="bi bi-translate"></i></div>
                <h4>{{ 'features.i18n_title'|trans({}, t) }}</h4>
                <p>{{ 'features.i18n_text'|trans({}, t) }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-gear"></i></div>
                <h4>{{ 'features.config_title'|trans({}, t) }}</h4>
                <p>{{ 'features.config_text'|trans({}, t) }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="100">
                <div class="feature-icon"><i class="bi bi-layers"></i></div>
                <h4>{{ 'features.bundle_title'|trans({}, t) }}</h4>
                <p>{{ 'features.bundle_text'|trans({}, t) }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="200">
                <div class="feature-icon"><i class="bi bi-braces"></i></div>
                <h4>{{ 'features.zero_title'|trans({}, t) }}</h4>
                <p>{{ 'features.zero_text'|trans({}, t) }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                <h4>{{ 'features.xss_title'|trans({}, t) }}</h4>
                <p>{{ 'features.xss_text_html'|trans({}, t)|raw }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="100">
                <div class="feature-icon"><i class="bi bi-search"></i></div>
                <h4>{{ 'features.seo_title'|trans({}, t) }}</h4>
                <p>{{ 'features.seo_text_html'|trans({}, t)|raw }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="200">
                <div class="feature-icon"><i class="bi bi-broadcast"></i></div>
                <h4>{{ 'features.event_title'|trans({}, t) }}</h4>
                <p>{{ 'features.event_text'|trans({}, t) }}</p>
            </div>
        </div>
    </div>
</section>
