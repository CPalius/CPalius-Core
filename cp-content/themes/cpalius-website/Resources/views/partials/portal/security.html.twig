{% set t = 'portal' %}
<section class="section section-light" id="security">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('security.label') }}</span>
            <h2 class="section-title">{{ hp('security.title') }}</h2>
            <p class="section-desc">{{ hp('security.desc') }}</p>
        </div>

        <div class="security-grid">
            <div class="security-card fade-in" data-delay="0">
                <div class="security-icon"><i class="bi bi-shield-lock"></i></div>
                <h4>{{ hp('security.cbac_title') }}</h4>
                <p>{{ hp('security.cbac_p1') }}</p>
                <p><code class="code-inline">denyAccessUnlessGranted('system.module.manage')</code></p>
                <p>{{ hp('security.cbac_roles_html')|raw }}</p>
            </div>

            <div class="security-card fade-in" data-delay="100">
                <div class="security-icon"><i class="bi bi-building-lock"></i></div>
                <h4>{{ hp('security.tenant_title') }}</h4>
                <p>{{ hp('security.tenant_p1_html')|raw }}</p>
                <p>{{ hp('security.tenant_p2_html')|raw }}</p>
            </div>

            <div class="security-card fade-in" data-delay="200">
                <div class="security-icon"><i class="bi bi-speedometer2"></i></div>
                <h4>{{ hp('security.n1_title') }}</h4>
                <p>{{ hp('security.n1_p1') }}</p>
                <p>{{ hp('security.n1_p2_html')|raw }}</p>
            </div>

            <div class="security-card fade-in" data-delay="0">
                <div class="security-icon"><i class="bi bi-funnel"></i></div>
                <h4>{{ hp('security.voter_title') }}</h4>
                <p>{{ hp('security.voter_p1_html')|raw }}</p>
                <p>{{ hp('security.voter_p2_html')|raw }}</p>
            </div>

            <div class="security-card fade-in" data-delay="100">
                <div class="security-icon"><i class="bi bi-shield-check"></i></div>
                <h4>{{ hp('security.zerotrust_title') }}</h4>
                <p>{{ hp('security.zerotrust_p1') }}</p>
                <p>{{ hp('security.zerotrust_p2') }}</p>
            </div>

            <div class="security-card fade-in" data-delay="200">
                <div class="security-icon"><i class="bi bi-cpu"></i></div>
                <h4>{{ hp('security.lockfree_title') }}</h4>
                <p>{{ hp('security.lockfree_p1') }}</p>
                <p>{{ hp('security.lockfree_p2') }}</p>
            </div>
        </div>
    </div>
</section>
