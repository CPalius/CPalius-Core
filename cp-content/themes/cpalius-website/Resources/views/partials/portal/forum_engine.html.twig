{% set t = 'portal' %}
<section class="section" id="forum-engine">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'forum.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'forum.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'forum.desc'|trans({}, t) }}</p>
        </div>

        <div class="features-grid fade-in">
            <div class="feature-card" data-delay="0">
                <div class="feature-icon"><i class="bi bi-diagram-3"></i></div>
                <h4>{{ 'forum.tree_title'|trans({}, t) }}</h4>
                <p>{{ 'forum.tree_text'|trans({}, t) }}</p>
            </div>
            <div class="feature-card" data-delay="100">
                <div class="feature-icon"><i class="bi bi-tag"></i></div>
                <h4>{{ 'forum.prefix_title'|trans({}, t) }}</h4>
                <p>{{ 'forum.prefix_text_html'|trans({}, t)|raw }}</p>
            </div>
            <div class="feature-card" data-delay="200">
                <div class="feature-icon"><i class="bi bi-flag"></i></div>
                <h4>{{ 'forum.moderation_title'|trans({}, t) }}</h4>
                <p>{{ 'forum.moderation_text'|trans({}, t) }}</p>
            </div>
            <div class="feature-card" data-delay="0">
                <div class="feature-icon"><i class="bi bi-award"></i></div>
                <h4>{{ 'forum.ranks_title'|trans({}, t) }}</h4>
                <p>{{ 'forum.ranks_text'|trans({}, t) }}</p>
            </div>
            <div class="feature-card" data-delay="100">
                <div class="feature-icon"><i class="bi bi-layout-sidebar"></i></div>
                <h4>{{ 'forum.layout_title'|trans({}, t) }}</h4>
                <p>{{ 'forum.layout_text'|trans({}, t) }}</p>
            </div>
            <div class="feature-card" data-delay="200">
                <div class="feature-icon"><i class="bi bi-chat-square-quote"></i></div>
                <h4>{{ 'forum.cta_title'|trans({}, t) }}</h4>
                <p>{{ 'forum.cta_text'|trans({}, t) }}</p>
                {% if forumAvailable|default(false) %}
                    <p style="margin-top: var(--sp-sm);">
                        <a href="{{ path('forum_index') }}" class="btn btn-outline">
                            <i class="bi bi-arrow-right"></i> {{ 'community.cta_discuss'|trans({}, t) }}
                        </a>
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="code-block fade-in" style="margin-top: var(--sp-xl);">
            <div class="code-block-header">
                <i class="bi bi-columns-gap"></i> {{ 'forum.layout_code_header'|trans({}, t) }}
            </div>
            <pre>{{ 'forum.layout_code'|trans({}, t) }}</pre>
        </div>
    </div>
</section>
