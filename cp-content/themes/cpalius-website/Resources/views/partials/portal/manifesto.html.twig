{% set t = 'portal' %}
<section class="section section-light" id="manifesto">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('manifesto.label') }}</span>
            <h2 class="section-title">{{ hp('manifesto.title') }}</h2>
            <p class="section-desc">{{ hp('manifesto.desc') }}</p>
        </div>

        <div class="manifesto-content fade-in">
            <div class="manifesto-block">
                <h3><i class="bi bi-box-seam"></i> <span>{{ hp('manifesto.block1_title') }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ hp('manifesto.block1_p1_html')|raw }}</p>
                    <p>{{ hp('manifesto.block1_p2_html')|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ hp('manifesto.block1_code') }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-shield-lock"></i> <span>{{ hp('manifesto.block2_title') }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ hp('manifesto.block2_p1_html')|raw }}</p>
                    <p>{{ hp('manifesto.block2_p2_html')|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ hp('manifesto.block2_code') }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-globe"></i> <span>{{ hp('manifesto.block3_title') }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ hp('manifesto.block3_p1_html')|raw }}</p>
                    <p>{{ hp('manifesto.block3_p2_html')|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ hp('manifesto.block3_code') }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-gear-wide-connected"></i> <span>{{ hp('manifesto.block4_title') }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ hp('manifesto.block4_p1_html')|raw }}</p>
                    <p>{{ hp('manifesto.block4_p2_html')|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ hp('manifesto.block4_code') }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-hdd-network"></i> <span>{{ hp('manifesto.block5_title') }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ hp('manifesto.block5_p1_html')|raw }}</p>
                    <p>{{ hp('manifesto.block5_p2_html')|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ hp('manifesto.block5_code') }}</code></pre>
                </div>
            </div>
        </div>
    </div>
</section>
