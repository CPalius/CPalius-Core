{% set t = 'portal' %}
<section class="section section-light" id="manifesto">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'manifesto.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'manifesto.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'manifesto.desc'|trans({}, t) }}</p>
        </div>

        <div class="manifesto-content fade-in">
            <div class="manifesto-block">
                <h3><i class="bi bi-box-seam"></i> <span>{{ 'manifesto.block1_title'|trans({}, t) }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ 'manifesto.block1_p1_html'|trans({}, t)|raw }}</p>
                    <p>{{ 'manifesto.block1_p2_html'|trans({}, t)|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ 'manifesto.block1_code'|trans({}, t) }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-shield-lock"></i> <span>{{ 'manifesto.block2_title'|trans({}, t) }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ 'manifesto.block2_p1_html'|trans({}, t)|raw }}</p>
                    <p>{{ 'manifesto.block2_p2_html'|trans({}, t)|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ 'manifesto.block2_code'|trans({}, t) }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-globe"></i> <span>{{ 'manifesto.block3_title'|trans({}, t) }}</span></h3>
                <div class="manifesto-text">
                    <p>{{ 'manifesto.block3_p1_html'|trans({}, t)|raw }}</p>
                    <p>{{ 'manifesto.block3_p2_html'|trans({}, t)|raw }}</p>
                </div>
                <div class="manifesto-code">
                    <pre><code class="language-php">{{ 'manifesto.block3_code'|trans({}, t) }}</code></pre>
                </div>
            </div>

            <div class="manifesto-block">
                <h3><i class="bi bi-gear-wide-connected"></i> <span>{{ 'manifesto.block4_title'|trans({}, t) }}</span></h3>
