{% set items = data.items|default([]) %}
{% if items is not empty %}
{% set title = portalBlock.title|default('website.landing.portal.posts_title'|trans) %}
{% set layout = portalBlock.layout|default('list') %}
{% embed '@CpaliusWebsiteTheme/partials/portal/_rail.html.twig' with {
    blockId: 'latest_forum_posts',
    title: title,
    moreHref: path('forum_index'),
    moreLabel: 'website.landing.portal.forum_more'|trans,
    layout: layout,
    moduleIcon: 'bi-reply',
    items: items
} %}
    {% block list_items %}
        <table class="portal-topic-table">
            <thead>
                <tr>
                    <th class="portal-topic-table__col-icon"></th>
                    <th>{{ 'website.landing.portal.col_topic'|trans }}</th>
                    <th class="portal-topic-table__col-meta">{{ 'website.landing.portal.col_author'|trans }}</th>
                    <th class="portal-topic-table__col-meta">{{ 'website.landing.portal.col_updated'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for post in items %}
                    <tr>
                        <td class="portal-topic-table__col-icon">
                            <span class="portal-topic-table__icon"><i class="bi bi-reply-all"></i></span>
                        </td>
                        <td>
                            <a class="portal-topic-table__title" href="{{ path('forum_topic', {topicId: post.topic.id, slug: post.topic.slug|default('')}) }}">{{ post.topic.title }}</a>
                        </td>
                        <td class="portal-topic-table__col-meta">{{ post.posterName }}</td>
                        <td class="portal-topic-table__col-meta">{{ post.createdAt|date('d.m.Y H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endblock %}
    {% block card_items %}
        {% for post in items %}
            <a class="portal-tile" href="{{ path('forum_topic', {topicId: post.topic.id, slug: post.topic.slug|default('')}) }}">
                <span class="portal-tile__badge"><i class="bi bi-reply"></i></span>
                <span class="portal-tile__title">{{ post.topic.title }}</span>
                <span class="portal-tile__meta">{{ post.posterName }} · {{ post.createdAt|date('d.m.Y') }}</span>
            </a>
        {% endfor %}
    {% endblock %}
    {% block slider_items %}
        {% for post in items %}
            <a class="portal-tile portal-slider__item" href="{{ path('forum_topic', {topicId: post.topic.id, slug: post.topic.slug|default('')}) }}">
                <span class="portal-tile__badge"><i class="bi bi-reply"></i></span>
                <span class="portal-tile__title">{{ post.topic.title }}</span>
                <span class="portal-tile__meta">{{ post.posterName }}</span>
            </a>
        {% endfor %}
    {% endblock %}
{% endembed %}
{% endif %}
