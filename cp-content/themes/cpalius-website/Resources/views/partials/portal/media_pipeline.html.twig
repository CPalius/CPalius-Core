{% set t = 'portal' %}
<section class="section section-darker" id="media-pipeline">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('media.label') }}</span>
            <h2 class="section-title">{{ hp('media.title') }}</h2>
            <p class="section-desc">{{ hp('media.desc') }}</p>
        </div>

        <div class="grid-golden fade-in">
            <div class="grid-golden-major">
                <div class="feature-card" style="margin-bottom: var(--sp-md);">
                    <div class="feature-icon"><i class="bi bi-crop"></i></div>
                    <h4>{{ hp('media.processor_title') }}</h4>
                    <p>{{ hp('media.processor_text_html')|raw }}</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon"><i class="bi bi-hdd"></i></div>
                    <h4>{{ hp('media.cache_title') }}</h4>
                    <p>{{ hp('media.cache_text_html')|raw }}</p>
                </div>
            </div>
            <div class="grid-golden-minor">
                <div class="cp-resource-block">
                    <div class="code-block-header">
                        <i class="bi bi-braces"></i> {{ hp('media.filter_title') }}
                    </div>
                    <pre>{{ hp('manifesto.thumb_code') }}</pre>
                </div>
                <p style="margin-top: var(--sp-sm); font-size: var(--fs-sm); color: rgba(255,255,255,0.7);">
                    {{ hp('media.filter_text_html')|raw }}
                </p>
            </div>
        </div>
    </div>
</section>
