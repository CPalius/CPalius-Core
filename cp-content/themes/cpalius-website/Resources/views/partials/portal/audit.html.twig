{% set t = 'portal' %}
<section class="section section-dark" id="audit">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'audit.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'audit.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'audit.desc'|trans({}, t) }}</p>
        </div>

        <div class="security-grid fade-in" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
            <div class="security-card">
                <div class="security-icon"><i class="bi bi-arrow-repeat"></i></div>
                <h4>{{ 'audit.flow_title'|trans({}, t) }}</h4>
                <p style="font-size: var(--fs-xs); letter-spacing: 1px; text-transform: uppercase; color: var(--cp-accent);">{{ 'audit.flow_label'|trans({}, t) }}</p>
                <p>{{ 'audit.flow_p1_html'|trans({}, t)|raw }}</p>
                <p>{{ 'audit.flow_p2_html'|trans({}, t)|raw }}</p>
            </div>
            <div class="security-card">
                <div class="security-icon"><i class="bi bi-clock-history"></i></div>
                <h4>{{ 'audit.schema_title'|trans({}, t) }}</h4>
                <p style="font-size: var(--fs-xs); letter-spacing: 1px; text-transform: uppercase; color: var(--cp-accent);">{{ 'audit.schema_label'|trans({}, t) }}</p>
                <p>{{ 'audit.schema_p1_html'|trans({}, t)|raw }}</p>
                <p>{{ 'audit.schema_p2_html'|trans({}, t)|raw }}</p>
            </div>
        </div>

        <div class="code-block fade-in" style="margin-top: var(--sp-lg);">
            <div class="code-block-header">
                <i class="bi bi-file-code"></i> {{ 'audit.code_header'|trans({}, t) }}
            </div>
            <pre>{{ 'manifesto.audit_code'|trans({}, t) }}</pre>
        </div>
    </div>
</section>
