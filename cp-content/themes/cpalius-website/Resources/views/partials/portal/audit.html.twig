{% set t = 'portal' %}
<section class="section section-dark" id="audit">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('audit.label') }}</span>
            <h2 class="section-title">{{ hp('audit.title') }}</h2>
            <p class="section-desc">{{ hp('audit.desc') }}</p>
        </div>

        <div class="security-grid fade-in" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
            <div class="security-card">
                <div class="security-icon"><i class="bi bi-arrow-repeat"></i></div>
                <h4>{{ hp('audit.flow_title') }}</h4>
                <p style="font-size: var(--fs-xs); letter-spacing: 1px; text-transform: uppercase; color: var(--cp-accent);">{{ hp('audit.flow_label') }}</p>
                <p>{{ hp('audit.flow_p1_html')|raw }}</p>
                <p>{{ hp('audit.flow_p2_html')|raw }}</p>
            </div>
            <div class="security-card">
                <div class="security-icon"><i class="bi bi-clock-history"></i></div>
                <h4>{{ hp('audit.schema_title') }}</h4>
                <p style="font-size: var(--fs-xs); letter-spacing: 1px; text-transform: uppercase; color: var(--cp-accent);">{{ hp('audit.schema_label') }}</p>
                <p>{{ hp('audit.schema_p1_html')|raw }}</p>
                <p>{{ hp('audit.schema_p2_html')|raw }}</p>
            </div>
        </div>

        <div class="code-block fade-in" style="margin-top: var(--sp-lg);">
            <div class="code-block-header">
                <i class="bi bi-file-code"></i> {{ hp('audit.code_header') }}
            </div>
            <pre>{{ hp('manifesto.audit_code') }}</pre>
        </div>
    </div>
</section>
