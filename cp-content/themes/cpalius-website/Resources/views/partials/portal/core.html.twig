{% set t = 'portal' %}
<section class="section" id="core">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('core.label') }}</span>
            <h2 class="section-title">{{ hp('core.title') }}</h2>
            <p class="section-desc">{{ hp('core.desc') }}</p>
        </div>

        <div class="defense-timeline fade-in">
            <div class="defense-item">
                <div class="defense-number">1</div>
                <span class="defense-label">{{ hp('core.line1_label') }}</span>
                <h3 class="defense-title">{{ hp('core.line1_title') }}</h3>
                <p class="defense-text">{{ hp('core.line1_p1_html')|raw }}</p>
                <p class="defense-text">{{ hp('core.line1_p2_html')|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('core.code_file') }}
                    </div>
                    <pre><span class="comment">{{ hp('core.code_comment_core') }}</span>
$bundles = [
    FrameworkBundle::<span class="keyword">class</span> => [<span class="string">'all'</span> => <span class="keyword">true</span>],
    TwigBundle::<span class="keyword">class</span>      => [<span class="string">'all'</span> => <span class="keyword">true</span>],
    DoctrineBundle::<span class="keyword">class</span>  => [<span class="string">'all'</span> => <span class="keyword">true</span>],
    CoreBundle::<span class="keyword">class</span>      => [<span class="string">'all'</span> => <span class="keyword">true</span>],
];

<span class="comment">{{ hp('core.code_comment_modules') }}</span>
$activeModules = <span class="keyword">require</span> <span class="string">'active_modules.php'</span>;
<span class="keyword">foreach</span> ($activeModules <span class="keyword">as</span> $moduleClass) {
    <span class="keyword">if</span> (<span class="function">class_exists</span>($moduleClass)) {
        $bundles[$moduleClass] = [<span class="string">'all'</span> => <span class="keyword">true</span>];
    }
}</pre>
                </div>
            </div>

            <div class="defense-item">
                <div class="defense-number">2</div>
                <span class="defense-label">{{ hp('core.line2_label') }}</span>
                <h3 class="defense-title">{{ hp('core.line2_title') }}</h3>
                <p class="defense-text">{{ hp('core.line2_p1_html')|raw }}</p>
                <p class="defense-text">{{ hp('core.line2_p2_html')|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number">3</div>
                <span class="defense-label">{{ hp('core.line3_label') }}</span>
                <h3 class="defense-title">{{ hp('core.line3_title') }}</h3>
                <p class="defense-text">{{ hp('core.line3_p1') }}</p>
                <p class="defense-text">{{ hp('core.line3_p2_html')|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number">4</div>
                <span class="defense-label">{{ hp('core.line4_label') }}</span>
                <h3 class="defense-title">{{ hp('core.line4_title') }}</h3>
                <p class="defense-text">{{ hp('core.line4_p1_html')|raw }}</p>
                <p class="defense-text">{{ hp('core.line4_p2_html')|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('core.line4_code_header') }}
                    </div>
                    <pre>{{ hp('core.line4_code') }}</pre>
                </div>
            </div>
        </div>
    </div>
</section>

