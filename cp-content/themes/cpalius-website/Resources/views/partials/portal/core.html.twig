{% set t = 'portal' %}
<section class="section" id="core">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'core.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'core.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'core.desc'|trans({}, t) }}</p>
        </div>

        <div class="defense-timeline fade-in">
            <div class="defense-item">
                <div class="defense-number">1</div>
                <span class="defense-label">{{ 'core.line1_label'|trans({}, t) }}</span>
                <h3 class="defense-title">{{ 'core.line1_title'|trans({}, t) }}</h3>
                <p class="defense-text">{{ 'core.line1_p1_html'|trans({}, t)|raw }}</p>
                <p class="defense-text">{{ 'core.line1_p2_html'|trans({}, t)|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ 'core.code_file'|trans({}, t) }}
                    </div>
                    <pre><span class="comment">{{ 'core.code_comment_core'|trans({}, t) }}</span>
$bundles = [
    FrameworkBundle::<span class="keyword">class</span> => [<span class="string">'all'</span> => <span class="keyword">true</span>],
    TwigBundle::<span class="keyword">class</span>      => [<span class="string">'all'</span> => <span class="keyword">true</span>],
    DoctrineBundle::<span class="keyword">class</span>  => [<span class="string">'all'</span> => <span class="keyword">true</span>],
    CoreBundle::<span class="keyword">class</span>      => [<span class="string">'all'</span> => <span class="keyword">true</span>],
];

<span class="comment">{{ 'core.code_comment_modules'|trans({}, t) }}</span>
$activeModules = <span class="keyword">require</span> <span class="string">'active_modules.php'</span>;
<span class="keyword">foreach</span> ($activeModules <span class="keyword">as</span> $moduleClass) {
    <span class="keyword">if</span> (<span class="function">class_exists</span>($moduleClass)) {
        $bundles[$moduleClass] = [<span class="string">'all'</span> => <span class="keyword">true</span>];
    }
}</pre>
                </div>
            </div>

            <div class="defense-item">
                <div class="defense-number">2</div>
                <span class="defense-label">{{ 'core.line2_label'|trans({}, t) }}</span>
                <h3 class="defense-title">{{ 'core.line2_title'|trans({}, t) }}</h3>
                <p class="defense-text">{{ 'core.line2_p1_html'|trans({}, t)|raw }}</p>
                <p class="defense-text">{{ 'core.line2_p2_html'|trans({}, t)|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number">3</div>
                <span class="defense-label">{{ 'core.line3_label'|trans({}, t) }}</span>
                <h3 class="defense-title">{{ 'core.line3_title'|trans({}, t) }}</h3>
                <p class="defense-text">{{ 'core.line3_p1'|trans({}, t) }}</p>
                <p class="defense-text">{{ 'core.line3_p2_html'|trans({}, t)|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number">4</div>
                <span class="defense-label">{{ 'core.line4_label'|trans({}, t) }}</span>
                <h3 class="defense-title">{{ 'core.line4_title'|trans({}, t) }}</h3>
                <p class="defense-text">{{ 'core.line4_p1_html'|trans({}, t)|raw }}</p>
                <p class="defense-text">{{ 'core.line4_p2_html'|trans({}, t)|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ 'core.line4_code_header'|trans({}, t) }}
                    </div>
                    <pre>{{ 'core.line4_code'|trans({}, t) }}</pre>
                </div>
            </div>
        </div>
    </div>
</section>

