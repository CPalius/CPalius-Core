{% set t = 'portal' %}
<section class="section" id="aacp">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('aacp.label') }}</span>
            <h2 class="section-title">{{ hp('aacp.title') }}</h2>
            <p class="section-desc">{{ hp('aacp.desc') }}</p>
        </div>

        <div class="defense-timeline fade-in">
            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-heart-pulse"></i></div>
                <span class="defense-label">{{ hp('aacp.safe_label') }}</span>
                <h3 class="defense-title">{{ hp('aacp.safe_title') }}</h3>
                <p class="defense-text">{{ hp('aacp.safe_text_html')|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-activity"></i></div>
                <span class="defense-label">{{ hp('aacp.monitor_label') }}</span>
                <h3 class="defense-title">{{ hp('aacp.monitor_title') }}</h3>
                <p class="defense-text">{{ hp('aacp.monitor_text_html')|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-shield-exclamation"></i></div>
                <span class="defense-label">{{ hp('aacp.quarantine_label') }}</span>
                <h3 class="defense-title">{{ hp('aacp.quarantine_title') }}</h3>
                <p class="defense-text">{{ hp('aacp.quarantine_text_html')|raw }}</p>
            </div>

            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-translate"></i></div>
                <span class="defense-label">{{ hp('aacp.locale_label') }}</span>
                <h3 class="defense-title">{{ hp('aacp.locale_title') }}</h3>
                <p class="defense-text">{{ hp('aacp.locale_text_html')|raw }}</p>
            </div>
        </div>

        <div class="grid-4 fade-in" style="margin-top: var(--sp-xl);">
            <div class="card">
                <div class="card-icon"><i class="bi bi-key"></i></div>
                <h5 class="card-title">{{ hp('aacp.card_api_title') }}</h5>
                <p class="card-text">{{ hp('aacp.card_api_text') }}</p>
            </div>
            <div class="card">
                <div class="card-icon"><i class="bi bi-clock"></i></div>
                <h5 class="card-title">{{ hp('aacp.card_cron_title') }}</h5>
                <p class="card-text">{{ hp('aacp.card_cron_text') }}</p>
            </div>
            <div class="card">
                <div class="card-icon"><i class="bi bi-signpost-split"></i></div>
                <h5 class="card-title">{{ hp('aacp.card_hook_title') }}</h5>
                <p class="card-text">{{ hp('aacp.card_hook_text') }}</p>
            </div>
            <div class="card">
                <div class="card-icon"><i class="bi bi-globe2"></i></div>
                <h5 class="card-title">{{ hp('aacp.card_locale_title') }}</h5>
                <p class="card-text">{{ hp('aacp.card_locale_text') }}</p>
            </div>
        </div>
    </div>
</section>
