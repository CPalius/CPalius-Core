<section class="section section-dark" id="roadmap">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('roadmap.label') }}</span>
            <h2 class="section-title">{{ portalBlock.title|default(hp('roadmap.title')) }}</h2>
            <p class="section-desc">{{ hp('roadmap.desc') }}</p>
        </div>

        {% set roadmapUrl = hp_url('roadmap.button@url', cp_path_if_exists('roadmap_index')) %}
        {% if roadmapUrl and hp_on('roadmap.button') %}
        <p class="fade-in" style="text-align:center;">
            <a href="{{ roadmapUrl }}" class="btn btn-primary">
                <i class="bi bi-signpost-2"></i> {{ hp('nav.roadmap') }}
            </a>
        </p>
        {% endif %}
    </div>
</section>
