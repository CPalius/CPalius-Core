{% set t = 'portal' %}
<section class="section section-light" id="techstack">
    <div class="container">
        <div class="section-header fade-in" style="text-align:center;">
            <span class="section-label">{{ hp('tech.label') }}</span>
            <h2 class="section-title section-title--center">{{ hp('tech.title') }}</h2>
        </div>

        <div class="tech-bar fade-in">
            <div class="tech-item">
                <i class="bi bi-filetype-php"></i>
                <div>
                    <h5>PHP 8.4+</h5>
                    <p>{{ hp('tech.php_role') }}</p>
                </div>
            </div>
            <div class="tech-item">
                <i class="bi bi-box-seam"></i>
                <div>
                    <h5>Symfony 7.4 LTS</h5>
                    <p>{{ hp('tech.symfony_role') }}</p>
                </div>
            </div>
            <div class="tech-item">
                <i class="bi bi-database-gear"></i>
                <div>
                    <h5>Doctrine ORM</h5>
                    <p>{{ hp('tech.doctrine_role') }}</p>
                </div>
            </div>
            <div class="tech-item">
                <i class="bi bi-file-earmark-zip"></i>
                <div>
                    <h5>AssetMapper</h5>
                    <p>{{ hp('tech.asset_role') }}</p>
                </div>
            </div>
            <div class="tech-item">
                <i class="bi bi-palette"></i>
                <div>
                    <h5>Tailwind CSS</h5>
                    <p>{{ hp('tech.tailwind_role') }}</p>
                </div>
            </div>
        </div>
    </div>
</section>
