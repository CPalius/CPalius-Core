{% set t = 'portal' %}
<section class="section section-light" id="localization">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('localization.label') }}</span>
            <h2 class="section-title">{{ hp('localization.title') }}</h2>
            <p class="section-desc">{{ hp('localization.desc') }}</p>
        </div>

        <div class="features-grid fade-in">
            <div class="feature-card" data-delay="0">
                <div class="feature-icon"><i class="bi bi-link-45deg"></i></div>
                <h4>{{ hp('localization.group_title') }}</h4>
                <p>{{ hp('localization.group_text_html')|raw }}</p>
            </div>
            <div class="feature-card" data-delay="100">
                <div class="feature-icon"><i class="bi bi-signpost-2"></i></div>
                <h4>{{ hp('localization.switch_title') }}</h4>
                <p>{{ hp('localization.switch_text_html')|raw }}</p>
            </div>
            <div class="feature-card" data-delay="200">
                <div class="feature-icon"><i class="bi bi-file-earmark-lock"></i></div>
                <h4>{{ hp('localization.atomic_title') }}</h4>
                <p>{{ hp('localization.atomic_text_html')|raw }}</p>
            </div>
        </div>

        <div class="grid-golden fade-in" style="margin-top: var(--sp-xl);">
            <div class="grid-golden-major">
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('localization.switch_code_header') }}
                    </div>
                    <pre>{{ hp('localization.switch_code') }}</pre>
                </div>
            </div>
            <div class="grid-golden-minor">
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-earmark-check"></i> {{ hp('localization.atomic_code_header') }}
                    </div>
                    <pre>{{ hp('localization.atomic_code') }}</pre>
                </div>
            </div>
        </div>
    </div>
</section>
