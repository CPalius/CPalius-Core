{% set t = 'portal' %}
<section class="section section-dark" id="platform">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('platform.label') }}</span>
            <h2 class="section-title">{{ hp('platform.title') }}</h2>
            <p class="section-desc">{{ hp('platform.desc') }}</p>
        </div>

        <div class="defense-timeline fade-in">
            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-hdd-network"></i></div>
                <span class="defense-label">{{ hp('platform.api_label') }}</span>
                <h3 class="defense-title">{{ hp('platform.api_title') }}</h3>
                <p class="defense-text">{{ hp('platform.api_text_html')|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('platform.api_code_header') }}
                    </div>
                    <pre>{{ hp('platform.api_code') }}</pre>
                </div>
            </div>

            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-plug"></i></div>
                <span class="defense-label">{{ hp('platform.hook_label') }}</span>
                <h3 class="defense-title">{{ hp('platform.hook_title') }}</h3>
                <p class="defense-text">{{ hp('platform.hook_text_html')|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('platform.hook_code_header') }}
                    </div>
                    <pre>{{ hp('platform.hook_code') }}</pre>
                </div>
            </div>

            <div class="defense-item">
                <div class="defense-number"><i class="bi bi-clock-history"></i></div>
                <span class="defense-label">{{ hp('platform.cron_label') }}</span>
                <h3 class="defense-title">{{ hp('platform.cron_title') }}</h3>
                <p class="defense-text">{{ hp('platform.cron_text_html')|raw }}</p>
                <div class="code-block">
                    <div class="code-block-header">
                        <i class="bi bi-file-code"></i> {{ hp('platform.cron_code_header') }}
                    </div>
                    <pre>{{ hp('platform.cron_code') }}</pre>
                </div>
            </div>
        </div>

        <div class="features-grid" style="margin-top: var(--sp-xl);">
            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-puzzle"></i></div>
                <h4>{{ hp('platform.plugin_title') }}</h4>
                <p>{{ hp('platform.plugin_text_html')|raw }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="100">
                <div class="feature-icon"><i class="bi bi-diagram-2"></i></div>
                <h4>{{ hp('platform.n1_title') }}</h4>
                <p>{{ hp('platform.n1_text_html')|raw }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="200">
                <div class="feature-icon"><i class="bi bi-envelope-paper"></i></div>
                <h4>{{ hp('platform.messenger_title') }}</h4>
                <p>{{ hp('platform.messenger_text_html')|raw }}</p>
            </div>

            <div class="feature-card fade-in" data-delay="0">
                <div class="feature-icon"><i class="bi bi-sliders"></i></div>
                <h4>{{ hp('platform.settings_title') }}</h4>
                <p>{{ hp('platform.settings_text_html')|raw }}</p>
            </div>
        </div>
    </div>
</section>
