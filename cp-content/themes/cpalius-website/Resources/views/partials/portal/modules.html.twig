{% set t = 'portal' %}
<section class="section section-light" id="modules">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('modules.label') }}</span>
            <h2 class="section-title">{{ hp('modules.title') }}</h2>
            <p class="section-desc">{{ hp('modules.desc') }}</p>
        </div>

        <div class="grid-3 fade-in">
            <div class="card">
                <div class="card-icon"><i class="bi bi-file-earmark-text"></i></div>
                <h5 class="card-title">{{ hp('modules.blog_title') }}</h5>
                <p class="card-text">{{ hp('modules.blog_text_html')|raw }}</p>
            </div>
            <div class="card">
                <div class="card-icon"><i class="bi bi-images"></i></div>
                <h5 class="card-title">{{ hp('modules.media_title') }}</h5>
                <p class="card-text">{{ hp('modules.media_text_html')|raw }}</p>
            </div>
            <div class="card">
                <div class="card-icon"><i class="bi bi-list-nested"></i></div>
                <h5 class="card-title">{{ hp('modules.menu_title') }}</h5>
                <p class="card-text">{{ hp('modules.menu_text_html')|raw }}</p>
            </div>
        </div>
    </div>
</section>
