{% set t = 'portal' %}
<section class="section section-darker" id="stats">
    <div class="container">
        <div class="stats-bar fade-in">
            <div class="stat-item">
                <div class="stat-number" data-count="4">0</div>
                <div class="stat-label">{{ 'stats.defense'|trans({}, t) }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="0">0</div>
                <div class="stat-label">{{ 'stats.n1'|trans({}, t) }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="4">0</div>
                <div class="stat-label">{{ 'stats.layers'|trans({}, t) }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="∞">∞</div>
                <div class="stat-label">{{ 'stats.modules'|trans({}, t) }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="100" data-prefix="%">0</div>
                <div class="stat-label">{{ 'stats.opensource'|trans({}, t) }}</div>
            </div>
        </div>
    </div>
</section>
