<section class="portal-zone" id="stats">
    <div class="container">
        <div class="portal-module fade-in">
            <div class="portal-module__head">
                <h2 class="portal-module__title">
                    <i class="bi bi-speedometer2"></i>
                    <span>Platform Özeti</span>
                </h2>
                <span class="portal-module__eyebrow">İstatistik</span>
            </div>
            <div class="portal-module__body portal-module__body--stats">
                <div class="portal-stat-boxes portal-stat-boxes--4">
                    <div class="portal-stat-box">
                        <span class="portal-stat-box__icon"><i class="bi bi-shield"></i></span>
                        <div>
                            <div class="portal-stat-box__value" data-count="3">0</div>
                            <div class="portal-stat-box__label">Savunma Hattı</div>
                        </div>
                    </div>
                    <div class="portal-stat-box">
                        <span class="portal-stat-box__icon"><i class="bi bi-database-x"></i></span>
                        <div>
                            <div class="portal-stat-box__value" data-count="0">0</div>
                            <div class="portal-stat-box__label">N+1 Toleransı</div>
                        </div>
                    </div>
                    <div class="portal-stat-box">
                        <span class="portal-stat-box__icon"><i class="bi bi-puzzle"></i></span>
                        <div>
                            <div class="portal-stat-box__value">∞</div>
                            <div class="portal-stat-box__label">Modül Kapasitesi</div>
                        </div>
                    </div>
                    <div class="portal-stat-box">
                        <span class="portal-stat-box__icon"><i class="bi bi-github"></i></span>
                        <div>
                            <div class="portal-stat-box__value" data-count="100" data-prefix="%">0</div>
                            <div class="portal-stat-box__label">Açık Kaynak</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
