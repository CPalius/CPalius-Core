{% set t = 'portal' %}
<section class="section section-darker" id="stats">
    <div class="container">
        <div class="stats-bar fade-in">
            <div class="stat-item">
                <div class="stat-number" data-count="4">0</div>
                <div class="stat-label">{{ hp('stats.defense') }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="0">0</div>
                <div class="stat-label">{{ hp('stats.n1') }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="4">0</div>
                <div class="stat-label">{{ hp('stats.layers') }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="∞">∞</div>
                <div class="stat-label">{{ hp('stats.modules') }}</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" data-count="100" data-prefix="%">0</div>
                <div class="stat-label">{{ hp('stats.opensource') }}</div>
            </div>
        </div>
    </div>
</section>
