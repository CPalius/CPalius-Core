{#
    Every string, link and element below is read through hp()/hp_url()/hp_on(), so
    AACP → Appearance → Homepage can change or remove any of it. With no override
    the page is exactly the one that shipped.
#}
{% set repoUrl = 'https://github.com/CPalius/CPalius-Core' %}
{% set downloadUrl = hp_url('hero.cta_download@url', repoUrl ~ '/releases/latest') %}
{% set whitepaperUrl = hp_url('hero.cta_whitepaper@url', cp_path_if_exists('whitepaper_show', {_locale: app.request.locale})) %}
{% set githubUrl = hp_url('hero.github@url', repoUrl) %}
<section class="hero" id="hero">
    <div class="container{{ hp_on('hero.code') ? ' hero-grid' : '' }}">
        <div class="hero-content">
            {% if hp_has('hero.title') %}
            <h1 class="hero-title">{{ hp('hero.title') }}</h1>
            {% else %}
            <h1 class="hero-title">CPalius <span class="text-accent">CMF</span></h1>
            {% endif %}
            {% if hp_on('hero.subtitle') %}
            <p class="hero-subtitle">
                {{ hp('hero.subtitle_line1') }}
                <em>{{ hp('hero.subtitle_em') }}</em>
                {{ hp('hero.subtitle_line2') }}
            </p>
            {% endif %}
            {% if hp('hero.desc') %}<p class="hero-desc">{{ hp('hero.desc') }}</p>{% endif %}
            {% if (downloadUrl and hp_on('hero.cta_download')) or (whitepaperUrl and hp_on('hero.cta_whitepaper')) %}
            <div class="hero-actions">
                {% if downloadUrl and hp_on('hero.cta_download') %}
                <a href="{{ downloadUrl }}" class="btn btn-primary" rel="noopener">
                    <i class="bi bi-download" aria-hidden="true"></i>
                    {{ hp('hero.cta_download') }}
                    {% if hp_on('hero.version') %}<span class="hero-version">v{{ cp_version() }}</span>{% endif %}
                </a>
                {% endif %}
                {% if whitepaperUrl and hp_on('hero.cta_whitepaper') %}
                <a href="{{ whitepaperUrl }}" class="btn btn-secondary">
                    <i class="bi bi-book" aria-hidden="true"></i> {{ hp('hero.cta_whitepaper') }}
                </a>
                {% endif %}
            </div>
            {% endif %}
            {% if hp_on('hero.meta') %}
            <ul class="hero-meta">
                <li>PHP 8.4+</li>
                <li>MySQL 8 / MariaDB 10.6+</li>
                <li>{{ hp('hero.meta_no_node') }}</li>
                {% if githubUrl %}<li><a href="{{ githubUrl }}" rel="noopener"><i class="bi bi-github" aria-hidden="true"></i> GitHub</a></li>{% endif %}
            </ul>
            {% endif %}
        </div>

        {# The real #[CpResource] signature (cp-core/src/Core/Annotation/CpResource.php), not an illustration. #}
        {% if hp_on('hero.code') %}
        <figure class="hero-visual hero-code">
            <div class="hero-code__bar" aria-hidden="true">
                <span>Vehicle.php</span>
                <span>PHP 8.4</span>
            </div>
            <pre class="hero-code__body"><code><span class="tok-attr">#[CpResource</span>(
    name: <span class="tok-str">'vehicle'</span>,
    capabilities: [<span class="tok-str">'create'</span>, <span class="tok-str">'edit'</span>, <span class="tok-str">'delete'</span>, <span class="tok-str">'view'</span>],
    auditable: <span class="tok-kw">true</span>,
    multiTenant: <span class="tok-kw">true</span>,
    workflow: <span class="tok-str">'vehicle_lifecycle'</span>,
)<span class="tok-attr">]</span>
<span class="tok-attr">#[ORM\Entity]</span>
<span class="tok-kw">final class</span> <span class="tok-type">Vehicle</span> { &hellip; }</code></pre>
            <figcaption class="hero-code__note">{{ hp('hero.code_note_html')|raw }}</figcaption>
        </figure>
        {% endif %}
    </div>
</section>
