{% set t = 'portal' %}
<section class="hero" id="hero">
    <div class="container hero-grid">
        <div class="hero-content">
            <p class="hero-label">{{ 'hero.label'|trans({}, t) }}</p>
            <h1 class="hero-title">CPalius <span class="text-accent">CMF</span></h1>
            <p class="hero-subtitle">
                <span>{{ 'hero.subtitle_line1'|trans({}, t) }}</span><br>
                <em>{{ 'hero.subtitle_em'|trans({}, t) }}</em>
                <span>{{ 'hero.subtitle_line2'|trans({}, t) }}</span>
            </p>
            <p class="hero-desc">{{ 'hero.desc'|trans({}, t) }}</p>
            <div class="hero-actions">
                <a href="{{ path('whitepaper_show', {_locale: app.request.locale}) }}" class="btn btn-primary">
                    <i class="bi bi-book"></i> {{ 'hero.cta_whitepaper'|trans({}, t) }}
                </a>
                <a href="#features" class="btn btn-secondary">
                    <i class="bi bi-grid"></i> {{ 'hero.cta_features'|trans({}, t) }}
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-stage">
                <div class="hero-stage-ring ring-1"></div>
                <div class="hero-stage-ring ring-2"></div>
                <div class="hero-stage-ring ring-3"></div>
                <div class="hero-stage-orbit">
                    <span class="orbit-dot"></span>
                </div>
                <div class="hero-stage-orbit orbit-reverse">
                    <span class="orbit-dot"></span>
                </div>
                <div class="hero-stage-glow"></div>
                <div class="hero-stage-glow-core"></div>
                <div class="hero-stage-floor"></div>
                <img src="{{ cp_appearance().logo }}" alt="" class="hero-stage-logo">
                <span class="hero-spark spark-1"></span>
                <span class="hero-spark spark-2"></span>
                <span class="hero-spark spark-3"></span>
                <span class="hero-spark spark-4"></span>
                <span class="hero-spark spark-5"></span>
                <span class="hero-spark spark-6"></span>
            </div>
        </div>
    </div>
</section>
