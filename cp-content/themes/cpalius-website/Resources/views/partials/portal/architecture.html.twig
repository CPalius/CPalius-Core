{% set t = 'portal' %}
<section class="section section-darker" id="architecture">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ 'architecture.label'|trans({}, t) }}</span>
            <h2 class="section-title">{{ 'architecture.title'|trans({}, t) }}</h2>
            <p class="section-desc">{{ 'architecture.desc'|trans({}, t) }}</p>
        </div>

        <div class="arch-layout">
            <div class="arch-tree-wrapper fade-in-left">
                <div class="folder-tree">
                    <div class="folder-tree-header">
                        <span class="folder-tree-dot red"></span>
                        <span class="folder-tree-dot yellow"></span>
                        <span class="folder-tree-dot green"></span>
                        <span>pristine-root</span>
                    </div>
                    <pre><span class="folder-name">CPalius/</span>
│
├── <span class="folder-name">cp-core/</span>          <span class="folder-comment">{{ 'architecture.tree_kernel'|trans({}, t) }}</span>
│   ├── bin/          <span class="folder-comment">{{ 'architecture.tree_bin'|trans({}, t) }}</span>
│   ├── config/       <span class="folder-comment">{{ 'architecture.tree_config'|trans({}, t) }}</span>
│   ├── migrations/   <span class="folder-comment">{{ 'architecture.tree_migrations'|trans({}, t) }}</span>
│   ├── src/          <span class="folder-comment">{{ 'architecture.tree_src'|trans({}, t) }}</span>
│   └── var/          <span class="folder-comment">{{ 'architecture.tree_var'|trans({}, t) }}</span>
│
├── <span class="folder-name">cp-includes/</span>      <span class="folder-comment">{{ 'architecture.tree_deps'|trans({}, t) }}</span>
│   └── vendor/       <span class="folder-comment">{{ 'architecture.tree_vendor'|trans({}, t) }}</span>
│
├── <span class="folder-name">cp-content/</span>       <span class="folder-comment">{{ 'architecture.tree_user'|trans({}, t) }}</span>
│   ├── config/       <span class="folder-comment">{{ 'architecture.tree_config_sync'|trans({}, t) }}</span>
│   ├── modules/      <span class="folder-comment">{{ 'architecture.tree_modules'|trans({}, t) }}</span>
│   ├── themes/       <span class="folder-comment">{{ 'architecture.tree_themes'|trans({}, t) }}</span>
│   └── translations/ <span class="folder-comment">{{ 'architecture.tree_translations'|trans({}, t) }}</span>
│
├── <span class="folder-name">public/</span>           <span class="folder-comment">{{ 'architecture.tree_web'|trans({}, t) }}</span>
│   ├── index.php     <span class="folder-comment">{{ 'architecture.tree_index'|trans({}, t) }}</span>
│   └── assets/       <span class="folder-comment">{{ 'architecture.tree_assets'|trans({}, t) }}</span>
│
├── .env
└── composer.json</pre>
                </div>
            </div>

            <div class="arch-cards-wrapper fade-in-right">
                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-cpu"></i></div>
                    <div class="arch-card-content">
                        <h5>cp-core/ <code>{{ 'architecture.card_core_title'|trans({}, t) }}</code></h5>
                        <p>{{ 'architecture.card_core_text'|trans({}, t) }}</p>
                    </div>
                </div>

                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="arch-card-content">
                        <h5>cp-includes/ <code>{{ 'architecture.card_includes_title'|trans({}, t) }}</code></h5>
                        <p>{{ 'architecture.card_includes_html'|trans({}, t)|raw }}</p>
                    </div>
                </div>

                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-puzzle"></i></div>
                    <div class="arch-card-content">
                        <h5>cp-content/ <code>{{ 'architecture.card_content_title'|trans({}, t) }}</code></h5>
                        <p>{{ 'architecture.card_content_text'|trans({}, t) }}</p>
                    </div>
                </div>

                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-globe"></i></div>
                    <div class="arch-card-content">
                        <h5>public/ <code>{{ 'architecture.card_public_title'|trans({}, t) }}</code></h5>
                        <p>{{ 'architecture.card_public_text'|trans({}, t) }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
