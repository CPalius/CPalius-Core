{% set t = 'portal' %}
<section class="section section-darker" id="architecture">
    <div class="container">
        <div class="section-header fade-in">
            <span class="section-label">{{ hp('architecture.label') }}</span>
            <h2 class="section-title">{{ hp('architecture.title') }}</h2>
            <p class="section-desc">{{ hp('architecture.desc') }}</p>
        </div>

        <div class="arch-layout">
            <div class="arch-tree-wrapper fade-in-left">
                <div class="folder-tree">
                    <div class="folder-tree-header">
                        <span class="folder-tree-dot red"></span>
                        <span class="folder-tree-dot yellow"></span>
                        <span class="folder-tree-dot green"></span>
                        <span>pristine-root</span>
                    </div>
                    <pre><span class="folder-name">CPalius/</span>
│
├── <span class="folder-name">cp-core/</span>          <span class="folder-comment">{{ hp('architecture.tree_kernel') }}</span>
│   ├── bin/          <span class="folder-comment">{{ hp('architecture.tree_bin') }}</span>
│   ├── config/       <span class="folder-comment">{{ hp('architecture.tree_config') }}</span>
│   ├── migrations/   <span class="folder-comment">{{ hp('architecture.tree_migrations') }}</span>
│   ├── src/          <span class="folder-comment">{{ hp('architecture.tree_src') }}</span>
│   └── var/          <span class="folder-comment">{{ hp('architecture.tree_var') }}</span>
│
├── <span class="folder-name">cp-includes/</span>      <span class="folder-comment">{{ hp('architecture.tree_deps') }}</span>
│   └── vendor/       <span class="folder-comment">{{ hp('architecture.tree_vendor') }}</span>
│
├── <span class="folder-name">cp-content/</span>       <span class="folder-comment">{{ hp('architecture.tree_user') }}</span>
│   ├── config/       <span class="folder-comment">{{ hp('architecture.tree_config_sync') }}</span>
│   ├── modules/      <span class="folder-comment">{{ hp('architecture.tree_modules') }}</span>
│   ├── themes/       <span class="folder-comment">{{ hp('architecture.tree_themes') }}</span>
│   └── translations/ <span class="folder-comment">{{ hp('architecture.tree_translations') }}</span>
│
├── <span class="folder-name">public/</span>           <span class="folder-comment">{{ hp('architecture.tree_web') }}</span>
│   ├── index.php     <span class="folder-comment">{{ hp('architecture.tree_index') }}</span>
│   └── assets/       <span class="folder-comment">{{ hp('architecture.tree_assets') }}</span>
│
├── .env
└── composer.json</pre>
                </div>
            </div>

            <div class="arch-cards-wrapper fade-in-right">
                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-cpu"></i></div>
                    <div class="arch-card-content">
                        <h5>cp-core/ <code>{{ hp('architecture.card_core_title') }}</code></h5>
                        <p>{{ hp('architecture.card_core_text') }}</p>
                    </div>
                </div>

                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="arch-card-content">
                        <h5>cp-includes/ <code>{{ hp('architecture.card_includes_title') }}</code></h5>
                        <p>{{ hp('architecture.card_includes_html')|raw }}</p>
                    </div>
                </div>

                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-puzzle"></i></div>
                    <div class="arch-card-content">
                        <h5>cp-content/ <code>{{ hp('architecture.card_content_title') }}</code></h5>
                        <p>{{ hp('architecture.card_content_text') }}</p>
                    </div>
                </div>

                <div class="arch-card">
                    <div class="arch-card-icon"><i class="bi bi-globe"></i></div>
                    <div class="arch-card-content">
                        <h5>public/ <code>{{ hp('architecture.card_public_title') }}</code></h5>
                        <p>{{ hp('architecture.card_public_text') }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
