{% extends 'admin/layout.html.twig' %}

{% block title %}{{ 'messages.admin.thread'|trans }}{% endblock %}
{% block header %}{{ thread.subject ?: thread.publicId }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_messages_threads_index') }}" class="btn btn-sm btn-neutral">{{ 'messages.action.back'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@MessagesModule/admin/_desk_nav.html.twig' %}

    <twig:studio:card title="{{ 'messages.admin.thread_meta'|trans }}">
        <twig:block name="content">
            <p class="text-fs-sm">{{ 'messages.admin.public_id'|trans }}: <code>{{ thread.publicId }}</code></p>
            <p class="text-fs-sm">{{ thread.contextType ? thread.contextType ~ ' #' ~ thread.contextId : 'messages.admin.no_context'|trans }}</p>
            <form method="post" action="{{ path('admin_messages_threads_close', {id: thread.id}) }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                {% if thread.closed %}
                    <input type="hidden" name="reopen" value="1">
                    <button class="btn btn-sm btn-primary">{{ 'messages.admin.reopen'|trans }}</button>
                {% else %}
                    <button class="btn btn-sm btn-outline-danger">{{ 'messages.admin.close'|trans }}</button>
                {% endif %}
            </form>
        </twig:block>
    </twig:studio:card>

    <div class="mt-4 space-y-3">
        {% for message in messages %}
            <twig:studio:card>
                <twig:block name="content">
                    <p class="text-fs-xs text-neutral-500">
                        {{ message.author ? message.author.publicDisplayName : '—' }} · {{ message.createdAt|date('Y-m-d H:i') }}
                        {% if message.deleted %} · {{ 'messages.thread.deleted_body'|trans }}{% endif %}
                    </p>
                    {% if not message.deleted %}
                        <div class="mt-2">{{ message.body|text_format(message.bodyFormat) }}</div>
                        <form method="post" action="{{ path('admin_messages_threads_delete_message', {id: thread.id, messageId: message.id}) }}" class="mt-2">
                            <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                            <button class="btn btn-sm btn-outline-danger">{{ 'messages.action.delete'|trans }}</button>
                        </form>
                    {% endif %}
                </twig:block>
            </twig:studio:card>
        {% endfor %}
    </div>
{% endblock %}
