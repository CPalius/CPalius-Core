{% extends '@MessagesModule/front/layout.html.twig' %}

{% block title %}{{ 'messages.compose.title'|trans }}{% endblock %}

{% block messages_main %}
<div class="messages-page">
    <h1>{{ 'messages.compose.heading'|trans }}</h1>
    <p class="lead">{{ 'messages.compose.lead'|trans }}</p>

    <nav class="messages-nav">
        <a href="{{ path('messages_inbox') }}">{{ 'messages.nav.inbox'|trans }}</a>
        <a href="{{ path('messages_compose') }}" class="is-active">{{ 'messages.nav.compose'|trans }}</a>
    </nav>

    {% if errors %}
        <ul class="messages-errors">
            {% for error in errors %}
                <li>{{ error|trans }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if denied %}
        <p class="messages-errors">{{ denied|trans }}</p>
    {% endif %}

    <p class="messages-quota">
        {% if quota.exempt %}
            {{ 'messages.quota.exempt'|trans }}
        {% else %}
            {{ 'messages.quota.summary'|trans({
                hourly: quota.hourlyRemaining is null ? '∞' : quota.hourlyRemaining,
                daily: quota.dailyRemaining is null ? '∞' : quota.dailyRemaining,
                threads: quota.threadsRemaining is null ? '∞' : quota.threadsRemaining
            }) }}
        {% endif %}
    </p>

    {% if recipient %}
        <p>{{ 'messages.compose.to'|trans({name: recipient.publicDisplayName}) }}</p>
    {% endif %}

    {% if context.type %}
        <p class="messages-context">
            {{ 'messages.compose.about'|trans({label: context.label ?: context.type}) }}
            {% if context.url %}<a href="{{ context.url }}">{{ context.url }}</a>{% endif %}
        </p>
    {% endif %}

    <form method="post" class="messages-form">
        <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
        <input type="hidden" name="context_type" value="{{ context.type }}">
        <input type="hidden" name="context_id" value="{{ context.id }}">
        <input type="hidden" name="context_label" value="{{ context.label }}">
        <input type="hidden" name="context_url" value="{{ context.url }}">

        <div class="messages-recipient" data-messages-suggest="{{ path('messages_suggest') }}">
            <label for="messagesToQuery">{{ 'messages.compose.recipient'|trans }}</label>
            <input type="hidden" name="to" id="messagesTo" value="{{ recipient ? (recipient.username ?: recipient.id) : '' }}" required>
            <div class="messages-recipient__picked" id="messagesToPicked" {% if not recipient %}hidden{% endif %}>
                <span class="messages-recipient__avatar" aria-hidden="true">
                    {% if recipientAvatar %}
                        <img src="{{ recipientAvatar }}" alt="">
                    {% else %}
                        <span>{{ recipient ? (recipient.publicDisplayName|default('?')|trim|first|upper) : '?' }}</span>
                    {% endif %}
                </span>
                <span class="messages-recipient__meta">
                    <strong id="messagesToHandle">{{ recipient ? '@' ~ (recipient.username ?: recipient.id) : '' }}</strong>
                    <small id="messagesToName">{{ recipient and recipient.username and recipient.publicDisplayName != recipient.username ? recipient.fullName : '' }}</small>
                </span>
                <button type="button" class="messages-recipient__clear" id="messagesToClear" aria-label="{{ 'messages.compose.change_recipient'|trans }}">&times;</button>
            </div>
            <div class="messages-recipient__search" id="messagesToSearch" {% if recipient %}hidden{% endif %}>
                <span class="messages-recipient__at" aria-hidden="true">@</span>
                <input type="text" id="messagesToQuery" value=""
                       placeholder="{{ 'messages.compose.recipient_placeholder'|trans }}"
                       autocomplete="off" spellcheck="false" role="combobox"
                       aria-autocomplete="list" aria-expanded="false" aria-controls="messagesToList">
            </div>
            <ul class="messages-recipient__list" id="messagesToList" role="listbox" hidden></ul>
            <p class="messages-recipient__hint" id="messagesToEmpty" hidden>{{ 'messages.compose.no_matches'|trans }}</p>
        </div>
        <label>
            {{ 'messages.compose.subject'|trans }}
            <input type="text" name="subject" maxlength="191" value="{{ app.request.request.get('subject', context.label) }}">
        </label>
        <label>
            {{ 'messages.compose.body'|trans }}
            <textarea name="body" rows="8" required>{{ app.request.request.get('body') }}</textarea>
        </label>
        {% if formats|length > 1 %}
            <label>
                {{ 'messages.compose.format'|trans }}
                <select name="body_format">
                    {% for id, label in formats %}
                        <option value="{{ id }}">{{ label|trans }}</option>
                    {% endfor %}
                </select>
            </label>
        {% endif %}
        <div class="messages-actions">
            <button type="submit" class="messages-btn">{{ 'messages.action.send'|trans }}</button>
            <a href="{{ path('messages_inbox') }}" class="messages-btn messages-btn--ghost">{{ 'messages.action.cancel'|trans }}</a>
        </div>
    </form>
</div>
{% endblock %}

{% block messages_javascripts %}
    {% include '@MessagesModule/front/partials/_compose_suggest.html.twig' %}
{% endblock %}
