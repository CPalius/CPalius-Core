{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'visitorstats.menu.title'|trans }}{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'visitorstats-charts']) }}
{% endblock %}

{% block body %}
    <div class="space-y-sp-md">
        <twig:cp:card padded="{{ true }}">
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <div class="rounded-md border border-white/10 bg-dark-1 px-2.5 py-2">
                    <span class="block font-mono text-[0.65rem] uppercase tracking-wide !text-slate-500">{{ 'visitorstats.today.views'|trans }}</span>
                    <strong class="mt-0.5 block font-mono text-lg !text-emerald-300">{{ today.pageViews }}</strong>
                </div>
                <div class="rounded-md border border-white/10 bg-dark-1 px-2.5 py-2">
                    <span class="block font-mono text-[0.65rem] uppercase tracking-wide !text-slate-500">{{ 'visitorstats.today.unique'|trans }}</span>
                    <strong class="mt-0.5 block font-mono text-lg !text-emerald-300">{{ today.uniqueIps }}</strong>
                </div>
            </div>
        </twig:cp:card>

        <twig:cp:card title="{{ 'visitorstats.daily.title'|trans({days: dailyDays})|upper }}" padded="{{ true }}">
            <twig:block name="actions">
                <div class="flex items-center gap-3 font-mono text-[0.65rem] uppercase tracking-wide !text-slate-400">
                    <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full" style="background:#059669"></span>{{ 'visitorstats.chart.total'|trans }}</span>
                    <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full" style="background:#6ee7b7"></span>{{ 'visitorstats.chart.unique'|trans }}</span>
                </div>
            </twig:block>
            <div class="h-64">
                <canvas data-visitorstats-chart="daily" data-visitorstats-data="{{ dailyChart|json_encode|e('html_attr') }}"></canvas>
            </div>
        </twig:cp:card>

        <twig:cp:card title="{{ 'visitorstats.monthly.title'|trans({months: monthlyMonths})|upper }}" padded="{{ true }}">
            <div class="h-48">
                <canvas data-visitorstats-chart="monthly" data-visitorstats-data="{{ monthlyChart|json_encode|e('html_attr') }}"></canvas>
            </div>
        </twig:cp:card>
    </div>
{% endblock %}
