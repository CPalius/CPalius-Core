{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'visitorstats.menu.title'|trans }}{% endblock %}

{% block body %}
    <div class="space-y-sp-md">
        <twig:cp:card padded="{{ true }}">
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <div class="rounded-md border border-white/10 bg-dark-1 px-2.5 py-2">
                    <span class="block font-mono text-[0.65rem] uppercase tracking-wide !text-slate-500">{{ 'visitorstats.today.views'|trans }}</span>
                    <strong class="mt-0.5 block font-mono text-lg !text-emerald-300">{{ today.pageViews }}</strong>
                </div>
                <div class="rounded-md border border-white/10 bg-dark-1 px-2.5 py-2">
                    <span class="block font-mono text-[0.65rem] uppercase tracking-wide !text-slate-500">{{ 'visitorstats.today.unique'|trans }}</span>
                    <strong class="mt-0.5 block font-mono text-lg !text-emerald-300">{{ today.uniqueIps }}</strong>
                </div>
            </div>
        </twig:cp:card>

        <twig:cp:card title="{{ 'visitorstats.daily.title'|trans({days: daily|length}) }}" padded="{{ true }}">
            <div class="flex h-40 items-end gap-[3px]">
                {% for day in daily %}
                    {% set pct = ((day.totalViews / maxDailyViews) * 100)|round(1) %}
                    <div class="group flex min-w-0 flex-1 flex-col items-center justify-end gap-1">
                        <span class="font-mono text-fs-xs !text-slate-400 opacity-0 transition-opacity group-hover:opacity-100">{{ day.totalViews }}</span>
                        <div class="flex h-full w-full items-end" title="{{ day.date }}: {{ day.totalViews }} {{ 'visitorstats.chart.views_unit'|trans }}, {{ day.uniqueVisitors }} {{ 'visitorstats.chart.unique_unit'|trans }}">
                            <span class="w-full rounded-t-sm bg-emerald-500/70 transition-colors group-hover:bg-emerald-400" style="height: {{ max(pct, 2) }}%"></span>
                        </div>
                        <span class="font-mono text-[0.6rem] !text-slate-600">{{ day.date|slice(-2) }}</span>
                    </div>
                {% endfor %}
            </div>
        </twig:cp:card>

        <twig:cp:card title="{{ 'visitorstats.monthly.title'|trans({months: monthly|length}) }}" padded="{{ true }}">
            <div class="flex h-40 items-end gap-2">
                {% for row in monthly %}
                    {% set pct = ((row.totalViews / maxMonthlyViews) * 100)|round(1) %}
                    <div class="group flex min-w-0 flex-1 flex-col items-center justify-end gap-1">
                        <span class="font-mono text-fs-xs !text-slate-400 opacity-0 transition-opacity group-hover:opacity-100">{{ row.totalViews }}</span>
                        <div class="flex h-full w-full items-end" title="{{ row.month }}: {{ row.totalViews }} {{ 'visitorstats.chart.views_unit'|trans }}, {{ row.uniqueVisitors }} {{ 'visitorstats.chart.unique_unit'|trans }}">
                            <span class="w-full rounded-t-sm bg-primary-500/70 transition-colors group-hover:bg-primary-400" style="height: {{ max(pct, 2) }}%"></span>
                        </div>
                        <span class="font-mono text-[0.65rem] !text-slate-500">{{ row.month|slice(-2) }}</span>
                    </div>
                {% endfor %}
            </div>
        </twig:cp:card>
    </div>
{% endblock %}
