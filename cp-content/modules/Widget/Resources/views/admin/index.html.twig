{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'widget.studio.header'|trans }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap(['widget-admin']) }}
{% endblock %}

{% block body %}
    {% if area is null %}
        <twig:studio:card>
            <p class="text-fs-sm text-neutral-600">{{ 'widget.studio.no_areas'|trans }}</p>
        </twig:studio:card>
    {% else %}
        <p class="mb-4 text-fs-sm text-neutral-500">{{ 'widget.studio.intro'|trans }}</p>

        {% if areas|length > 1 %}
            <div class="mb-sp-md space-y-2">
                {% for module, group in areaGroups %}
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="w-24 shrink-0 text-fs-xs font-semibold uppercase tracking-wide text-neutral-500">{{ module ?: ('widget.studio.general_areas'|trans) }}</span>
                        {% for id, other in group %}
                            <a href="{{ path('admin_widgets_index', {area: id}) }}"
                               class="btn btn-sm {{ id == area.id ? 'btn-primary' : 'btn-neutral' }}">{{ other.label|trans }}</a>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="flex flex-col gap-sp-md lg:flex-row lg:items-start">
            {# ---------------------------------------------------------------- the area's widgets #}
            <div class="min-w-0 space-y-sp-sm lg:w-[60%]">
                <twig:studio:card title="{{ area.label|trans }}">
                    {% if area.description %}
                        <p class="mb-sp-sm text-fs-xs text-neutral-500">{{ area.description|trans }}</p>
                    {% endif %}

                    <ul class="space-y-2" data-widget-list
                        data-area="{{ area.id }}"
                        data-reorder-url="{{ path('admin_widgets_reorder') }}"
                        data-token="{{ csrf_token('admin_widgets') }}">
                        {% for row in rows %}
                            {% set widget = row.widget %}
                            <li class="rounded-lg border border-neutral-200 bg-white {{ widget.active and not row.orphan ? '' : 'opacity-60' }}"
                                data-widget-id="{{ widget.id }}" draggable="true">
                                <div class="flex items-center gap-3 px-sp-sm py-2">
                                    <span class="cursor-grab select-none text-neutral-400" data-widget-handle title="{{ 'widget.studio.drag'|trans }}" aria-hidden="true">⠿</span>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-fs-sm font-medium text-neutral-900">
                                            {{ row.name ?: (row.type ? row.type.label|trans : widget.type) }}
                                        </p>
                                        <p class="truncate text-fs-xs text-neutral-500">
                                            {% if row.orphan %}
                                                {{ 'widget.studio.type_missing'|trans({type: widget.type}) }}
                                            {% else %}
                                                {{ row.type.label|trans }}
                                                {% if widget.locale %} · {{ localeNames[widget.locale]|default(widget.locale) }}{% endif %}
                                                {% if widget.pages is not empty %} · {{ widget.pages|map(p => ('widget.page.' ~ p)|trans)|join(', ') }}{% endif %}
                                                {% if widget.audience != 'all' %} · {{ ('widget.audience.' ~ widget.audience)|trans }}{% endif %}
                                                {% if widget.themes is not empty %} · {{ widget.themes|map(t => themeNames[t]|default(t))|join(', ') }}{% endif %}
                                                {% if widget.showFrom or widget.showUntil %} · {{ 'widget.studio.scheduled'|trans }}{% endif %}
                                                {% if widget.extraAreas is not empty %} · {{ 'widget.studio.also_in_short'|trans({count: widget.extraAreas|length}) }}{% endif %}
                                            {% endif %}
                                        </p>
                                    </div>
                                    {% if not widget.active %}<span class="badge badge-neutral">{{ 'widget.studio.off'|trans }}</span>{% endif %}
                                    <div class="flex shrink-0 items-center gap-1">
                                        {% if not row.orphan %}
                                            <a href="{{ path('admin_widgets_edit', {id: widget.id}) }}" class="btn btn-sm btn-neutral">{{ 'widget.studio.edit'|trans }}</a>
                                        {% endif %}
                                        <form method="post" action="{{ path('admin_widgets_toggle', {id: widget.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_widgets') }}">
                                            <button type="submit" class="btn btn-sm btn-neutral">{{ (widget.active ? 'widget.studio.turn_off' : 'widget.studio.turn_on')|trans }}</button>
                                        </form>
                                        {% if not row.orphan %}
                                            <form method="post" action="{{ path('admin_widgets_duplicate', {id: widget.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_widgets') }}">
                                                <button type="submit" class="btn btn-sm btn-neutral" title="{{ 'widget.studio.duplicate'|trans }}">⧉</button>
                                            </form>
                                        {% endif %}
                                        {% if not row.orphan and areas|length > 1 %}
                                            <details class="relative">
                                                <summary class="btn btn-sm btn-neutral cursor-pointer list-none" title="{{ 'widget.studio.copy_to'|trans }}">⇥</summary>
                                                <form method="post" action="{{ path('admin_widgets_copy', {id: widget.id}) }}" class="absolute right-0 z-10 mt-1 w-64 space-y-2 rounded-lg border border-neutral-200 bg-white p-sp-sm shadow-lg">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_widgets') }}">
                                                    <label class="form-label">{{ 'widget.studio.copy_to'|trans }}</label>
                                                    <select name="to" class="form-select">
                                                        {% for module, group in areaGroups %}
                                                            <optgroup label="{{ module ?: ('widget.studio.general_areas'|trans) }}">
                                                                {% for id, other in group %}{% if id != area.id %}<option value="{{ id }}">{{ other.label|trans }}</option>{% endif %}{% endfor %}
                                                            </optgroup>
                                                        {% endfor %}
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-primary">{{ 'widget.studio.copy'|trans }}</button>
                                                </form>
                                            </details>
                                        {% endif %}
                                        <form method="post" action="{{ path('admin_widgets_delete', {id: widget.id}) }}" data-confirm="{{ 'widget.studio.delete_confirm'|trans|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_widgets') }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'widget.studio.delete'|trans }}">✕</button>
                                        </form>
                                    </div>
                                </div>
                            </li>
                        {% else %}
                            <li class="rounded-lg border border-dashed border-neutral-300 px-sp-sm py-sp-md text-center text-fs-sm text-neutral-500">
                                {{ 'widget.studio.empty'|trans }}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if rows|length > 1 %}
                        <p class="mt-sp-xs text-fs-xs text-neutral-500">{{ 'widget.studio.drag_hint'|trans }}</p>
                    {% endif %}

                    {% if borrowed is not empty %}
                        <p class="mb-1 mt-sp-sm text-fs-xs font-semibold uppercase tracking-wide text-neutral-500">{{ 'widget.studio.borrowed_title'|trans }}</p>
                        <ul class="space-y-2">
                            {% for other in borrowed %}
                                <li class="flex items-center gap-3 rounded-lg border border-dashed border-neutral-300 bg-neutral-50 px-sp-sm py-2">
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-fs-sm text-neutral-800">{{ other.title ? other.title|trans : other.type }}</p>
                                        <p class="truncate text-fs-xs text-neutral-500">{{ 'widget.studio.borrowed_from'|trans({area: (areaLabels[other.area]|default(other.area))|trans}) }}</p>
                                    </div>
                                    <a href="{{ path('admin_widgets_edit', {id: other.id}) }}" class="btn btn-sm btn-neutral">{{ 'widget.studio.edit'|trans }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </twig:studio:card>

                {% if area.presets is not empty %}
                    <twig:studio:card title="{{ 'widget.studio.presets_title'|trans }}">
                        <p class="mb-sp-sm text-fs-xs text-neutral-500">{{ 'widget.studio.presets_help'|trans }}</p>
                        <div class="space-y-2">
                            {% for preset in area.presets %}
                                <form method="post" action="{{ path('admin_widgets_preset') }}" data-confirm="{{ 'widget.studio.preset_confirm'|trans|e('html_attr') }}"
                                      class="flex items-start justify-between gap-3 rounded-lg border border-neutral-200 px-sp-sm py-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_widgets') }}">
                                    <input type="hidden" name="area" value="{{ area.id }}">
                                    <input type="hidden" name="preset" value="{{ preset.id }}">
                                    <div class="min-w-0">
                                        <p class="text-fs-sm font-medium text-neutral-900">{{ preset.label|trans }}</p>
                                        <p class="text-fs-xs text-neutral-500">{{ preset.description|trans }}</p>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-neutral shrink-0">{{ 'widget.studio.preset_apply'|trans }}</button>
                                </form>
                            {% endfor %}
                        </div>
                    </twig:studio:card>
                {% endif %}
            </div>

            {# ---------------------------------------------------------------- the catalogue #}
            <div class="min-w-0 lg:w-[40%]">
                <twig:studio:card title="{{ 'widget.studio.add_title'|trans }}">
                    <input type="search" class="form-control mb-sp-sm" placeholder="{{ 'widget.studio.search'|trans }}" data-widget-search>
                    {% for groupKey, types in catalogue %}
                        <div class="mb-sp-sm" data-widget-group>
                            <p class="mb-1 text-fs-xs font-semibold uppercase tracking-wide text-neutral-500">{{ groupKey|trans }}</p>
                            <div class="space-y-1">
                                {% for type in types %}
                                    <form method="post" action="{{ path('admin_widgets_add') }}" data-widget-type
                                          data-search="{{ (type.label|trans ~ ' ' ~ type.description|trans)|lower|e('html_attr') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_widgets') }}">
                                        <input type="hidden" name="area" value="{{ area.id }}">
                                        <input type="hidden" name="type" value="{{ type.id }}">
                                        <button type="submit" class="flex w-full items-start gap-3 rounded-lg border border-neutral-200 px-sp-sm py-2 text-left hover:border-primary-500 hover:bg-primary-50">
                                            <twig:ux:icon name="{{ type.icon }}" class="mt-0.5 h-5 w-5 shrink-0 text-primary-600" />
                                            <span class="min-w-0">
                                                <span class="block text-fs-sm font-medium text-neutral-900">{{ type.label|trans }}</span>
                                                <span class="block text-fs-xs text-neutral-500">{{ type.description|trans }}</span>
                                            </span>
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <p class="text-fs-sm text-neutral-500">{{ 'widget.studio.no_types'|trans }}</p>
                    {% endfor %}
                </twig:studio:card>
            </div>
        </div>
    {% endif %}
{% endblock %}
