{% extends 'admin/layout.html.twig' %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'importer-admin']) }}
{% endblock %}

{% block header %}{{ 'importer.system.header'|trans({'system': system.label}) }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_import_index') }}" class="btn btn-sm btn-neutral">{{ 'importer.system.back'|trans }}</a>
{% endblock %}

{% block body %}
    {% if error is defined and error %}
        <div class="mb-sp-sm rounded-lg border border-danger-300 bg-danger-50 px-sp-sm py-3 text-fs-sm text-danger-700">
            {{ error }}
        </div>
    {% endif %}

    <div class="grid gap-sp-sm lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="space-y-sp-sm">
            <twig:studio:card title="{{ 'importer.upload.title'|trans }}" padded="{{ true }}">
                <p class="text-fs-sm text-neutral-600">{{ 'importer.upload.help'|trans }}</p>

                <form method="post"
                      action="{{ path('admin_import_upload', {system: system.id}) }}"
                      enctype="multipart/form-data"
                      class="mt-sp-xs flex flex-wrap items-center gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <input type="file" name="export" required
                           accept=".xml,.csv,.zip,.json,.txt,.sql,.gz,.sql.gz"
                           class="input max-w-md flex-1">
                    <button type="submit" class="btn btn-sm btn-neutral">{{ 'importer.upload.submit'|trans }}</button>
                </form>

                <p class="mt-2 text-fs-xs text-neutral-500">{{ 'importer.upload.privacy'|trans }}</p>

                {% if uploads is not empty %}
                    <ul class="mt-sp-sm divide-y divide-neutral-200 border-t border-neutral-200">
                        {% for upload in uploads %}
                            <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-fs-sm text-neutral-800">{{ upload.originalName }}</span>
                                    <span class="block text-fs-xs text-neutral-500">
                                        {{ upload.isDirectory ? 'importer.upload.kind_directory'|trans : 'importer.upload.kind_file'|trans }}
                                        · {{ (upload.size / 1024)|round }} KB
                                        · {{ upload.uploadedAt|date('Y-m-d H:i') }}
                                    </span>
                                </span>
                                <form method="post"
                                      action="{{ path('admin_import_upload_delete', {system: system.id, id: upload.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                                    <button type="submit" class="btn btn-sm btn-neutral">{{ 'importer.upload.delete'|trans }}</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </twig:studio:card>

            <twig:studio:card title="{{ 'importer.system.settings'|trans }}" padded="{{ true }}">
                {% set optionNames = options|map(o => o.name) %}
                {% set hasXmlSource = 'file' in optionNames and 'sqlDump' in optionNames %}
                {% set hasDumpSource = 'sqlDump' in optionNames %}
                {% set hasRemoteSource = 'dbHost' in optionNames %}
                {% set xmlUploads = uploads|filter(u => not u.isDirectory and u.originalName matches '/\\.(xml|wxr)$/i') %}
                {% set sqlUploads = uploads|filter(u => not u.isDirectory and u.originalName matches '/\\.sql(\\.[gG][zZ])?$/i') %}
                {% set guessedKind = sourceKind|default('') %}
                {% if guessedKind == '' and hasXmlSource %}
                    {% if values.sqlDump|default('') != '' or values.dbName|default('') != '' or (values.file|default('') matches '/\\.sql/i') or (sqlUploads is not empty and xmlUploads is empty) %}
                        {% set guessedKind = 'sql' %}
                    {% else %}
                        {% set guessedKind = 'xml' %}
                    {% endif %}
                {% elseif guessedKind == '' and hasDumpSource and hasRemoteSource %}
                    {% set guessedKind = values.dbName|default('') != '' and values.sqlDump|default('') == '' ? 'remote' : 'dump' %}
                {% endif %}

                <form method="post" action="{{ path('admin_import_run', {system: system.id}) }}" class="space-y-sp-sm" data-import-source>
                    <input type="hidden" name="_token" value="{{ csrf_token }}">

                    {% if hasXmlSource %}
                        <fieldset class="rounded-lg border border-neutral-200 p-sp-sm">
                            <legend class="px-1 text-fs-sm font-medium text-neutral-800">{{ 'importer.mode.title'|trans }}</legend>
                            <p class="mb-2 text-fs-xs text-neutral-500">{{ 'importer.mode.help_xml'|trans }}</p>
                            <label class="flex items-start gap-2 text-fs-sm text-neutral-800">
                                <input type="radio" name="sourceKind" value="xml" class="mt-0.5" {{ guessedKind != 'sql' ? 'checked' : '' }}>
                                <span>
                                    <span class="font-medium">{{ 'importer.mode.xml'|trans }}</span>
                                    <span class="block text-fs-xs text-neutral-500">{{ 'importer.mode.xml_help'|trans }}</span>
                                </span>
                            </label>
                            <label class="mt-2 flex items-start gap-2 text-fs-sm text-neutral-800">
                                <input type="radio" name="sourceKind" value="sql" class="mt-0.5" {{ guessedKind == 'sql' ? 'checked' : '' }}>
                                <span>
                                    <span class="font-medium">{{ 'importer.mode.sql'|trans }}</span>
                                    <span class="block text-fs-xs text-neutral-500">{{ 'importer.mode.sql_help'|trans }}</span>
                                </span>
                            </label>
                        </fieldset>
                    {% elseif hasDumpSource and hasRemoteSource %}
                        <fieldset class="rounded-lg border border-neutral-200 p-sp-sm">
                            <legend class="px-1 text-fs-sm font-medium text-neutral-800">{{ 'importer.mode.title'|trans }}</legend>
                            <p class="mb-2 text-fs-xs text-neutral-500">{{ 'importer.mode.help_sql'|trans }}</p>
                            <label class="flex items-start gap-2 text-fs-sm text-neutral-800">
                                <input type="radio" name="sourceKind" value="dump" class="mt-0.5" {{ guessedKind != 'remote' ? 'checked' : '' }}>
                                <span>
                                    <span class="font-medium">{{ 'importer.mode.dump'|trans }}</span>
                                    <span class="block text-fs-xs text-neutral-500">{{ 'importer.mode.dump_help'|trans }}</span>
                                </span>
                            </label>
                            <label class="mt-2 flex items-start gap-2 text-fs-sm text-neutral-800">
                                <input type="radio" name="sourceKind" value="remote" class="mt-0.5" {{ guessedKind == 'remote' ? 'checked' : '' }}>
                                <span>
                                    <span class="font-medium">{{ 'importer.mode.remote'|trans }}</span>
                                    <span class="block text-fs-xs text-neutral-500">{{ 'importer.mode.remote_help'|trans }}</span>
                                </span>
                            </label>
                        </fieldset>
                    {% endif %}

                    {% set saved = saved|default({}) %}
                    {% for option in options %}
                        {% set current = values[option.name]|default(option.default ?? '') %}
                        {% set hasSaved = saved[option.name] is defined and saved[option.name] != '' %}
                        {# Uploads that can satisfy this field: a file option
                           offers files, a directory option offers unpacked
                           archives. Matching on the declared kind rather than
                           on the option's name means a module that names one
                           differently still gets the right picker. #}
                        {% set choices = option.kind == 'directory'
                            ? uploads|filter(u => u.isDirectory)
                            : (option.kind == 'file' ? uploads|filter(u => not u.isDirectory) : []) %}
                        {% if option.name == 'file' and xmlUploads is not empty %}
                            {% set choices = xmlUploads %}
                        {% elseif option.name == 'sqlDump' and sqlUploads is not empty %}
                            {% set choices = sqlUploads %}
                        {% endif %}
                        {% set groups = '' %}
                        {% if option.name == 'file' and hasXmlSource %}
                            {% set groups = 'xml' %}
                        {% elseif option.name == 'sqlDump' %}
                            {% set groups = hasXmlSource ? 'sql' : 'dump' %}
                        {% elseif option.name in ['dbHost', 'dbName', 'dbUser', 'dbPassword'] %}
                            {% set groups = hasXmlSource ? 'sql' : 'remote' %}
                        {% elseif option.name == 'prefix' and (hasXmlSource or (hasDumpSource and hasRemoteSource)) %}
                            {% set groups = hasXmlSource ? 'sql' : 'dump,remote' %}
                        {% endif %}
                        {% set optionLabelKey = 'importer.option.' ~ option.name %}
                        {% set optionLabel = optionLabelKey|trans %}

                        <div data-import-field{% if groups != '' %} data-import-groups="{{ groups }}"{% endif %}>
                            <label for="opt-{{ option.name }}" class="block text-fs-sm font-medium text-neutral-800">
                                {{ optionLabel != optionLabelKey ? optionLabel : option.name }}
                                {% if option.required %}<span class="text-danger-600">*</span>{% endif %}
                            </label>

                            {% if choices is not empty %}
                                <select data-import-picker="opt-{{ option.name }}" class="input mt-1 w-full">
                                    <option value="">{{ 'importer.upload.pick'|trans }}</option>
                                    {% for upload in choices %}
                                        <option value="{{ upload.path }}" {{ current == upload.path ? 'selected' : '' }}>
                                            {{ upload.originalName }}
                                        </option>
                                    {% endfor %}
                                </select>
                            {% endif %}

                            <input type="{{ option.isSecret ? 'password' : 'text' }}"
                                   id="opt-{{ option.name }}"
                                   name="options[{{ option.name }}]"
                                   {# A secret is never rendered back into the page; it is
                                      retyped rather than shown in a screenshot. #}
                                   value="{{ option.isSecret ? '' : current }}"
                                   {% if option.required and not hasSaved %}required{% endif %}
                                   placeholder="{{ option.isSecret and hasSaved ? 'importer.source.saved_secret'|trans : (option.default ?? '') }}"
                                   autocomplete="off"
                                   class="input mt-1 w-full">
                            <p class="mt-1 text-fs-xs text-neutral-500">
                                {{ option.description }}
                                {% if hasSaved %}
                                    <span class="block">{{ 'importer.source.remembered'|trans }}</span>
                                {% endif %}
                            </p>
                        </div>
                    {% endfor %}

                    {% if migrations|length > 1 %}
                        <fieldset data-import-steps class="rounded-lg border border-neutral-200 p-sp-sm">
                            <legend class="px-1 text-fs-sm font-medium text-neutral-800">{{ 'importer.steps.title'|trans }}</legend>
                            <p class="mb-2 text-fs-xs text-neutral-500">{{ 'importer.steps.help'|trans }}</p>
                            <input type="hidden" name="steps_present" value="1">
                            {% set selectedSteps = selectedSteps|default([]) %}
                            {% set allSteps = selectedSteps is empty %}
                            {% for migration in migrations %}
                                {% set labelKey = 'importer.migration.' ~ migration.id|replace({'.': '_'}) %}
                                {% set label = labelKey|trans %}
                                <label class="mt-1 flex items-start gap-2 text-fs-sm text-neutral-800">
                                    <input type="checkbox"
                                           name="steps[]"
                                           value="{{ migration.id }}"
                                           class="mt-0.5"
                                           data-depends-on="{{ migration.dependsOn|default([])|join(',') }}"
                                           {{ allSteps or migration.id in selectedSteps ? 'checked' : '' }}>
                                    <span>
                                        <span class="font-medium">{{ label != labelKey ? label : migration.label }}</span>
                                        {% if migration.imported > 0 %}
                                            <span class="block text-fs-xs text-neutral-500">{{ 'importer.index.already'|trans({'count': migration.imported}) }}</span>
                                        {% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </fieldset>
                    {% endif %}

                    <div>
                        <label for="limit" class="block text-fs-sm font-medium text-neutral-800">
                            {{ 'importer.system.limit'|trans }}
                        </label>
                        <input type="number" id="limit" name="limit" min="1" max="{{ maxLimit|default(100000) }}"
                               value="{{ unlimited|default(false) ? defaultLimit : (limit|default(defaultLimit)) }}"
                               class="input mt-1 w-40"
                               {% if unlimited|default(false) %}disabled{% endif %}>
                        <label class="mt-2 flex items-center gap-2 text-fs-sm text-neutral-700">
                            <input type="checkbox" name="unlimited" value="1" {{ unlimited|default(false) ? 'checked' : '' }}>
                            {{ 'importer.system.unlimited'|trans }}
                        </label>
                        <p class="mt-1 text-fs-xs text-neutral-500">{{ 'importer.system.limit_help'|trans }}</p>
                    </div>

                    <div class="flex flex-wrap gap-2 border-t border-neutral-200 pt-sp-sm">
                        {# Dry run is the plain submit; writing is a separate,
                           deliberately named button. #}
                        <button type="submit" name="mode" value="dry" class="btn btn-sm btn-primary">
                            {{ 'importer.system.dry_run'|trans }}
                        </button>
                        <button type="submit" name="mode" value="apply" class="btn btn-sm btn-danger">
                            {{ 'importer.system.apply'|trans }}
                        </button>
                    </div>
                </form>
            </twig:studio:card>

            {% if reports is not null and reports is not empty %}
                <twig:studio:card
                    title="{{ applied ? 'importer.report.applied'|trans : 'importer.report.dry_run'|trans }}"
                    variant="{{ applied ? 'default' : 'default' }}"
                    padded="{{ false }}">
                    <twig:studio:table headers="{{ [
                        'importer.report.migration'|trans,
                        'importer.report.processed'|trans,
                        'importer.report.created'|trans,
                        'importer.report.updated'|trans,
                        'importer.report.unchanged'|trans,
                        'importer.report.skipped'|trans,
                        'importer.report.failed'|trans,
                    ] }}">
                        <twig:block name="rows">
                            {% for report in reports %}
                                <tr>
                                    <td class="font-mono text-fs-xs">{{ report.migrationId }}</td>
                                    <td>{{ report.processed }}</td>
                                    <td>{{ report.created }}</td>
                                    <td>{{ report.updated }}</td>
                                    <td>{{ report.unchanged }}</td>
                                    <td>{{ report.skipped }}</td>
                                    <td class="{{ report.failed > 0 ? 'font-semibold text-danger-600' : '' }}">{{ report.failed }}</td>
                                </tr>
                            {% endfor %}
                        </twig:block>
                    </twig:studio:table>
                </twig:studio:card>

                {% if reports|filter(report => report.limitReached)|length > 0 %}
                    <div class="rounded-lg border border-warning-300 bg-warning-50 px-sp-sm py-3 text-fs-sm text-warning-800">
                        {{ 'importer.report.limit_reached'|trans }}
                    </div>
                {% endif %}

                {% if not applied %}
                    <div class="rounded-lg border border-neutral-200 bg-neutral-50 px-sp-sm py-3 text-fs-sm text-neutral-600">
                        {{ 'importer.report.nothing_written'|trans }}
                        {% if reports|filter(report => report.skipped > 0)|length > 0 %}
                            <span class="block mt-1">{{ 'importer.report.dependent_note'|trans }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {% for report in reports|filter(report => report.failures is not empty) %}
                    <twig:studio:card title="{{ 'importer.report.failures'|trans({'migration': report.migrationId}) }}" variant="danger" padded="{{ true }}">
                        <ul class="space-y-1 text-fs-sm text-neutral-700">
                            {% for failure in report.failures|slice(0, 25) %}
                                <li>
                                    <span class="font-mono text-fs-xs text-neutral-500">{{ failure.sourceId }}</span>
                                    — {{ failure.message }}
                                </li>
                            {% endfor %}
                        </ul>
                        {% if report.failures|length > 25 %}
                            <p class="mt-2 text-fs-xs text-neutral-500">
                                {{ 'importer.report.more_failures'|trans({'count': report.failures|length - 25}) }}
                            </p>
                        {% endif %}
                    </twig:studio:card>
                {% endfor %}
            {% endif %}
        </div>

        <div class="space-y-sp-sm">
            <twig:studio:card title="{{ 'importer.system.steps'|trans }}" padded="{{ true }}">
                <ol class="space-y-2 text-fs-sm text-neutral-700">
                    {% for migration in migrations %}
                        {# Same fallback the cron and hook screens use: a
                           translated label when the module ships one, the
                           migration's own label when it does not, so a module
                           that adds a source is never rendered as a raw key. #}
                        {% set labelKey = 'importer.migration.' ~ migration.id|replace({'.': '_'}) %}
                        {% set label = labelKey|trans %}
                        <li class="flex items-baseline justify-between gap-2">
                            <span>{{ label != labelKey ? label : migration.label }}</span>
                            <span class="shrink-0 text-fs-xs text-neutral-500">{{ migration.imported }}</span>
                        </li>
                    {% endfor %}
                </ol>
                <p class="mt-sp-xs text-fs-xs text-neutral-500">{{ 'importer.system.steps_help'|trans }}</p>

                {% if migrations|filter(m => m.imported > 0)|length > 0 %}
                    <form method="post" action="{{ path('admin_import_run', {system: system.id}) }}"
                          class="mt-sp-sm border-t border-neutral-200 pt-sp-sm"
                          onsubmit="return confirm('{{ 'importer.system.rollback_confirm'|trans|e('js') }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <input type="hidden" name="mode" value="rollback">
                        <button type="submit" class="btn btn-sm btn-danger">{{ 'importer.system.rollback'|trans }}</button>
                        <p class="mt-2 text-fs-xs text-neutral-500">{{ 'importer.system.rollback_help'|trans }}</p>
                    </form>
                {% endif %}
            </twig:studio:card>

            {% if saved is defined and saved is not empty %}
                <twig:studio:card title="{{ 'importer.source.title'|trans }}" padded="{{ true }}">
                    <p class="text-fs-xs text-neutral-500">{{ 'importer.source.help'|trans }}</p>
                    <form method="post" action="{{ path('admin_import_source_forget', {system: system.id}) }}" class="mt-2">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <button type="submit" class="btn btn-sm btn-neutral">{{ 'importer.source.forget'|trans }}</button>
                    </form>
                </twig:studio:card>
            {% endif %}

            {% if command is defined and command %}
                <twig:studio:card title="{{ 'importer.system.cli'|trans }}" padded="{{ true }}">
                    <p class="text-fs-xs text-neutral-500">{{ 'importer.system.cli_help'|trans }}</p>
                    <pre class="mt-2 overflow-x-auto rounded-lg bg-neutral-900 p-3 text-fs-xs text-neutral-100"><code>{{ command }}</code></pre>
                </twig:studio:card>
            {% endif %}

            <twig:studio:card title="{{ 'importer.system.notes'|trans }}" padded="{{ true }}">
                <ul class="space-y-2 text-fs-xs text-neutral-600">
                    <li>{{ 'importer.notice.passwords_not_imported'|trans }}</li>
                    <li>{{ 'importer.notice.drafts_by_default'|trans }}</li>
                    <li>{{ 'importer.notice.rerun_safe'|trans }}</li>
                </ul>
            </twig:studio:card>
        </div>
    </div>
{% endblock %}
