{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.forum.settings.index.header'|trans }}{% endblock %}

{% block body %}
    {% include '@ForumModule/admin/_desk_nav.html.twig' %}

    {% for groupKey, cards in groups %}
        <h2 class="mb-sp-sm mt-sp-lg text-fs-sm font-semibold uppercase tracking-wide text-neutral-500 first:mt-0">
            {{ groupKey|trans }}
        </h2>

        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {% for card in cards %}
                <a href="{{ path(card.route) }}"
                   class="group flex items-start gap-3 rounded-lg border border-neutral-200 p-4 transition hover:border-primary-400 hover:bg-neutral-50">
                    <span class="mt-0.5 shrink-0 text-primary-600">
                        <twig:ux:icon name="{{ card.icon }}" class="h-6 w-6" />
                    </span>

                    <span class="min-w-0 flex-1">
                        <span class="block font-medium text-neutral-900">{{ card.label|trans }}</span>
                        <span class="mt-0.5 block text-fs-xs text-neutral-500">{{ card.description|trans }}</span>
                    </span>

                    <span class="shrink-0 text-neutral-300 group-hover:text-primary-500">
                        <twig:ux:icon name="heroicons:chevron-right" class="h-5 w-5" />
                    </span>
                </a>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
