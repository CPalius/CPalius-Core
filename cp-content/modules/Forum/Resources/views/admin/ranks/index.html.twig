{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.forum.ranks.index.header'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_forum_dashboard') }}" class="btn btn-sm btn-neutral">{{ 'studio.forum.ranks.index.action.dashboard'|trans }}</a>
    <a href="{{ path('admin_forum_members_index') }}" class="btn btn-sm btn-neutral">{{ 'studio.forum.dashboard.action.members'|trans }}</a>
    <a href="{{ path('admin_forum_ranks_create') }}" class="btn btn-sm btn-primary">{{ 'studio.forum.ranks.index.action.new'|trans }}</a>
{% endblock %}

{% block body %}
    <twig:studio:card padded="{{ false }}">
        <twig:studio:table headers="{{ [
            'studio.forum.ranks.index.column.rank'|trans,
            'studio.forum.ranks.index.column.assignment'|trans,
            'studio.forum.ranks.index.column.sort_order'|trans,
            '',
        ] }}" empty="{{ ranks is empty }}" emptyText="{{ 'studio.forum.ranks.index.empty'|trans }}">
            <twig:block name="rows">
                {% for rank in ranks %}
                    <tr>
                        <td>
                            <span style="display:inline-flex; align-items:center; gap:6px; padding:2px 8px; border-radius:3px; font-size:11px; font-weight:700; color:#fff; background:{{ rank.color }};">
                                {% if rank.icon %}<i class="bi {{ rank.icon }}"></i>{% endif %} {{ rank.label }}
                            </span>
                        </td>
                        <td>
                            {% if rank.automatic %}
                                <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.ranks.index.automatic'|trans({minPosts: rank.minPosts}) }}</span>
                            {% else %}
                                <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.ranks.index.manual'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ rank.sortOrder }}</td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="{{ path('admin_forum_ranks_edit', {id: rank.id}) }}" class="btn btn-sm btn-neutral">{{ 'aacp.users.edit_action'|trans }}</a>
                                <form method="post" action="{{ path('admin_forum_ranks_delete', {id: rank.id}) }}" onsubmit="return confirm({{ 'studio.forum.ranks.index.delete_confirm'|trans|json_encode|raw }});">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_forum_rank') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'aacp.cron.delete'|trans }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </twig:block>
        </twig:studio:table>
    </twig:studio:card>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <twig:studio:card title="{{ 'studio.forum.ranks.ban.form_header'|trans({}, 'forums') }}">
            <form method="post" action="{{ path('admin_forum_ranks_ban') }}" class="grid gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_forum_rank') }}">
                <div>
                    <label class="form-label">{{ 'studio.forum.ranks.ban.user_id'|trans({}, 'forums') }}</label>
                    <input type="number" name="user_id" class="form-control" required min="1">
                </div>
                <div>
                    <label class="form-label">{{ 'studio.forum.ranks.ban.type'|trans({}, 'forums') }}</label>
                    <select name="type" class="form-select">
                        <option value="mute">{{ 'studio.forum.ranks.ban.type_mute'|trans({}, 'forums') }}</option>
                        <option value="ban">{{ 'studio.forum.ranks.ban.type_ban'|trans({}, 'forums') }}</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">{{ 'studio.forum.ranks.ban.duration'|trans({}, 'forums') }}</label>
                    <input type="number" name="duration_days" class="form-control" min="0" placeholder="0 = kalıcı">
                </div>
                <div>
                    <label class="form-label">{{ 'studio.forum.ranks.ban.reason'|trans({}, 'forums') }}</label>
                    <textarea name="reason" class="form-control" rows="2" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">{{ 'studio.forum.ranks.ban.submit'|trans({}, 'forums') }}</button>
            </form>
        </twig:studio:card>

        <twig:studio:card title="{{ 'studio.forum.ranks.ban.active_header'|trans({}, 'forums') }}" padded="{{ false }}">
            <twig:studio:table headers="{{ [
                'studio.forum.ranks.ban.col.member'|trans({}, 'forums'),
                'studio.forum.ranks.ban.col.type'|trans({}, 'forums'),
                'studio.forum.ranks.ban.col.reason'|trans({}, 'forums'),
                '',
            ] }}" empty="{{ activeBans is empty }}" emptyText="{{ 'studio.forum.ranks.ban.empty'|trans({}, 'forums') }}">
                <twig:block name="rows">
                    {% for ban in activeBans %}
                        <tr>
                            <td>{{ ban.user.fullName }} <span class="text-fs-xs text-neutral-500">#{{ ban.user.id }}</span></td>
                            <td class="text-fs-xs">
                                {% if ban.ban %}
                                    {{ 'studio.forum.ranks.ban.type_ban'|trans({}, 'forums') }}
                                {% else %}
                                    {{ 'studio.forum.ranks.ban.type_mute'|trans({}, 'forums') }}
                                {% endif %}
                            </td>
                            <td class="text-fs-sm">{{ ban.reason }}</td>
                            <td class="text-right">
                                <form method="post" action="{{ path('admin_forum_ranks_revoke_ban', {banId: ban.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_forum_rank') }}">
                                    <button type="submit" class="btn btn-sm btn-neutral">{{ 'studio.forum.ranks.ban.revoke'|trans({}, 'forums') }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:studio:table>
        </twig:studio:card>
    </div>
{% endblock %}
