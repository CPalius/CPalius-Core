<div class="mb-6">
    <div class="flex flex-wrap gap-1 border-b border-neutral-200 pb-2" role="tablist">
        {% for tab in forum_studio_desk_tabs() %}
            <a href="{{ path(tab.route) }}"
               class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-fs-sm font-medium transition-colors {{ tab.active ? 'bg-primary-50 text-primary-700' : 'text-neutral-500 hover:bg-neutral-100 hover:text-neutral-800' }}">
                <twig:ux:icon name="{{ tab.icon }}" class="h-4 w-4 shrink-0" />
                {{ tab.label|trans }}
            </a>
        {% endfor %}
    </div>
    {% set deskRoute = app.request.attributes.get('_route') %}
    <div class="mt-3 flex flex-wrap gap-2">
        {% if deskRoute starts with 'admin_forum_dashboard' or deskRoute starts with 'admin_forum_topics' %}
            <a href="{{ path('admin_forum_dashboard') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_dashboard' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.overview'|trans }}</a>
            <a href="{{ path('admin_forum_topics_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_topics' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.topics'|trans }}</a>
        {% elseif deskRoute starts with 'admin_forum_sections' or deskRoute starts with 'admin_forum_prefixes' or deskRoute starts with 'admin_forum_announcements' %}
            <a href="{{ path('admin_forum_sections_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_sections' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.sections'|trans }}</a>
            <a href="{{ path('admin_forum_prefixes_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_prefixes' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.prefixes'|trans }}</a>
            <a href="{{ path('admin_forum_announcements_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_announcements' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.announcements'|trans }}</a>
        {% elseif deskRoute starts with 'admin_forum_permissions' or deskRoute starts with 'admin_forum_moderators' %}
            <a href="{{ path('admin_forum_permissions_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_permissions' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.permissions'|trans }}</a>
            <a href="{{ path('admin_forum_moderators_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_moderators' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.moderators'|trans }}</a>
        {% elseif deskRoute starts with 'admin_forum_moderation' or deskRoute starts with 'admin_forum_filters' %}
            <a href="{{ path('admin_forum_moderation_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_moderation' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.moderation'|trans }}</a>
            <a href="{{ path('admin_forum_filters_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_filters' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.filters'|trans }}</a>
        {% elseif deskRoute starts with 'admin_forum_members' or deskRoute starts with 'admin_forum_ranks' %}
            <a href="{{ path('admin_forum_members_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_members' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.members'|trans }}</a>
            <a href="{{ path('admin_forum_ranks_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_ranks' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.ranks'|trans }}</a>
        {% elseif deskRoute starts with 'admin_forum_settings' or deskRoute starts with 'admin_forum_postbit' or deskRoute starts with 'admin_forum_stats' %}
            <a href="{{ path('admin_forum_settings_index') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_index' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.hub'|trans }}</a>
            <a href="{{ path('admin_forum_settings_home') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_home' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.home'|trans }}</a>
            <a href="{{ path('admin_forum_settings_activity') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_activity' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.activity'|trans }}</a>
            <a href="{{ path('admin_forum_settings_engine') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_engine' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.engine'|trans }}</a>
            <a href="{{ path('admin_forum_settings_antibump') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_antibump' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.antibump'|trans }}</a>
            <a href="{{ path('admin_forum_settings_member') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_member' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.member_prefs'|trans }}</a>
            <a href="{{ path('admin_forum_settings_warnings') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_warnings' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.warnings'|trans }}</a>
            <a href="{{ path('admin_forum_settings_reputation') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_reputation' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.reputation'|trans }}</a>
            <a href="{{ path('admin_forum_settings_notifications') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_notifications' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.notifications'|trans }}</a>
            <a href="{{ path('admin_forum_postbit_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_postbit' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.postbit'|trans }}</a>
            <a href="{{ path('admin_forum_settings_censor') }}" class="btn btn-sm {{ deskRoute == 'admin_forum_settings_censor' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.censor'|trans }}</a>
            <a href="{{ path('admin_forum_stats_index') }}" class="btn btn-sm {{ deskRoute starts with 'admin_forum_stats' ? 'btn-primary' : 'btn-neutral' }}">{{ 'studio.forum.desk.sub.stats'|trans }}</a>
        {% endif %}
    </div>
</div>
