{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.forum.dashboard.header'|trans }}{% endblock %}

{% block body %}
    {% include '@ForumModule/admin/_desk_nav.html.twig' %}

    <div class="mb-6 grid gap-3 md:grid-cols-3">
        <a href="{{ path('admin_forum_moderation_index') }}" class="flex items-center justify-between gap-3 rounded-lg border px-4 py-3 transition {{ heldCount > 0 ? 'border-amber-300 bg-amber-50 hover:border-amber-400' : 'border-neutral-200 hover:border-neutral-300' }}">
            <span>
                <span class="block text-fs-xs font-medium uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.attention.held'|trans }}</span>
                <span class="mt-1 block text-xl font-semibold {{ heldCount > 0 ? 'text-amber-700' : 'text-neutral-900' }}">{{ heldCount }}</span>
            </span>
            <twig:ux:icon name="heroicons:clock" class="h-6 w-6 shrink-0 {{ heldCount > 0 ? 'text-amber-500' : 'text-neutral-300' }}" />
        </a>
        <a href="{{ path('admin_forum_moderation_index') }}" class="flex items-center justify-between gap-3 rounded-lg border px-4 py-3 transition {{ openReportCount > 0 ? 'border-red-300 bg-red-50 hover:border-red-400' : 'border-neutral-200 hover:border-neutral-300' }}">
            <span>
                <span class="block text-fs-xs font-medium uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.attention.reports'|trans }}</span>
                <span class="mt-1 block text-xl font-semibold {{ openReportCount > 0 ? 'text-red-700' : 'text-neutral-900' }}">{{ openReportCount }}</span>
            </span>
            <twig:ux:icon name="heroicons:flag" class="h-6 w-6 shrink-0 {{ openReportCount > 0 ? 'text-red-500' : 'text-neutral-300' }}" />
        </a>
        <a href="{{ path('admin_forum_members_index') }}" class="flex items-center justify-between gap-3 rounded-lg border px-4 py-3 transition {{ activeBanCount > 0 ? 'border-neutral-800 bg-neutral-900 text-white hover:border-neutral-700' : 'border-neutral-200 hover:border-neutral-300' }}">
            <span>
                <span class="block text-fs-xs font-medium uppercase tracking-wide {{ activeBanCount > 0 ? 'text-neutral-300' : 'text-neutral-500' }}">{{ 'studio.forum.dashboard.attention.bans'|trans }}</span>
                <span class="mt-1 block text-xl font-semibold">{{ activeBanCount }}</span>
            </span>
            <twig:ux:icon name="heroicons:no-symbol" class="h-6 w-6 shrink-0 {{ activeBanCount > 0 ? 'text-neutral-400' : 'text-neutral-300' }}" />
        </a>
    </div>

    <twig:studio:card title="{{ 'studio.forum.dashboard.health.header'|trans }}">
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div>
                <p class="text-fs-xs uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.stat.total_topics'|trans }}</p>
                <p class="mt-1 text-2xl font-semibold">{{ topicCount }}</p>
            </div>
            <div>
                <p class="text-fs-xs uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.stat.total_posts'|trans }}</p>
                <p class="mt-1 text-2xl font-semibold">{{ postCount }}</p>
            </div>
            <div>
                <p class="text-fs-xs uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.stat.section_count'|trans }}</p>
                <p class="mt-1 text-2xl font-semibold">{{ sectionCount }}</p>
            </div>
            <div>
                <p class="text-fs-xs uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.health.last_post'|trans }}</p>
                {% if lastPostAt %}
                    <p class="mt-1 text-fs-sm font-medium text-neutral-900">{{ lastPosterName|default('studio.forum.dashboard.health.anonymous'|trans) }}</p>
                    <p class="text-fs-xs text-neutral-500">{{ lastPostAt|date('d.m.Y H:i') }}</p>
                {% else %}
                    <p class="mt-1 text-fs-sm text-neutral-500">{{ 'studio.forum.dashboard.health.no_activity'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </twig:studio:card>

    <h2 class="mb-3 mt-8 text-fs-sm font-semibold uppercase tracking-wide text-neutral-500">{{ 'studio.forum.dashboard.shortcuts.header'|trans }}</h2>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
        <a href="{{ path('admin_forum_sections_index') }}" class="group flex flex-col gap-2 rounded-lg border border-neutral-200 p-4 transition hover:border-primary-400 hover:bg-neutral-50">
            <twig:ux:icon name="heroicons:rectangle-group" class="h-6 w-6 text-primary-600" />
            <span class="font-medium text-neutral-900">{{ 'studio.forum.dashboard.shortcut.structure'|trans }}</span>
            <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.dashboard.shortcut.structure_desc'|trans }}</span>
        </a>
        <a href="{{ path('admin_forum_permissions_index') }}" class="group flex flex-col gap-2 rounded-lg border border-neutral-200 p-4 transition hover:border-primary-400 hover:bg-neutral-50">
            <twig:ux:icon name="heroicons:key" class="h-6 w-6 text-primary-600" />
            <span class="font-medium text-neutral-900">{{ 'studio.forum.dashboard.shortcut.permissions'|trans }}</span>
            <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.dashboard.shortcut.permissions_desc'|trans }}</span>
        </a>
        <a href="{{ path('admin_forum_moderation_index') }}" class="group flex flex-col gap-2 rounded-lg border border-neutral-200 p-4 transition hover:border-primary-400 hover:bg-neutral-50">
            <twig:ux:icon name="heroicons:shield-check" class="h-6 w-6 text-primary-600" />
            <span class="font-medium text-neutral-900">{{ 'studio.forum.dashboard.shortcut.moderation'|trans }}</span>
            <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.dashboard.shortcut.moderation_desc'|trans }}</span>
        </a>
        <a href="{{ path('admin_forum_members_index') }}" class="group flex flex-col gap-2 rounded-lg border border-neutral-200 p-4 transition hover:border-primary-400 hover:bg-neutral-50">
            <twig:ux:icon name="heroicons:users" class="h-6 w-6 text-primary-600" />
            <span class="font-medium text-neutral-900">{{ 'studio.forum.dashboard.shortcut.people'|trans }}</span>
            <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.dashboard.shortcut.people_desc'|trans }}</span>
        </a>
        <a href="{{ path('admin_forum_settings_index') }}" class="group flex flex-col gap-2 rounded-lg border border-neutral-200 p-4 transition hover:border-primary-400 hover:bg-neutral-50">
            <twig:ux:icon name="heroicons:cog-6-tooth" class="h-6 w-6 text-primary-600" />
            <span class="font-medium text-neutral-900">{{ 'studio.forum.dashboard.shortcut.settings'|trans }}</span>
            <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.dashboard.shortcut.settings_desc'|trans }}</span>
        </a>
    </div>
{% endblock %}
