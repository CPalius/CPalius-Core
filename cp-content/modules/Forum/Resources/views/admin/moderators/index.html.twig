{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.forum.moderators.index.header'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_forum_dashboard') }}" class="btn btn-sm btn-neutral">{{ 'studio.forum.moderators.action.dashboard'|trans }}</a>
    <a href="{{ path('admin_forum_moderators_create') }}" class="btn btn-sm btn-primary">{{ 'studio.forum.moderators.index.action.new'|trans }}</a>
{% endblock %}

{% block body %}
    {% include '@ForumModule/admin/_desk_nav.html.twig' %}
    <twig:studio:card padded="{{ false }}">
        <twig:studio:table headers="{{ [
            'studio.forum.moderators.index.column.section'|trans,
            'studio.forum.moderators.index.column.subject'|trans,
            'studio.forum.moderators.index.column.type'|trans,
            'studio.forum.moderators.index.column.inherit'|trans,
            'studio.forum.moderators.index.column.grants'|trans,
            '',
        ] }}" empty="{{ moderators is empty }}" emptyText="{{ 'studio.forum.moderators.index.empty'|trans }}">
            <twig:block name="rows">
                {% for row in moderators %}
                    <tr>
                        <td>{{ row.section.title }}</td>
                        <td>{{ subjectLabels[row.id]|default('') }}</td>
                        <td>{{ ('studio.forum.moderators.type.' ~ row.subjectType.value)|trans }}</td>
                        <td>{{ row.inheritsChildren ? 'studio.forum.moderators.inherit.yes'|trans : 'studio.forum.moderators.inherit.no'|trans }}</td>
                        <td>
                            {% if row.grantKeys is empty %}
                                <span class="text-fs-xs text-neutral-500">{{ 'studio.forum.moderators.grants.standard'|trans }}</span>
                            {% else %}
                                <span class="text-fs-xs text-neutral-700">{{ row.grantKeys|join(', ') }}</span>
                            {% endif %}
                        </td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="{{ path('admin_forum_moderators_edit', {id: row.id}) }}" class="btn btn-sm btn-neutral">{{ 'aacp.users.edit_action'|trans }}</a>
                                <form method="post" action="{{ path('admin_forum_moderators_delete', {id: row.id}) }}" onsubmit="return confirm({{ 'studio.forum.moderators.index.delete_confirm'|trans|json_encode|raw }});">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_forum_moderator') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'aacp.cron.delete'|trans }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </twig:block>
        </twig:studio:table>
    </twig:studio:card>
{% endblock %}
