{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.pages.settings.index.header'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_pages_index') }}" class="btn btn-sm btn-neutral">{{ 'studio.pages.settings.index.action.pages'|trans }}</a>
{% endblock %}

{% block body %}
    <form method="post" action="{{ path('admin_pages_settings_update') }}" class="space-y-sp-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_pages_settings') }}">

        {% for groupKey, groupDefs in grouped %}
            <twig:studio:card title="{{ (groupLabels[groupKey]|default(groupKey))|trans }}">
                <div class="grid gap-4 md:grid-cols-2">
                    {% for definition in groupDefs %}
                        <div class="{{ definition.type == 'textarea' ? 'md:col-span-2' : '' }}">
                            <label class="form-label">{{ definition.label|trans }}</label>

                            {% if definition.type in ['checkbox', 'boolean'] %}
                                <label class="mt-1 flex items-center gap-2">
                                    <input type="checkbox" name="settings[{{ definition.key }}]" value="1" {{ values[definition.key] ? 'checked' : '' }}>
                                    <span class="text-fs-sm text-neutral-600">{{ 'studio.pages.settings.index.enabled'|trans }}</span>
                                </label>
                            {% elseif definition.type == 'textarea' %}
                                <textarea name="settings[{{ definition.key }}]" class="form-control" rows="3">{{ values[definition.key] }}</textarea>
                            {% elseif definition.type == 'select' %}
                                <select name="settings[{{ definition.key }}]" class="form-select">
                                    {% for value, label in definition.variants %}
                                        <option value="{{ value }}" {{ values[definition.key] == value ? 'selected' : '' }}>{{ label|trans }}</option>
                                    {% endfor %}
                                </select>
                            {% elseif definition.type == 'integer' %}
                                <input type="number" name="settings[{{ definition.key }}]" value="{{ values[definition.key] }}" class="form-control">
                            {% else %}
                                <input type="text" name="settings[{{ definition.key }}]" value="{{ values[definition.key] }}" class="form-control">
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </twig:studio:card>
        {% else %}
            <p class="text-fs-sm text-neutral-500">{{ 'studio.pages.settings.index.no_settings'|trans }}</p>
        {% endfor %}

        <button type="submit" class="btn btn-primary">{{ 'studio.pages.settings.index.save'|trans }}</button>
    </form>
{% endblock %}
