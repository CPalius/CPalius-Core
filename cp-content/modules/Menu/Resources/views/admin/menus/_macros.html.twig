{#
    One tree row per translation group. Collapsed: active-locale label only.
    Expanded: per-locale labels/URLs, node id, save.
#}
{% macro renderItems(nodes, locales) %}
    {% import _self as self %}
    <ul class="{{ nodes is not empty and nodes[0].canonical.parent is null ? '' : 'ml-sp-md mt-1.5' }} space-y-1.5" data-sortable-list data-parent-id="{{ nodes is not empty ? (nodes[0].canonical.parent.id ?? '') : '' }}">
        {% for node in nodes %}
            {% set item = node.canonical %}
            {% set uiLocale = app.request.locale %}
            {% set displayLabel = item.label %}
            {% if node.byLocale[uiLocale] is defined %}
                {% set displayLabel = node.byLocale[uiLocale].label %}
            {% else %}
                {% for locale in locales %}
                    {% if locale.isDefault and node.byLocale[locale.code] is defined %}
                        {% set displayLabel = node.byLocale[locale.code].label %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            <li data-item-id="{{ item.id }}" class="rounded-lg border border-neutral-200 bg-white p-sp-xs">
                <div class="flex items-start gap-2">
                    <span class="cursor-move pt-1.5 text-neutral-500" data-drag-handle>⠿</span>
                    <details class="min-w-0 flex-1">
                        <summary class="cursor-pointer select-none py-1 text-fs-sm font-medium text-neutral-900">
                            {{ displayLabel }}
                        </summary>
                        <form method="post" action="{{ path('admin_menus_update_item', {itemId: item.id}) }}" class="mt-sp-xs space-y-sp-xs border-t border-neutral-100 pt-sp-xs">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_menu_form') }}">
                            <div class="grid gap-2 sm:grid-cols-2">
                                {% for locale in locales %}
                                    {% set row = node.byLocale[locale.code]|default(null) %}
                                    <div>
                                        <label class="form-label">{{ 'menu.edit.label_field'|trans }} — {{ locale.nativeName }} ({{ locale.code }})</label>
                                        <input type="text" name="labels[{{ locale.code }}]" value="{{ row ? row.label : '' }}" class="form-control">
                                        <input type="text" name="urls[{{ locale.code }}]" value="{{ row and row.url ? row.url : '' }}" placeholder="{{ 'menu.edit.external_url_placeholder'|trans }}" class="form-control mt-1">
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="flex flex-wrap items-center gap-3">
                                <div class="min-w-[8rem] flex-1">
                                    <label class="form-label">{{ 'menu.edit.node_id_field'|trans }}</label>
                                    <input type="number" name="node_id" value="{{ item.nodeId }}" placeholder="{{ 'menu.edit.node_id_placeholder'|trans }}" class="form-control">
                                </div>
                                <label class="mt-5 flex items-center gap-2 text-fs-sm text-neutral-700">
                                    <input type="checkbox" name="open_in_new_tab" value="1" {{ item.openInNewTab ? 'checked' : '' }}
                                           class="form-check-input h-4 w-4 text-primary-600 focus:ring-primary-600">
                                    {{ 'menu.edit.open_in_new_tab'|trans }}
                                </label>
                                <button type="submit" class="btn btn-sm btn-primary mt-5">
                                    {{ 'menu.edit.update_submit'|trans }}
                                </button>
                            </div>
                        </form>
                    </details>
                    <form method="post" action="{{ path('admin_menus_delete_item', {itemId: item.id}) }}"
                          class="pt-0.5"
                          onsubmit="return confirm({{ 'menu.edit.delete_confirm'|trans|json_encode|raw }});">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_menu_form') }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            {{ 'aacp.cron.delete'|trans }}
                        </button>
                    </form>
                </div>

                {% if node.children is not empty %}
                    {{ self.renderItems(node.children, locales) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}
