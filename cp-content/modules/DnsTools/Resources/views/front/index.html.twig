{% extends '@DnsToolsModule/front/layout.html.twig' %}

{% block title %}{{ pageCopy.title }}{% endblock %}
{% block meta_description %}{{ pageCopy.description }}{% endblock %}
{% block meta_keywords %}{{ pageCopy.keywords }}{% endblock %}

{% block dnstools_main %}
<div class="dnstools-page dnstools-page--home" data-dnstools data-api="{{ quickTool ? path('dnstools_api', {slug: quickTool.slug}) : '' }}" data-token="{{ csrf_token('dnstools_query') }}"{% if quickTool %} data-tool-title="{{ quickTool.title }}"{% endif %}{% if forumSearchUrl %} data-forum-search="{{ forumSearchUrl }}"{% endif %}{% if forumComposeUrl %} data-forum-compose="{{ forumComposeUrl }}"{% endif %}{% if forumBoards is defined and forumBoards|length > 0 %} data-forum-boards="{{ forumBoards|json_encode|e('html_attr') }}" data-forum-ask="{{ path('dnstools_forum_ask') }}"{% endif %}>
    <section class="dns-home-hero">
        <div class="dns-home-wrap dns-home-hero__grid">
            <div>
                <p class="dns-home-kicker">m-dns.org</p>
                <h1>{{ 'dnstools.hero.title'|trans }}</h1>
                <p class="dns-home-lead">{{ 'dnstools.hero.lead'|trans }}</p>
                {% if quickTool %}
                <form class="dns-home-search" data-dnstools-form data-slug="{{ quickTool.slug }}">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="text" name="q" autocomplete="off" spellcheck="false" placeholder="ornekalanadi.com" required>
                    <button type="submit">{{ 'dnstools.action.query'|trans }}</button>
                </form>
                {% endif %}
                <div class="dns-home-picks">
                    <a href="{{ path('dnstools_tool', {slug: 'spam-score'}) }}"><i class="bi bi-ui-checks"></i><span>{{ 'dnstools.home.pick_spam'|trans }}</span></a>
                    <a href="{{ path('dnstools_tool', {slug: 'smtp-tester'}) }}"><i class="bi bi-envelope-check"></i><span>{{ 'dnstools.home.pick_smtp'|trans }}</span></a>
                    <a href="{{ path('dnstools_tool', {slug: 'whois'}) }}"><i class="bi bi-info-circle"></i><span>{{ 'dnstools.home.pick_whois'|trans }}</span></a>
                    {% if forumBoards is defined and forumBoards|length > 0 %}
                        <a href="{{ path('forum_index') }}"><i class="bi bi-chat-left-text"></i><span>{{ 'dnstools.home.pick_forum'|trans }}</span></a>
                    {% endif %}
                </div>
            </div>
            <img class="dns-home-logo" src="{{ cp_appearance().logo }}" alt="">
        </div>
    </section>

    <div class="dns-home-wrap dns-home-results">
        <div class="dnstools-status" data-dnstools-status hidden></div>
        <div class="dnstools-results" data-dnstools-results hidden></div>
        <div class="dnstools-community" data-dnstools-community hidden></div>
    </div>

    <section class="dns-home-wrap dns-home-block">
        <div class="dns-home-head">
            <h2>{{ 'dnstools.section.featured'|trans }}</h2>
            <a href="{{ path('dnstools_all') }}">{{ 'dnstools.action.all'|trans }} <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="dns-home-grid">
            {% for tool in featured %}
                <a class="dns-home-card" href="{{ path('dnstools_tool', {slug: tool.slug}) }}">
                    <i class="bi {{ tool.icon }}"></i>
                    <strong>{{ tool.title }}</strong>
                    <span>{{ tool.subtitle }}</span>
                </a>
            {% endfor %}
        </div>
    </section>
    {% if forumBoards is defined and forumBoards|length > 0 %}
        {% include '@DnsToolsModule/front/partials/_forum_wizard.html.twig' %}
    {% endif %}
</div>
{% include '@DnsToolsModule/front/partials/_app.html.twig' %}
{% endblock %}
