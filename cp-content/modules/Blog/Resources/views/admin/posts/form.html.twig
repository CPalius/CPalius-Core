{% extends 'admin/layout.html.twig' %}

{% block header %}{{ post ? 'blog.posts.form.header_edit'|trans : 'blog.posts.form.header_create'|trans }}{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'admin-post-form', 'admin-post-taxonomy', 'media-picker', 'field-media', 'cp-editor-init']) }}{% endblock %}

{% block body %}
    <div id="post-form-container" data-post-form-root data-i18n-save-first="{{ 'blog.posts.form.save_before_translate'|trans }}" data-current-url="{{ post ? path('admin_posts_edit', {id: post.id}) : path('admin_posts_create', {translation_group: translationGroupId, locale: currentLocale}) }}">
    {% if activeLocales|default([])|length > 1 %}
        <div class="mb-sp-md flex flex-wrap items-center gap-2" data-post-translation-tabs>
            {% for locale in activeLocales %}
                {% set translation = translations[locale.code] ?? null %}
                {% if locale.code == currentLocale %}
                    <span class="badge badge-primary">{{ locale.nativeName }}</span>
                {% elseif translation %}
                    <a href="{{ path('admin_posts_edit', {id: translation.id}) }}" data-post-translation-link class="badge badge-success hover:opacity-80">
                        {{ locale.nativeName }}
                    </a>
                {% elseif post and translationGroupId %}
                    <a href="{{ path('admin_posts_create', {translation_group: translationGroupId, locale: locale.code}) }}" data-post-translation-link class="badge badge-neutral hover:opacity-80">
                        + {{ locale.nativeName }}
                    </a>
                {% elseif post %}
                    <form method="post" action="{{ path('admin_posts_assign_translation_group', {id: post.id}) }}" class="inline" data-post-translation-assign-form>
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_post_form') }}">
                        <button type="submit" class="badge badge-neutral hover:opacity-80">
                            + {{ locale.nativeName }}
                        </button>
                    </form>
                {% else %}
                    <button type="button" data-post-translation-locked class="badge badge-neutral opacity-60 cursor-not-allowed" title="{{ 'blog.posts.form.translation_locked_hint'|trans }}">
                        + {{ locale.nativeName }}
                    </button>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    {{ form_start(form, {
        action: post ? path('admin_posts_edit', {id: post.id}) : path('admin_posts_create', {translation_group: translationGroupId, locale: currentLocale}),
        attr: {'data-post-form': ''},
    }) }}
    <div class="flex flex-col gap-sp-md lg:flex-row lg:items-start">
        <div class="min-w-0 space-y-sp-md lg:w-[75%]">

            <twig:studio:card title="{{ 'blog.posts.form.section_content'|trans }}">
                <div class="space-y-sp-sm">
                    {{ form_row(form.title) }}
                    {{ form_row(form.excerpt) }}
                    {{ form_row(form.body) }}
                </div>
            </twig:studio:card>

            <twig:studio:card title="{{ 'blog.posts.form.section_faq'|trans }}">
                {{ form_row(form.faq) }}
            </twig:studio:card>

            <twig:studio:card title="{{ 'blog.posts.form.section_project'|trans }}" data-post-sub-type-panel="proje">
                <div class="space-y-sp-sm">
                    {{ form_row(form.projectRepoUrl) }}
                    {{ form_row(form.projectDemoUrl) }}
                </div>
            </twig:studio:card>

            <twig:studio:card title="{{ 'blog.posts.form.section_software'|trans }}" data-post-sub-type-panel="yazilim">
                <div class="space-y-sp-sm">
                    {{ form_row(form.softwareVersion) }}
                    {{ form_row(form.softwareDownloadUrl) }}
                </div>
            </twig:studio:card>

            <twig:studio:card title="{{ 'blog.posts.form.section_note'|trans }}" data-post-sub-type-panel="not">
                <div class="space-y-sp-sm">
                    {{ form_row(form.noteCodeSnippet) }}
                </div>
            </twig:studio:card>

            <twig:studio:card padded="{{ false }}">
                <details class="group">
                    <summary class="flex cursor-pointer list-none items-center justify-between px-sp-sm py-3 text-fs-sm font-semibold text-neutral-900">
                        SEO &amp; Schema.org
                        <span class="text-fs-xs text-neutral-500 transition group-open:rotate-180">▾</span>
                    </summary>

                    <div class="space-y-sp-sm border-t border-neutral-200 px-sp-sm py-sp-sm">
                        <div>
                            <label for="{{ form.slug.vars.id }}" class="form-label">Slug</label>
                            <div class="flex items-center gap-2">
                                <span class="text-fs-sm text-neutral-500">/{{ currentLocale|default('tr') }}/blog/</span>
                                {{ form_widget(form.slug) }}
                            </div>
                            <p class="mt-1 text-fs-xs text-neutral-500">{{ 'blog.posts.form.slug_hint'|trans }}</p>
                            {{ form_errors(form.slug) }}
                        </div>

                        <div>
                            {{ form_label(form.seoMetaDescription) }}
                            {{ form_widget(form.seoMetaDescription) }}
                            <p class="mt-1 text-fs-xs text-neutral-500">{{ 'blog.posts.form.seo_char_count'|trans({count: form.vars.value.seoMetaDescription|default('')|length}) }}</p>
                            {{ form_errors(form.seoMetaDescription) }}
                        </div>

                        {{ form_row(form.seoFocusKeyword) }}
                        {{ form_row(form.seoCanonicalUrl) }}
                        {{ form_row(form.seoNoindex) }}

                        <p class="border-t border-neutral-200 pt-sp-xs text-fs-xs text-neutral-500">
                            {{ 'blog.posts.form.schema_notice'|trans }}
                        </p>
                    </div>
                </details>
            </twig:studio:card>
        </div>

        <div class="min-w-0 space-y-sp-md lg:w-[25%]">
            <twig:studio:card title="{{ 'blog.posts.form.section_publish'|trans }}">
                <div class="space-y-sp-sm">
                    {{ form_row(form.postSubType) }}
                    {{ form_row(form.status) }}
                    {{ form_row(form.publishedAt) }}
                    {{ form_row(form.isFeatured) }}
                    {{ form_row(form.commentsEnabled) }}

                    {% if form.autoTranslate is defined %}
                        {% if post and ai_auto_translate is defined and ai_auto_translate.on_edit|default(false) %}
                            {% if missingTranslationLocales|default([]) is empty and existingTranslationLocales|default([]) is not empty %}
                                <p class="text-fs-xs text-neutral-500">{{ 'ai.form.already_exists_node'|trans({'locales': existingTranslationLocales|join(', ')}) }}</p>
                                {% do form.autoTranslate.setRendered %}
                            {% else %}
                                {{ form_row(form.autoTranslate) }}
                                {% if existingTranslationLocales|default([]) is not empty %}
                                    <p class="text-fs-xs text-neutral-500">{{ 'ai.form.already_exists_node'|trans({'locales': existingTranslationLocales|join(', ')}) }}</p>
                                {% endif %}
                            {% endif %}
                        {% elseif not post and ai_auto_translate is defined and ai_auto_translate.on_create|default(true) %}
                            {{ form_row(form.autoTranslate) }}
                        {% else %}
                            {% do form.autoTranslate.setRendered %}
                        {% endif %}
                    {% endif %}

                    {% if form.syncTranslations is defined %}
                        {{ form_row(form.syncTranslations) }}
                        <p class="text-fs-xs text-neutral-500">{{ 'blog.posts.form.sync_locales'|trans({locales: aiSyncLocales|join(', ')}) }}</p>
                    {% endif %}

                    {% if post %}
                        <div class="flex items-center justify-between gap-2 border-t border-neutral-200 pt-sp-sm">
                            <twig:studio:badge status="{{ post.status }}" />
                            {% if viewUrl %}
                                <a href="{{ viewUrl }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                    {{ 'blog.posts.view_on_site'|trans }} ↗
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="flex items-center gap-3 border-t border-neutral-200 pt-sp-sm">
                        <button type="submit" class="btn btn-primary w-full">
                            {{ post ? 'aacp.users.form.submit_edit'|trans : 'blog.posts.form.submit_create'|trans }}
                        </button>
                    </div>
                    <a href="{{ path('admin_posts_index') }}" class="block text-center text-fs-sm font-medium text-neutral-500 hover:text-neutral-900">
                        {{ 'aacp.users.form.cancel'|trans }}
                    </a>
                </div>
            </twig:studio:card>

            {% set canManageCategories = is_granted('blog.category.manage') %}
            <twig:studio:card title="{{ 'blog.categories.header'|trans }}">
                {# Categories are managed in place (modal + AJAX) by admin-post-taxonomy.js. #}
                <div data-category-manager
                     data-field-name="{{ form.categoryIds.vars.full_name }}[]"
                     data-field-id="{{ form.categoryIds.vars.id }}"
                     data-locale="{{ categoryLocale }}"
                     data-create-url="{{ path('admin_categories_ajax_create') }}"
                     data-update-url="{{ path('admin_categories_ajax_update', {id: 0}) }}"
                     data-token="{{ csrf_token('admin_category_form') }}"
                     data-meta="{{ categoryMeta|json_encode }}">
                    <div class="space-y-1.5" data-category-list>
                        {% for child in form.categoryIds %}
                            <div class="flex items-center justify-between gap-2" data-category-row data-category-id="{{ child.vars.value }}">
                                <label class="flex min-w-0 items-center gap-2 text-fs-sm text-neutral-700">
                                    {{ form_widget(child, {attr: {class: 'h-4 w-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-600'}}) }}
                                    <span class="truncate" data-category-label>{{ child.vars.label }}</span>
                                </label>
                                {% if canManageCategories %}
                                    <button type="button" data-category-edit class="shrink-0 text-fs-xs text-primary-600 hover:underline">{{ 'blog.posts.form.category_edit'|trans }}</button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.categoryIds) }}

                    {% if canManageCategories %}
                        <button type="button" data-category-add class="btn btn-sm btn-neutral mt-sp-xs w-full">+ {{ 'blog.posts.form.category_add'|trans }}</button>
                        <template data-category-row-template>
                            <div class="flex items-center justify-between gap-2" data-category-row>
                                <label class="flex min-w-0 items-center gap-2 text-fs-sm text-neutral-700">
                                    <input type="checkbox" class="h-4 w-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-600" data-category-checkbox>
                                    <span class="truncate" data-category-label></span>
                                </label>
                                <button type="button" data-category-edit class="shrink-0 text-fs-xs text-primary-600 hover:underline">{{ 'blog.posts.form.category_edit'|trans }}</button>
                            </div>
                        </template>
                    {% endif %}
                </div>
            </twig:studio:card>

            <twig:studio:card title="{{ 'blog.tags.header'|trans }}">
                <div class="relative" data-tag-input data-suggest-url="{{ path('admin_posts_tags_suggest') }}" data-locale="{{ tagLocale }}">
                    {{ form_widget(form.tags) }}
                    <div hidden data-tag-ui>
                        <div class="form-control flex flex-wrap items-center gap-1.5" data-tag-box>
                            <input type="text" maxlength="100" autocomplete="off" data-tag-field
                                   placeholder="{{ 'blog.posts.form.tags_placeholder'|trans }}"
                                   class="min-w-[8rem] flex-1 border-0 bg-transparent p-0 text-fs-sm focus:outline-none focus:ring-0">
                        </div>
                        <ul hidden role="listbox" data-tag-suggestions class="absolute left-0 right-0 z-20 mt-1 max-h-48 overflow-auto rounded-lg border border-neutral-200 bg-white py-1 shadow-lg"></ul>
                    </div>
                    <template data-tag-chip-template>
                        <span class="badge badge-neutral inline-flex items-center gap-1" data-tag-chip>
                            <span data-tag-chip-label></span>
                            <button type="button" data-tag-chip-remove aria-label="{{ 'blog.posts.form.tag_remove'|trans }}" class="leading-none">×</button>
                        </span>
                    </template>
                    <template data-tag-option-template>
                        <li role="option" data-tag-option class="cursor-pointer px-3 py-1.5 text-fs-sm text-neutral-700 hover:bg-neutral-100"></li>
                    </template>
                </div>
                <p class="mt-1 text-fs-xs text-neutral-500">{{ 'blog.posts.form.tags_hint'|trans }}</p>
            </twig:studio:card>

            <twig:studio:card title="{{ 'blog.posts.form.section_featured_image'|trans }}">
                <div data-featured-image-preview class="mb-sp-xs">
                    {% if featuredImageUrl %}
                        <img src="{{ featuredImageUrl }}" class="max-h-40 rounded-lg">
                    {% endif %}
                </div>
                {{ form_widget(form.featuredImageAssetId, {attr: {'data-target-input': 'featured_image_asset_id'}}) }}
                <button type="button"
                        data-media-picker-trigger
                        data-target-input="featured_image_asset_id"
                        data-target-preview="featured-image-preview"
                        class="btn btn-sm btn-neutral w-full">
                    {{ 'blog.posts.form.select_image'|trans }}
                </button>
            </twig:studio:card>
        </div>
    </div>
    {{ form_end(form) }}

    {% if canManageCategories %}
        {# Outside <form>: its fields must never submit with the post. #}
        <dialog data-category-modal
                data-title-create="{{ 'blog.posts.form.category_add'|trans }}"
                data-title-edit="{{ 'blog.posts.form.category_edit_title'|trans }}"
                data-error-generic="{{ 'blog.categories.error.ajax_failed'|trans }}"
                class="m-auto w-full max-w-md rounded-xl p-0 shadow-xl backdrop:bg-black/40">
            <div class="space-y-sp-sm p-sp-md">
                <h3 class="text-fs-base font-semibold text-neutral-900" data-category-modal-title></h3>
                <div>
                    <label class="form-label">{{ 'blog.categories.form.name'|trans }}</label>
                    <input type="text" maxlength="190" class="form-control" data-cat-field="name">
                </div>
                <div>
                    <label class="form-label">{{ 'blog.categories.form.description'|trans }}</label>
                    <textarea rows="2" class="form-control" data-cat-field="description"></textarea>
                </div>
                <div>
                    <label class="form-label">{{ 'blog.categories.form.parent'|trans }}</label>
                    <select class="form-select" data-cat-field="parent">
                        <option value="">{{ 'blog.categories.form.no_parent'|trans }}</option>
                    </select>
                </div>
                <p class="text-fs-sm text-danger-600" hidden data-category-error></p>
                <div class="flex justify-end gap-2">
                    <button type="button" class="btn btn-sm btn-neutral" data-category-cancel>{{ 'aacp.users.form.cancel'|trans }}</button>
                    <button type="button" class="btn btn-sm btn-primary" data-category-save>{{ 'blog.posts.form.category_save'|trans }}</button>
                </div>
            </div>
        </dialog>
    {% endif %}
    </div>
{% endblock %}
