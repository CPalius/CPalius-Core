{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.seo.redirects.header'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_seo_redirects_create') }}" class="btn btn-sm btn-primary">
        {{ 'studio.seo.redirects.create'|trans }}
    </a>
{% endblock %}

{% block body %}
    <p class="mb-4 text-fs-sm text-neutral-500">{{ 'studio.seo.redirects.intro'|trans }}</p>

    <twig:studio:card padded="{{ false }}">
        <twig:studio:table headers="{{ [
            'studio.seo.redirects.column.source'|trans,
            'studio.seo.redirects.column.target'|trans,
            'studio.seo.redirects.column.status'|trans,
            'studio.seo.redirects.column.hits'|trans,
            '',
        ] }}" empty="{{ redirects is empty }}" emptyText="{{ 'studio.seo.redirects.empty'|trans }}">
            <twig:block name="rows">
                {% for row in redirects %}
                    <tr>
                        <td class="font-mono text-fs-xs text-neutral-700">/{{ row.sourcePath }}</td>
                        <td class="font-mono text-fs-xs text-neutral-500">{{ row.targetUrl }}</td>
                        <td>
                            <span class="badge {{ row.active ? 'badge-success' : 'badge-neutral' }}">
                                {{ row.statusCode }}
                                ·
                                {{ row.active ? 'studio.seo.redirects.active'|trans : 'studio.seo.redirects.inactive'|trans }}
                            </span>
                        </td>
                        <td class="text-fs-xs tabular-nums text-neutral-500">{{ row.hitCount }}</td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-3">
                                <a href="{{ path('admin_seo_redirects_edit', {id: row.id}) }}" class="text-fs-xs font-medium text-neutral-600 hover:text-primary-600">
                                    {{ 'studio.seo.redirects.edit'|trans }}
                                </a>
                                <form method="post" action="{{ path('admin_seo_redirects_delete', {id: row.id}) }}" onsubmit="return confirm('{{ 'studio.seo.redirects.delete_confirm'|trans }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_redirects') }}">
                                    <button type="submit" class="text-fs-xs font-medium text-neutral-600 hover:text-red-600">
                                        {{ 'studio.seo.redirects.delete'|trans }}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </twig:block>
        </twig:studio:table>
    </twig:studio:card>
{% endblock %}
