{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.seo.settings.header'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('seo_sitemap_index') }}" class="btn btn-sm btn-neutral" target="_blank" rel="noopener">{{ 'studio.seo.action.sitemap'|trans }}</a>
    <a href="{{ path('seo_robots') }}" class="btn btn-sm btn-neutral" target="_blank" rel="noopener">robots.txt</a>
    <form method="post" action="{{ path('admin_seo_rebuild_sitemap') }}" class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_rebuild') }}">
        <button type="submit" class="btn btn-sm btn-neutral">{{ 'studio.seo.action.rebuild'|trans }}</button>
    </form>
{% endblock %}

{% block body %}
    <form method="post" action="{{ path('admin_seo_update') }}" class="space-y-sp-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_settings') }}">

        {% for groupKey, groupDefs in grouped %}
            <twig:studio:card title="{{ (groupLabels[groupKey]|default(groupKey))|trans }}">
                <div class="grid gap-4 md:grid-cols-2">
                    {% for definition in groupDefs %}
                        {% set value = values[definition.key]|default(null) %}
                        <div class="{{ definition.type == 'textarea' or definition.isTranslatable ? 'md:col-span-2' : '' }}">
                            <label class="form-label">{{ definition.label|trans }}</label>

                            {% if definition.isTranslatable %}
                                <div class="space-y-2">
                                    {% for locale in cp_locales() %}
                                        {% set localeValue = (value is iterable ? value[locale.code]|default('') : value)|default('') %}
                                        <div class="flex items-start gap-2">
                                            <span class="mt-2 w-10 shrink-0 font-mono text-fs-xs uppercase text-neutral-500">{{ locale.code }}</span>
                                            {% if definition.type == 'textarea' %}
                                                <textarea name="settings[{{ definition.key }}][{{ locale.code }}]" class="form-control" rows="3" lang="{{ locale.code }}">{{ localeValue }}</textarea>
                                            {% else %}
                                                <input type="text" name="settings[{{ definition.key }}][{{ locale.code }}]" value="{{ localeValue }}" class="form-control" lang="{{ locale.code }}">
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% elseif definition.type in ['checkbox', 'boolean'] %}
                                <label class="mt-1 flex items-center gap-2">
                                    <input type="checkbox" name="settings[{{ definition.key }}]" value="1" {{ value ? 'checked' : '' }}>
                                    <span class="text-fs-sm text-neutral-600">{{ 'studio.seo.settings.enabled'|trans }}</span>
                                </label>
                            {% elseif definition.type == 'select' %}
                                <select name="settings[{{ definition.key }}]" class="form-select">
                                    {% for optionValue, optionLabel in definition.variants %}
                                        <option value="{{ optionValue }}" {{ value == optionValue ? 'selected' : '' }}>{{ optionLabel|trans }}</option>
                                    {% endfor %}
                                </select>
                            {% elseif definition.type == 'textarea' %}
                                <textarea name="settings[{{ definition.key }}]" class="form-control" rows="3">{{ value }}</textarea>
                            {% else %}
                                <input type="text" name="settings[{{ definition.key }}]" value="{{ value }}" class="form-control">
                            {% endif %}

                            <code class="text-fs-xs text-neutral-400">{{ definition.key }}</code>
                        </div>
                    {% endfor %}
                </div>
            </twig:studio:card>
        {% endfor %}

        <div>
            <button type="submit" class="btn btn-primary">{{ 'studio.seo.settings.save'|trans }}</button>
        </div>
    </form>
{% endblock %}
