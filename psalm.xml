<?xml version="1.0"?>
<psalm
    errorLevel="8"
    resolveFromConfigFile="true"
    autoloader="cp-includes/vendor/autoload.php"
    errorBaseline="psalm-baseline.xml"
    cacheDirectory="cp-core/var/cache/psalm"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config cp-includes/vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="cp-core/src" />
        <directory name="cp-content/modules" />
        <ignoreFiles>
            <directory name="cp-includes/vendor" />
            <directory name="cp-content/modules/*/Tests" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="tools/psalm/symfony-taint.stub.php" />
    </stubs>

    <!-- errorLevel 8 hides type noise; taint findings must still be errors. -->
    <issueHandlers>
        <TaintedHtml errorLevel="error" />
        <TaintedSql errorLevel="error" />
        <TaintedShell errorLevel="error" />
        <TaintedInclude errorLevel="error" />
        <TaintedFile errorLevel="error" />
        <TaintedEval errorLevel="error" />
        <TaintedHeader errorLevel="error" />
        <TaintedCookie errorLevel="error" />
        <TaintedSSRF errorLevel="error" />
        <TaintedUnserialize errorLevel="error" />
        <TaintedLdap errorLevel="error" />
        <TaintedCallable errorLevel="error" />
        <TaintedExtract errorLevel="error" />
        <TaintedTextWithQuotes errorLevel="error" />
        <TaintedSystemSecret errorLevel="error" />
        <TaintedUserSecret errorLevel="error" />
    </issueHandlers>
</psalm>
