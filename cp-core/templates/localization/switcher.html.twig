{#
    Phase 4 — front-end locale switcher.

    style = 'buttons' | 'dropdown'. Expects: style, current, currentLink, links.
#}
{% if style == 'dropdown' %}
    <details class="locale-switcher locale-switcher--dropdown" id="navLocale">
        <summary class="locale-switcher__toggle" aria-label="{{ 'website.locale.switcher_aria'|trans }}">
            <i class="bi bi-translate" aria-hidden="true"></i>
        </summary>

        <ul class="locale-switcher__menu" role="list">
            {% for link in links %}
                <li>
                    {% if link.isCurrent %}
                        <span class="locale-switcher__link is-active" aria-current="true" lang="{{ link.code }}">
                            <span>{{ link.nativeName }}</span>
                        </span>
                    {% else %}
                        <a href="{{ link.url }}"
                           hreflang="{{ link.code }}"
                           lang="{{ link.code }}"
                           rel="alternate"
                           class="locale-switcher__link">
                            <span>{{ link.nativeName }}</span>
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </details>
{% else %}
    <nav class="locale-switcher locale-switcher--buttons" aria-label="{{ 'website.locale.switcher_aria'|trans }}">
        {% for link in links %}
            {% if link.isCurrent %}
                <span class="locale-switcher__link is-active" aria-current="true" lang="{{ link.code }}">
                    {{ link.nativeName }}
                </span>
            {% else %}
                <a href="{{ link.url }}"
                   hreflang="{{ link.code }}"
                   lang="{{ link.code }}"
                   rel="alternate"
                   class="locale-switcher__link">
                    {{ link.nativeName }}
                </a>
            {% endif %}
        {% endfor %}
    </nav>
{% endif %}
