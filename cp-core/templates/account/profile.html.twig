{% extends '@Theme/account/layout.html.twig' %}

{% form_theme form '@Theme/form/theme.html.twig' %}

{% block title %}{{ 'account.profile.title'|trans }}{% endblock %}

{% block forum_breadcrumbs %}
    <nav class="forum-crumb fade-in" aria-label="{{ 'account.nav_aria'|trans }}">
        <ol class="forum-crumb__list">
            <li><a href="{{ path('theme_cpalius_website_home') }}"><i class="bi bi-house-door"></i></a></li>
            {% if accountHomeRoute|default('') not in ['', 'theme_cpalius_website_home'] %}
                <li><a href="{{ path(accountHomeRoute) }}">{{ 'account.breadcrumb.home'|trans }}</a></li>
            {% endif %}
            <li class="is-active">{{ 'account.profile.title'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block forum_content %}
<div class="forum-header fade-in">
    <h1 class="section-title" style="font-size: var(--fs-2xl);">{{ 'account.profile.title'|trans }}</h1>
    <p class="forum-header__desc">{{ 'account.profile.desc'|trans }}</p>
</div>

<div class="forum-profile-settings fade-in">
    <div class="forum-profile-settings__avatar forum-form">
        <h2 class="forum-profile-settings__heading">{{ 'account.profile.avatar_heading'|trans }}</h2>
        <div class="forum-profile-settings__avatar-preview" data-account-avatar-preview>
            {% include '@Theme/forum/partials/_avatar.html.twig' with {
                name: app.user.fullName,
                user: app.user,
                avatarUrl: avatarUrl,
                size: 'xl',
                square: true,
            } %}
        </div>
        <form method="post" action="{{ path('account_avatar_upload') }}" enctype="multipart/form-data" class="forum-profile-settings__avatar-form">
            <input type="hidden" name="_token" value="{{ csrf_token('account_avatar_upload') }}">
            <label class="btn btn-sm btn-outline">
                {{ 'account.profile.avatar_upload'|trans }}
                <input type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp,image/avif" hidden data-account-avatar-input>
            </label>
        </form>
        {% if avatarUrl %}
            <form method="post" action="{{ path('account_avatar_remove') }}" class="forum-profile-settings__avatar-remove">
                <input type="hidden" name="_token" value="{{ csrf_token('account_avatar_remove') }}">
                <button type="submit" class="btn btn-sm btn-ghost">{{ 'account.profile.avatar_remove'|trans }}</button>
            </form>
        {% endif %}
        <p class="forum-profile-settings__hint">{{ 'account.profile.avatar_hint'|trans }}</p>
    </div>

    <div class="forum-profile-settings__form">
        {{ form_start(form, {action: path('account_profile'), attr: {class: 'forum-form'}}) }}
            <fieldset class="forum-form__section">
                <legend>{{ 'account.profile.section_account'|trans }}</legend>

                {% if identityPending is defined and identityPending %}
                    <div class="forum-flash forum-flash--warning">
                        <p>{{ 'account.profile.identity_pending_heading'|trans }}</p>
                        <ul>
                            {% if identityPending.email %}
                                <li>{{ 'account.profile.identity_pending_email'|trans({'value': identityPending.email}) }}</li>
                            {% endif %}
                            {% if identityPending.username is not null %}
                                <li>{{ 'account.profile.identity_pending_username'|trans({'value': identityPending.username ?: '—'}) }}</li>
                            {% endif %}
                        </ul>
                    </div>
                {% elseif identityApprovalRequired|default(false) %}
                    <p class="forum-profile-settings__hint">{{ 'account.profile.identity_approval_hint'|trans }}</p>
                {% endif %}

                {{ form_row(form.email) }}
                {{ form_row(form.username) }}
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
                {{ form_row(form.locale) }}
            </fieldset>

            <fieldset class="forum-form__section">
                <legend>{{ 'account.profile.section_password'|trans }}</legend>
                {{ form_row(form.currentPassword) }}
                {{ form_row(form.newPassword) }}
            </fieldset>

            {% for section in form.vars.profile_sections|default([]) %}
                {# A module whose fields are all switched off contributes an empty
                   list; rendering its legend would advertise settings that are
                   not there. #}
                {% if section.fields is not empty %}
                <fieldset class="forum-form__section">
                    <legend>{{ section.legendKey|trans }}</legend>
                    {% if section.hintKey %}
                        <p class="forum-profile-settings__hint">{{ section.hintKey|trans }}</p>
                    {% endif %}
                    {% for name in section.fields %}
                        {{ form_row(attribute(form, name)) }}
                    {% endfor %}
                </fieldset>
                {% endif %}
            {% endfor %}

            <div class="forum-form__actions">
                <button type="submit" class="btn btn-primary">{{ 'account.profile.save'|trans }}</button>
            </div>
        {{ form_end(form) }}

        <p class="forum-profile-settings__hint" style="margin-top: var(--sp-md);">
            {{ 'account.profile.security_link_hint'|trans }}
            <a href="{{ path('account_security') }}" style="color: var(--cp-accent); text-decoration: underline;">{{ 'account.security.title'|trans }}</a>
        </p>

        {% if identityPending is defined and identityPending %}
            {# Its own form: nested forms are invalid HTML, and withdrawing a
               request must not also submit whatever else is half-typed above. #}
            <form method="post" action="{{ path('account_identity_request_cancel') }}" class="forum-form__actions">
                <input type="hidden" name="_token" value="{{ csrf_token('account_identity_cancel') }}">
                <button type="submit" class="btn btn-sm btn-ghost">{{ 'account.profile.identity_request_cancel'|trans }}</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script{{ csp_nonce_attr() }}>
    (function () {
        var input = document.querySelector('[data-account-avatar-input]');
        var form = input && input.closest('form');
        if (!input || !form) return;
        input.addEventListener('change', function () {
            if (input.files && input.files.length > 0) form.submit();
        });
    })();
    </script>
{% endblock %}
