{% extends 'admin/_auth_layout.html.twig' %}

{% block title %}{{ 'account.password_reset.reset_title'|trans }} · {{ siteName }}{% endblock %}

{% block notices %}
    {% for message in errors %}
        <div role="alert" class="mb-sp-sm flex items-start gap-3 rounded-lg border border-danger-500/40 bg-danger-950/60 px-4 py-3 text-fs-sm text-danger-200">
            <p>{{ message }}</p>
        </div>
    {% endfor %}
{% endblock %}

{% block subtitle %}{{ 'account.password_reset.reset_title'|trans }}{% endblock %}
{% block heading %}{{ (valid ? 'account.password_reset.reset_heading' : 'account.password_reset.invalid_heading')|trans }}{% endblock %}

{% block card %}
    {% if valid %}
        <form method="post" class="space-y-sp-sm">
            <div>
                <label for="password" class="form-label !text-neutral-400">{{ 'account.password_reset.new_password'|trans }}</label>
                <input type="password" id="password" name="password" autocomplete="new-password" minlength="{{ minLength }}" required autofocus
                       class="form-control !border-white/10 !bg-neutral-900 !text-neutral-100">
                <p class="mt-1 text-fs-xs text-neutral-500">{{ 'account.password_reset.min_length'|trans({'min': minLength}) }}</p>
            </div>
            <div>
                <label for="password_confirm" class="form-label !text-neutral-400">{{ 'account.password_reset.confirm_password'|trans }}</label>
                <input type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" minlength="{{ minLength }}" required
                       class="form-control !border-white/10 !bg-neutral-900 !text-neutral-100">
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('password_reset') }}">
            <button type="submit" class="btn btn-primary w-full">{{ 'account.password_reset.save'|trans }}</button>
        </form>
    {% else %}
        <p class="text-fs-sm text-neutral-300">{{ 'account.password_reset.invalid'|trans }}</p>
        <a href="{{ path('account_password_forgot') }}" class="btn btn-primary mt-sp-sm w-full">{{ 'account.password_reset.request_new'|trans }}</a>
    {% endif %}
{% endblock %}

{% block after_card %}
    <p class="mt-sp-sm text-center text-fs-xs">
        <a href="{{ path('admin_login') }}" class="text-neutral-400">{{ 'account.password_reset.back_to_login'|trans }}</a>
    </p>
{% endblock %}
