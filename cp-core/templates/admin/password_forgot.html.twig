{% extends 'admin/_auth_layout.html.twig' %}

{% block title %}{{ 'account.password_reset.forgot_title'|trans }} · {{ siteName }}{% endblock %}

{% block notices %}
    {% if error %}
        <div role="alert" class="mb-sp-sm flex items-start gap-3 rounded-lg border border-danger-500/40 bg-danger-950/60 px-4 py-3 text-fs-sm text-danger-200">
            <p>{{ error }}</p>
        </div>
    {% endif %}
{% endblock %}

{% block subtitle %}{{ 'account.password_reset.forgot_title'|trans }}{% endblock %}
{% block heading %}{{ 'account.password_reset.forgot_heading'|trans }}{% endblock %}

{% block card %}
    {% if sent %}
        <p class="text-fs-sm text-neutral-300">{{ 'account.password_reset.sent'|trans }}</p>
    {% else %}
        <form method="post" class="space-y-sp-sm">
            <p class="text-fs-xs text-neutral-400">{{ 'account.password_reset.forgot_desc'|trans }}</p>
            <div>
                <label for="email" class="form-label !text-neutral-400">{{ 'studio.login.email'|trans }}</label>
                <input type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required autofocus
                       class="form-control !border-white/10 !bg-neutral-900 !text-neutral-100">
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('password_forgot') }}">
            <button type="submit" class="btn btn-primary w-full">{{ 'account.password_reset.send'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}

{% block after_card %}
    <p class="mt-sp-sm text-center text-fs-xs">
        <a href="{{ path('admin_login') }}" class="text-neutral-400">{{ 'account.password_reset.back_to_login'|trans }}</a>
    </p>
{% endblock %}
