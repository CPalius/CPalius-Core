{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.dashboard.header'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ cp_asset('styles/dashboard-cards.css') }}">
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'studio-dashboard']) }}
{% endblock %}

{% block body %}
    {% if cp_studio_appearance().theme == 'classic' %}
        {{ include('admin/_dashboard_classic.html.twig') }}
    {% else %}
    {% set displayName = app.user.fullName|default(app.user.userIdentifier|default('')) %}
    {% set avatarUrl = cp_current_user_avatar_url() %}
    <div class="studio-cmd"
         data-studio-dashboard
         data-studio-widget-url="{{ path('admin_dashboard_widget_visibility') }}"
         data-studio-widget-csrf="{{ csrf_token('studio_widget_visibility') }}"
         data-cp-layout-url="{{ path('admin_dashboard_layout') }}"
         data-cp-layout-csrf="{{ csrf_token('studio_dashboard_layout') }}"
         data-label-widget-collapse="{{ 'studio.dashboard.widget.collapse'|trans }}"
         data-label-widget-expand="{{ 'studio.dashboard.widget.expand'|trans }}"
         data-label-drag="{{ 'studio.dashboard.layout.drag'|trans }}">
        <div class="studio-cmd-actionbar">
            <div class="studio-hello">
                {% if avatarUrl %}
                    <img src="{{ avatarUrl }}" alt="" class="studio-avatar studio-avatar-lg object-cover">
                {% else %}
                    <span class="studio-avatar studio-avatar-lg" aria-hidden="true">{{ displayName|slice(0, 1)|upper }}</span>
                {% endif %}
                <div>
                <h2 class="studio-cmd-welcome">{{ 'studio.dashboard.welcome'|trans({name: displayName}) }}</h2>
                <p class="studio-cmd-welcome-sub">{{ 'studio.dashboard.welcome_sub'|trans }}</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="btn btn-sm btn-neutral" data-cp-layout-open>
                    <twig:ux:icon name="heroicons:adjustments-horizontal" class="h-4 w-4" />
                    {{ 'studio.dashboard.layout.edit'|trans }}
                </button>
                {% if quickCreate is not empty %}
                    <div class="studio-cmd-dropdown" data-studio-create>
                        <button type="button" class="btn btn-sm btn-primary" data-studio-create-toggle>
                            <twig:ux:icon name="heroicons:plus" class="h-4 w-4" />
                            {{ 'studio.dashboard.create'|trans }}
                        </button>
                        <div hidden class="studio-cmd-dropdown-menu" data-studio-create-menu>
                            {% for item in quickCreate %}
                                <a href="{{ path(item.routeName) }}" class="studio-cmd-dropdown-item">
                                    <twig:ux:icon name="{{ item.icon }}" class="h-4 w-4" />
                                    {{ item.labelKey|trans }}
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Work waiting on a person is the first thing the Premium desk says. #}
        {% if workbench.available|default(false) and workbench.moderated and workbench.actionable > 0 %}
            <p class="studio-attn">
                <span class="studio-attn-dot" aria-hidden="true"></span>
                <span>{{ 'studio.dashboard.kpi.waiting_on_you'|trans }}</span>
                <strong>{{ workbench.actionable }}</strong>
            </p>
        {% endif %}

        {# Independent columns: moving a card changes only the column it left and the one it entered, so every
           other card stays where its owner put it. Order, columns, removed cards and row limits are per user. #}
        <div class="cp-cards">
            {% for col in 0..(layoutColumns - 1) %}
                <div class="cp-col" data-cp-col data-col="{{ col }}">
                    {% for card in cards %}
                        {% if card.column == col and not card.removed %}
                            <section class="studio-cmd-panel{{ hiddenWidgets[card.id] is defined ? ' is-collapsed' }}" data-studio-widget="{{ card.id }}" data-card-id="{{ card.id }}" data-studio-kind="{{ card.kind }}">
                                <h3 class="studio-cmd-panel-title">{{ card.labelKey|trans }}</h3>
                                {{ include('admin/_dashboard_card_body.html.twig') }}
                            </section>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        {{ include('admin/_dashboard_layout_modal.html.twig', {cards: cards, columns: layoutColumns}, with_context: false) }}
    </div>
    {% endif %}
{% endblock %}
