{% extends 'admin/layout.html.twig' %}

{% block header %}{{ 'studio.dashboard.header'|trans }}{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'studio-dashboard']) }}
{% endblock %}

{% block body %}
    {% set displayName = app.user.fullName|default(app.user.userIdentifier|default('')) %}
    <div class="studio-cmd" data-studio-dashboard>
        <div class="studio-cmd-actionbar">
            <div>
                <h2 class="studio-cmd-welcome">{{ 'studio.dashboard.welcome'|trans({name: displayName}) }}</h2>
                <p class="studio-cmd-welcome-sub">{{ 'studio.dashboard.welcome_sub'|trans }}</p>
            </div>
            {% if quickCreate is not empty %}
                <div class="studio-cmd-dropdown" data-studio-create>
                    <button type="button" class="btn btn-sm btn-primary" data-studio-create-toggle>
                        <twig:ux:icon name="heroicons:plus" class="h-4 w-4" />
                        {{ 'studio.dashboard.create'|trans }}
                    </button>
                    <div hidden class="studio-cmd-dropdown-menu" data-studio-create-menu>
                        {% for item in quickCreate %}
                            <a href="{{ path(item.routeName) }}" class="studio-cmd-dropdown-item">
                                <twig:ux:icon name="{{ item.icon }}" class="h-4 w-4" />
                                {{ item.labelKey|trans }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="studio-cmd-kpis">
            <div class="studio-cmd-kpi">
                <span class="studio-cmd-kpi-label">{{ 'studio.dashboard.kpi.published'|trans }}</span>
                <span class="studio-cmd-kpi-value">{{ kpis.published }}</span>
            </div>
            <div class="studio-cmd-kpi studio-cmd-kpi--action">
                <span class="studio-cmd-kpi-label">{{ 'studio.dashboard.kpi.drafts'|trans }}</span>
                <span class="studio-cmd-kpi-value">{{ kpis.drafts }}</span>
            </div>
            <div class="studio-cmd-kpi">
                <span class="studio-cmd-kpi-label">{{ 'studio.dashboard.kpi.media'|trans }}</span>
                <span class="studio-cmd-kpi-value">{{ kpis.mediaLabel }}</span>
            </div>
            {% for extra in kpis.extraKpis|default([]) %}
                <div class="studio-cmd-kpi">
                    <span class="studio-cmd-kpi-label">{{ extra.labelKey|trans }}</span>
                    <span class="studio-cmd-kpi-value">{{ extra.value }}</span>
                </div>
            {% endfor %}
        </div>

        <div class="studio-cmd-grid">
            <section class="studio-cmd-panel">
                <h3 class="studio-cmd-panel-title">{{ 'studio.dashboard.recent.title'|trans }}</h3>
                <div class="table-responsive">
                    <table class="table table-compact">
                        <thead>
                            <tr>
                                <th>{{ 'studio.dashboard.recent.col.title'|trans }}</th>
                                <th>{{ 'studio.dashboard.recent.col.type'|trans }}</th>
                                <th>{{ 'studio.dashboard.recent.col.author'|trans }}</th>
                                <th>{{ 'studio.dashboard.recent.col.updated'|trans }}</th>
                                <th>{{ 'studio.dashboard.recent.col.status'|trans }}</th>
                                <th>{{ 'studio.dashboard.recent.col.actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if recentActivity is empty %}
                                <tr>
                                    <td colspan="6" class="py-6 text-center text-fs-sm text-neutral-500">
                                        {{ 'studio.dashboard.recent.empty'|trans }}
                                    </td>
                                </tr>
                            {% else %}
                                {% for row in recentActivity %}
                                    <tr>
                                        <td class="font-medium text-neutral-900">{{ row.title }}</td>
                                        <td>{{ row.typeKey|trans }}</td>
                                        <td>{{ row.author }}</td>
                                        <td class="whitespace-nowrap text-neutral-500">{{ row.updatedAt|date('d.m.Y H:i') }}</td>
                                        <td><twig:studio:badge status="{{ row.status }}" /></td>
                                        <td class="whitespace-nowrap">
                                            <span class="inline-flex items-center gap-2">
                                                {% if row.editUrl %}
                                                    <a href="{{ row.editUrl }}" class="text-fs-xs font-medium text-primary-600 hover:text-primary-700">{{ 'studio.dashboard.action.edit'|trans }}</a>
                                                {% endif %}
                                                {% if row.viewUrl %}
                                                    <a href="{{ row.viewUrl }}" class="text-fs-xs font-medium text-neutral-500 hover:text-neutral-800">{{ 'studio.dashboard.action.view'|trans }}</a>
                                                {% endif %}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </section>

            <aside class="studio-cmd-side">
                <section class="studio-cmd-panel">
                    <h3 class="studio-cmd-panel-title">{{ 'studio.dashboard.mix.title'|trans }}</h3>
                    <div class="studio-cmd-donut">
                        <canvas data-studio-chart="doughnut-center"
                                data-center="{{ mix|reduce((sum, row) => sum + row.count, 0) }}"
                                data-center-label="{{ 'studio.dashboard.mix.center'|trans }}"
                                data-labels="{{ mix|map(row => row.labelKey|trans)|json_encode }}"
                                data-values="{{ mix|map(row => row.count)|json_encode }}"></canvas>
                    </div>
                </section>

                <section class="studio-cmd-panel">
                    <h3 class="studio-cmd-panel-title">{{ 'studio.dashboard.shortcuts.title'|trans }}</h3>
                    {% if quickLinks is empty %}
                        <p class="text-fs-sm text-neutral-500">{{ 'studio.dashboard.shortcuts.empty'|trans }}</p>
                    {% else %}
                        <div class="studio-cmd-shortcuts">
                            {% for link in quickLinks %}
                                <a href="{{ path(link.routeName) }}" class="studio-cmd-shortcut">
                                    <twig:ux:icon name="{{ link.icon }}" class="h-4 w-4" />
                                    {{ link.labelKey|trans }}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </section>
            </aside>
        </div>
    </div>
{% endblock %}
