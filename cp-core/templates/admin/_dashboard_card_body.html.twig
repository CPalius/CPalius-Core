{# Body of one Studio desk card (everything under its title). Expects the desk data plus `card`.
   card.limitValue is how many rows the user asked this card to list. #}
{% set limit = card.limitValue %}

{% if card.kind == 'recent' %}
    <div class="table-responsive">
        <table class="table table-compact">
            <thead>
                <tr>
                    <th>{{ 'studio.dashboard.recent.col.title'|trans }}</th>
                    <th>{{ 'studio.dashboard.recent.col.type'|trans }}</th>
                    <th>{{ 'studio.dashboard.recent.col.author'|trans }}</th>
                    <th>{{ 'studio.dashboard.recent.col.updated'|trans }}</th>
                    <th>{{ 'studio.dashboard.recent.col.status'|trans }}</th>
                    <th>{{ 'studio.dashboard.recent.col.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in recentActivity|slice(0, limit) %}
                    <tr>
                        <td class="font-medium text-neutral-900">{{ row.title }}</td>
                        <td>{{ row.typeKey|trans }}</td>
                        <td><span class="studio-author"><span class="studio-avatar" aria-hidden="true">{{ row.author|slice(0, 1)|upper }}</span>{{ row.author }}</span></td>
                        <td class="whitespace-nowrap text-neutral-500">{{ row.updatedAt|date('d.m.Y H:i') }}</td>
                        <td><twig:studio:badge status="{{ row.status }}" /></td>
                        <td class="whitespace-nowrap">
                            <span class="inline-flex items-center gap-2">
                                {% if row.editUrl %}
                                    <a href="{{ row.editUrl }}" class="text-fs-xs font-medium text-primary-600 hover:text-primary-700">{{ 'studio.dashboard.action.edit'|trans }}</a>
                                {% endif %}
                                {% if row.viewUrl %}
                                    <a href="{{ row.viewUrl }}" class="text-fs-xs font-medium text-neutral-500 hover:text-neutral-800">{{ 'studio.dashboard.action.view'|trans }}</a>
                                {% endif %}
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="py-6 text-center text-fs-sm text-neutral-500">{{ 'studio.dashboard.recent.empty'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% elseif card.kind == 'totals' %}
    {# Totals are read as a plain ledger, not shown as big numbers. Work
       waiting on a person leads it; totals that have already shipped follow.
       Each module's own numbers live on that module's card. #}
    <dl class="studio-ledger">
        {% if workbench.available|default(false) and workbench.moderated %}
            <div class="is-waiting"><dt>{{ 'studio.dashboard.kpi.waiting_on_you'|trans }}</dt><dd>{{ workbench.actionable }}</dd></div>
        {% endif %}
        {% if workbench.available|default(false) and workbench.mine.unfinished > 0 %}
            <div class="is-waiting"><dt>{{ 'studio.dashboard.kpi.my_open_work'|trans }}</dt><dd>{{ workbench.mine.unfinished }}</dd></div>
        {% endif %}
        <div><dt>{{ 'studio.dashboard.kpi.published'|trans }}</dt><dd>{{ kpis.published }}</dd></div>
        <div><dt>{{ 'studio.dashboard.kpi.drafts'|trans }}</dt><dd>{{ kpis.drafts }}</dd></div>
        <div><dt>{{ 'studio.dashboard.kpi.media'|trans }}</dt><dd>{{ kpis.mediaLabel }}</dd></div>
    </dl>

{% elseif card.kind == 'visitors' %}
    {{ include('admin/_dashboard_visitors_body.html.twig', {visitors: visitors}, with_context: false) }}

{% elseif card.kind == 'workbench' %}
    {# Driven by the workflow engine, not by publication status, so an install
       whose places are "quote / approved / invoiced" renders exactly like one
       whose places are editorial. #}
    <ul class="studio-cmd-workbench">
        {% for state in workbench.states|slice(0, limit) %}
            <li class="{{ state.actionable ? 'is-actionable' : '' }}">
                <span class="studio-cmd-workbench-label">{{ state.label|trans }}</span>
                <span class="studio-cmd-workbench-count">{{ state.count }}</span>
            </li>
        {% endfor %}
    </ul>
    {% if workbench.actionable == 0 %}
        {# Records are parked, but none of their exits are open to this viewer:
           say so rather than showing a queue they cannot move. #}
        <p class="studio-cmd-workbench-note">{{ 'studio.dashboard.workbench.not_yours'|trans }}</p>
    {% endif %}

{% elseif card.kind == 'mix' %}
    {% set mixTotal = mix|reduce((sum, row) => sum + row.count, 0) %}
    <div class="studio-split" aria-hidden="true">
        {% for row in mix|slice(0, limit) %}<span style="flex: {{ row.count }}; opacity: {{ max(0.3, 1 - loop.index0 * 0.3) }}"></span>{% endfor %}
    </div>
    <ul class="studio-mix">
        {% for row in mix|slice(0, limit) %}
            <li>
                <span class="studio-mix-dot" style="opacity: {{ max(0.3, 1 - loop.index0 * 0.3) }}" aria-hidden="true"></span>
                <span class="studio-mix-label">{{ row.labelKey|trans }}</span>
                <span class="studio-mix-count">{{ row.count }}</span>
                <span class="studio-mix-bar" aria-hidden="true"><span style="width: {{ mixTotal > 0 ? (row.count / mixTotal * 100)|round : 0 }}%"></span></span>
            </li>
        {% endfor %}
    </ul>

{% elseif card.kind == 'shortcuts' %}
    {% if quickLinks is empty %}
        <p class="text-fs-sm text-neutral-500">{{ 'studio.dashboard.shortcuts.empty'|trans }}</p>
    {% else %}
        <div class="studio-cmd-shortcuts">
            {% for link in quickLinks|slice(0, limit) %}
                <a href="{{ path(link.routeName) }}" class="studio-cmd-shortcut">
                    <twig:ux:icon name="{{ link.icon }}" class="h-4 w-4" />
                    {{ link.labelKey|trans }}
                </a>
            {% endfor %}
        </div>
    {% endif %}

{% elseif card.kind == 'module' %}
    <dl class="studio-ledger">
        {% for row in card.module.rows|slice(0, limit) %}
            <div><dt>{{ row.labelKey|trans }}</dt><dd>{{ row.value }}</dd></div>
        {% endfor %}
    </dl>
{% endif %}
