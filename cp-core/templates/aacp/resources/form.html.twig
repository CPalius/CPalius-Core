{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ id ? 'aacp.resources.form.edit'|trans({'name': definition.name, 'id': id}) : 'aacp.resources.form.new'|trans({'name': definition.name}) }}{% endblock %}

{% block javascripts %}
    {#- cp-editor-init and media-picker are pulled in only when a property opted
        into #[CpField(widget: 'richtext')]. A resource of plain columns must not
        pay for CKEditor, which is by far the heaviest thing this panel loads. -#}
    {% if hasRichText|default(false) %}
        {#- cp-editor-init is listed BEFORE aacp-resource-form so the editor API
            exists by the time the toggle evaluates. The toggle also waits for
            DOMContentLoaded, so this ordering is belt and braces rather than
            the only thing holding it up. -#}
        {{ importmap(['app', 'studio-quick-cache-clear', 'media-picker', 'cp-editor-init', 'aacp-resource-form']) }}
    {% else %}
        {{ importmap(['app', 'studio-quick-cache-clear', 'aacp-resource-form']) }}
    {% endif %}
{% endblock %}

{% block body %}
    {% set wide = wideFields|default([]) %}

    <div class="space-y-sp-md"
         data-aacp-resource-form
         data-label-editor-rich="{{ 'aacp.resources.form.editor_rich'|trans }}"
         data-label-editor-source="{{ 'aacp.resources.form.editor_source'|trans }}"
         data-editor-hint="{{ 'aacp.resources.form.editor_hint'|trans }}">

        {% if app.request.query.get('saved') %}<div class="toast toast-success">{{ 'aacp.resources.saved'|trans }}</div>{% endif %}
        {% if app.request.query.get('transitioned') %}<div class="toast toast-success">{{ 'aacp.moderation.applied'|trans }}</div>{% endif %}
        {% if app.request.query.get('error') %}<div class="toast toast-error">{{ app.request.query.get('error') }}</div>{% endif %}

        {{ form_start(form, {action: path('aacp_resource_save', {name: definition.name})}) }}
            {% if id %}<input type="hidden" name="id" value="{{ id }}">{% endif %}
            {{ form_errors(form) }}

            {#- Wide column for prose, narrow column for the short metadata that
                describes it — the same split the Studio page and post screens
                use. Without it every field, including a 22-row body, sat in one
                61.8%-wide stack and the screen read as a wall. -#}
            <div class="flex flex-col gap-sp-md lg:flex-row lg:items-start">
                <div class="min-w-0 space-y-sp-md lg:w-[72%]">
                    {% set wideChildren = form|filter(child => child.vars.name in wide) %}

                    {% if wideChildren is not empty %}
                        <twig:cp:card title="{{ 'aacp.resources.form.section_content'|trans }}">
                            <div class="space-y-sp-sm">
                                {% for child in wideChildren %}
                                    {{ form_row(child) }}
                                {% endfor %}
                            </div>
                        </twig:cp:card>
                    {% endif %}

                    {% if history is not empty %}
                        <twig:cp:card title="{{ 'aacp.resources.form.history'|trans }}" padded="{{ false }}">
                            <twig:cp:table headers="{{ ['aacp.revisions.column.when'|trans, 'aacp.revisions.column.author'|trans, 'aacp.resources.form.action'|trans, ''] }}" empty="{{ false }}">
                                <twig:block name="rows">
                                    {% for log in history %}
                                        <tr>
                                            <td class="text-fs-xs !text-slate-400">{{ log.createdAt|date('d.m.Y H:i:s') }}</td>
                                            <td class="text-fs-xs !text-slate-500">{{ log.userId ?? '—' }}</td>
                                            <td class="text-fs-xs !text-slate-400">{{ log.action }}</td>
                                            <td class="text-right">
                                                <details><summary class="cursor-pointer text-fs-xs !text-slate-500 hover:!text-slate-300">{{ 'aacp.cron.form.output'|trans }}</summary>
                                                    <pre class="mt-2 max-h-56 overflow-auto whitespace-pre-wrap rounded-lg bg-dark-1 p-sp-xs font-mono text-fs-xs !text-slate-400">{{ log.changes|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                                </details>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </twig:block>
                            </twig:cp:table>
                        </twig:cp:card>
                    {% endif %}
                </div>

                <div class="min-w-0 space-y-sp-md lg:w-[28%]">
                    <twig:cp:card title="{{ 'aacp.resources.form.section'|trans }}">
                        <div class="space-y-sp-sm">
                            {% for child in form|filter(child => child.vars.name not in wide) %}
                                {{ form_row(child) }}
                            {% endfor %}
                        </div>

                        <div class="mt-sp-sm flex flex-wrap items-center gap-3 border-t border-white/10 pt-sp-sm">
                            <button type="submit" class="btn btn-primary">{{ 'aacp.settings.save'|trans }}</button>
                            <a href="{{ path('aacp_resource_index', {name: definition.name}) }}" class="text-fs-sm !text-slate-400 hover:!text-slate-200">{{ 'aacp.cron.form.cancel'|trans }}</a>
                        </div>
                    </twig:cp:card>

                    {% if workflow and marking %}
                        <twig:cp:card title="{{ 'aacp.moderation.state'|trans }}">
                            <div class="flex flex-wrap items-center gap-2">
                                {% for place in workflow.places %}
                                    <span class="badge {{ place == marking ? 'badge-success' : 'badge-neutral' }}">{{ workflow.placeLabel(place) }}</span>
                                    {% if not loop.last %}<span class="!text-slate-600">&rarr;</span>{% endif %}
                                {% endfor %}
                            </div>
                        </twig:cp:card>
                    {% endif %}
                </div>
            </div>
        {{ form_end(form) }}

        {#- The transitions are their own POSTs, so they must live OUTSIDE the
            form above: a nested <form> is invalid HTML and the browser drops
            the inner one, which would silently turn every workflow button into
            a plain save. -#}
        {% if workflow and marking and transitions is not empty %}
            <twig:cp:card title="{{ 'aacp.moderation.state'|trans }}">
                <div class="flex flex-wrap gap-2">
                    {% for t in transitions %}
                        <form method="post" action="{{ path('aacp_resource_transition', {name: definition.name, id: id, transition: t.name}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <button type="submit" class="btn btn-secondary text-fs-xs">{{ t.label ?? t.name }} &rarr; {{ workflow.placeLabel(t.to) }}</button>
                        </form>
                    {% endfor %}
                </div>
            </twig:cp:card>
        {% endif %}
    </div>
{% endblock %}
