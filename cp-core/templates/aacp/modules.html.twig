{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.modules.header'|trans }}{% endblock %}

{% block body %}
    <div class="space-y-sp-md">
        {% if notice == 'uploaded' %}
            <div class="toast toast-success">{{ 'aacp.modules.notice.uploaded'|trans }}</div>
        {% elseif notice == 'uploaded_activated' %}
            <div class="toast toast-success">{{ 'aacp.modules.notice.uploaded_activated'|trans }}</div>
        {% elseif notice == 'activated' %}
            <div class="toast toast-success">{{ 'aacp.modules.activated_notice'|trans }}</div>
        {% elseif notice == 'deactivated' %}
            <div class="toast toast-success">{{ 'aacp.modules.notice.deactivated'|trans }}</div>
        {% elseif notice == 'purged' %}
            <div class="toast toast-success">{{ 'aacp.modules.notice.purged'|trans }}</div>
        {% elseif notice == 'deleted' %}
            <div class="toast toast-success">{{ 'aacp.modules.notice.deleted'|trans }}</div>
        {% elseif notice == 'updated' %}
            <div class="toast toast-success">{{ 'aacp.modules.notice.updated'|trans }}</div>
        {% endif %}

        {% if error %}
            <div class="toast toast-error">{{ error }}</div>
        {% endif %}

        {% if problems is not empty %}
            <div class="toast toast-error">
                <ul class="list-disc ps-5 text-fs-sm">
                    {% for problem in problems %}
                        <li>{{ problem }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <twig:cp:card title="{{ 'aacp.modules.upload.header'|trans }}">
            <p class="mb-sp-sm text-fs-sm text-slate-400">{{ 'aacp.modules.upload.help'|trans }}</p>
            <form method="post" action="{{ path('aacp_module_upload') }}" enctype="multipart/form-data" class="flex flex-col gap-3 md:flex-row md:items-end">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="_redirect" value="{{ path('aacp_modules') }}">
                <div class="flex-1">
                    <label class="form-label !text-slate-300">{{ 'aacp.modules.upload.file'|trans }}</label>
                    <input type="file" name="package" accept=".zip,application/zip" required class="form-control">
                </div>
                <label class="flex items-center gap-2 text-fs-sm text-slate-300">
                    <input type="checkbox" name="overwrite" value="1" class="form-check-input h-4 w-4">
                    {{ 'aacp.modules.upload.overwrite'|trans }}
                </label>
                <label class="flex items-center gap-2 text-fs-sm text-slate-300">
                    <input type="checkbox" name="activate" value="1" class="form-check-input h-4 w-4">
                    {{ 'aacp.modules.upload.activate'|trans }}
                </label>
                <button type="submit" class="btn btn-sm btn-primary">{{ 'aacp.modules.upload.submit'|trans }}</button>
            </form>
        </twig:cp:card>

        <twig:cp:card title="{{ 'aacp.modules.installed_modules'|trans }}" padded="{{ false }}">
            <twig:cp:table headers="{{ [
                'aacp.modules.column.name'|trans,
                'aacp.modules.column.version'|trans,
                'aacp.modules.column.author'|trans,
                'aacp.modules.column.status'|trans,
                '',
            ] }}" empty="{{ modules is empty }}">
                <twig:block name="rows">
                    {% for module in modules %}
                        <tr>
                            <td class="!text-slate-200">
                                <a href="{{ path('aacp_module_show', {dirName: module.dirName}) }}" class="font-medium !text-primary-300 hover:!text-primary-200">{{ module.name }}</a>
                                {% if module.description %}
                                    <p class="mt-0.5 text-fs-xs !text-slate-500">{{ module.description }}</p>
                                {% endif %}
                            </td>
                            <td class="!text-slate-400 font-mono text-fs-xs">{{ module.version }}</td>
                            <td class="!text-slate-400 text-fs-sm">{{ module.author|default('—') }}</td>
                            <td><twig:cp:badge status="{{ module.status }}" /></td>
                            <td class="text-right">
                                <div class="flex flex-wrap items-center justify-end gap-2">
                                    {% if module.status == 'active' %}
                                        <form method="post" action="{{ path('aacp_module_deactivate', {dirName: module.dirName}) }}" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="_redirect" value="{{ path('aacp_modules') }}">
                                            <label class="me-1 text-fs-xs !text-slate-500">
                                                <input type="checkbox" name="purge" value="1" class="form-check-input h-3 w-3">
                                                {{ 'aacp.modules.purge'|trans }}
                                            </label>
                                            <button type="submit" class="text-fs-xs font-medium !text-slate-400 hover:!text-danger-300">
                                                {{ 'aacp.dashboard.deactivate'|trans }}
                                            </button>
                                        </form>
                                    {% elseif module.status == 'inactive' %}
                                        <form method="post" action="{{ path('aacp_module_activate', {dirName: module.dirName}) }}" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="_redirect" value="{{ path('aacp_modules') }}">
                                            <button type="submit" class="text-fs-xs font-medium !text-primary-400 hover:!text-success-300">
                                                {{ 'aacp.modules.activate'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}

                                    {% if module.status != 'active' %}
                                        <form method="post" action="{{ path('aacp_module_delete', {dirName: module.dirName}) }}" class="inline" onsubmit="return confirm({{ 'aacp.modules.delete_confirm'|trans|json_encode|raw }});">
                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="_redirect" value="{{ path('aacp_modules') }}">
                                            <label class="me-1 text-fs-xs !text-slate-500">
                                                <input type="checkbox" name="purge" value="1" class="form-check-input h-3 w-3">
                                                {{ 'aacp.modules.purge'|trans }}
                                            </label>
                                            <button type="submit" class="text-fs-xs font-medium !text-danger-400 hover:!text-danger-300">
                                                {{ 'aacp.modules.delete'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:cp:table>
        </twig:cp:card>
    </div>
{% endblock %}
