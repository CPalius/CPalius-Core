{#
    One navigation strip for every Appearance screen, in the same order as the
    sidebar: what visitors see first (homepage, themes, store), how the site
    looks (options, fonts, code), then the panel's own look.

    Include at the top of the body block; the current screen is found from the route.
#}
{% set current = app.request.attributes.get('_route') %}
{% set aliases = {aacp_theme_gallery: 'aacp_themes'} %}
{% set here = aliases[current]|default(current) %}
{% set groups = [
    {label: 'aacp.appearance_nav.site', items: [
        {route: 'admin_homepage_settings', label: 'studio.homepage.header', cap: 'system.settings.manage'},
        {route: 'aacp_themes', label: 'aacp.menu.theme_list', cap: 'system.settings.manage'},
        {route: 'aacp_theme_store', label: 'aacp.store.theme_menu', cap: 'system.module.manage'},
        {route: 'aacp_theme_options', label: 'aacp.menu.theme_options', cap: 'system.settings.manage'},
        {route: 'aacp_fonts', label: 'aacp.menu.fonts', cap: 'system.settings.manage'},
        {route: 'aacp_theme_editor', label: 'aacp.menu.theme_editor', cap: 'system.settings.manage'},
    ]},
    {label: 'aacp.appearance_nav.panel', items: [
        {route: 'aacp_studio_appearance', label: 'aacp.menu.studio_appearance', cap: 'system.settings.manage'},
    ]},
] %}
<nav class="mb-sp-md flex flex-wrap items-end gap-x-sp-md gap-y-2 border-b border-white/10" aria-label="{{ 'aacp.menu.themes'|trans }}">
    {% for group in groups %}
        <div class="flex items-center gap-1">
            <span class="hidden border-b-2 border-transparent py-2.5 pe-1 text-fs-xs uppercase tracking-wider text-slate-600 sm:inline">{{ group.label|trans }}</span>
            {% for item in group.items %}
                {% if is_granted(item.cap) %}
                    <a href="{{ path(item.route) }}"
                       {% if here == item.route %}aria-current="page"{% endif %}
                       class="border-b-2 px-sp-sm py-2.5 text-fs-sm font-medium {{ here == item.route ? 'border-primary-500 text-primary-400' : 'border-transparent text-slate-500 hover:text-slate-300' }}">
                        {{ item.label|trans }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% endfor %}
</nav>
