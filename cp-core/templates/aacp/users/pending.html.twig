{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.users.pending_header'|trans }}{% endblock %}

{% block body %}
    <twig:cp:card padded="{{ false }}">
        <twig:cp:table headers="{{ [
            'aacp.users.column.email'|trans,
            'aacp.users.column.full_name'|trans,
            'aacp.users.column.created_at'|trans,
            '',
        ] }}" empty="{{ users is empty }}" emptyText="{{ 'aacp.users.pending_empty'|trans }}">
            <twig:block name="rows">
                {% for user in users %}
                    <tr>
                        <td>
                            <p class="font-medium !text-slate-200">{{ user.email }}</p>
                            {% if user.username %}
                                <p class="text-fs-xs !text-slate-500">@{{ user.username }}</p>
                            {% endif %}
                        </td>
                        <td>{{ user.fullName }}</td>
                        <td class="text-fs-xs !text-slate-400">{{ user.createdAt|date('d.m.Y H:i') }}</td>
                        <td class="text-right">
                            <form method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('aacp_user_approve') }}">
                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <button type="submit" class="btn btn-sm btn-primary">{{ 'aacp.users.approve_action'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </twig:block>
        </twig:cp:table>
    </twig:cp:card>
{% endblock %}
