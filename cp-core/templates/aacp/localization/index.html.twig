{#
    AACP locale management — Translation Explorer.

    Phase 3: columns are dynamic from LocaleProvider; new locales add columns/tabs automatically.

    Expected variables:
      entries, locales, groups, incompleteCount, focusLocale, csrf_token
#}
{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.localization.header'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('aacp_localization_export', {format: 'yaml'}) }}" download class="btn btn-sm btn-primary">
        {{ 'aacp.localization.export_yaml'|trans }}
    </a>
    <a href="{{ path('aacp_localization_export', {format: 'json'}) }}" download class="btn btn-sm btn-neutral">
        {{ 'aacp.localization.export_json'|trans }}
    </a>
    <button type="button" data-localization-import-trigger class="btn btn-sm btn-neutral">
        {{ 'aacp.localization.import_action'|trans }}
    </button>
    <form data-localization-import-form class="hidden">
        <input type="file" data-localization-import-input accept=".json,.yaml,.yml">
    </form>
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'aacp-localization']) }}
{% endblock %}

{% block body %}
    <div class="space-y-sp-md"
         data-localization-root
         data-localization-csrf="{{ csrf_token }}"
         data-localization-update-url="{{ path('aacp_localization_update') }}"
         data-localization-import-url="{{ path('aacp_localization_import') }}"
         data-localization-focus="{{ focusLocale ?? '' }}">

        {# ---- Locale tabs: "All" + each active locale ---- #}
        <div class="flex flex-wrap items-center gap-x-1 border-b border-white/10"
             role="tablist"
             aria-label="{{ 'aacp.localization.tabs_aria'|trans }}">
            <button type="button"
                    role="tab"
                    data-localization-tab="__all__"
                    class="border-b-2 px-sp-sm py-2.5 text-fs-sm font-medium border-primary-500 text-primary-400">
                {{ 'aacp.localization.tab.all'|trans }}
                <span class="badge badge-neutral ms-1.5">{{ entries|length }}</span>
            </button>

            {% for locale in locales %}
                <button type="button"
                        role="tab"
                        data-localization-tab="{{ locale.code }}"
                        class="border-b-2 px-sp-sm py-2.5 text-fs-sm font-medium border-transparent text-slate-500 hover:text-slate-300">
                    {{ locale.nativeName }}
                    <span class="font-mono text-fs-xs uppercase !text-slate-600">{{ locale.code }}</span>
                    {% if locale.isDefault %}
                        <span class="badge badge-success ms-1.5">{{ 'aacp.localization.default_badge'|trans }}</span>
                    {% endif %}
                </button>
            {% endfor %}
        </div>

        {% if focusLocale %}
            <div class="rounded-lg border border-primary-500/40 bg-primary-500/5 px-3 py-2 text-fs-sm !text-primary-300">
                {{ 'aacp.localization.focus_notice'|trans({locale: focusLocale}) }}
            </div>
        {% endif %}

        {# ---- Filter bar ---- #}
        <div class="flex flex-wrap items-center gap-2">
            <input type="text"
                   data-localization-filter
                   placeholder="{{ 'aacp.localization.search_placeholder'|trans }}"
                   class="form-control !w-80 !bg-dark-1 !border-white/10 !text-slate-200 placeholder-slate-600">

            <select data-localization-group-filter
                    class="form-control !w-64 !bg-dark-1 !border-white/10 !text-slate-200">
                <option value="">{{ 'aacp.localization.all_groups'|trans }}</option>
                {% for group in groups %}
                    <option value="{{ group }}">{{ group }}</option>
                {% endfor %}
            </select>

            <label class="flex cursor-pointer items-center gap-2 text-fs-sm !text-slate-400">
                <input type="checkbox" data-localization-incomplete-filter class="form-check-input">
                {{ 'aacp.localization.only_incomplete'|trans }}
                <span class="badge badge-warning">{{ incompleteCount }}</span>
            </label>

            <span class="ms-auto text-fs-xs !text-slate-500" data-localization-count></span>
        </div>

        {# ---- Translation Explorer ---- #}
        <twig:cp:card padded="{{ false }}">
            <twig:cp:table
                headers="{{ [
                    'aacp.localization.column.group'|trans,
                    'aacp.localization.column.key'|trans,
                ]|merge(locales|map(l => l.nativeName ~ ' (' ~ l.code|upper ~ ')')) }}"
                empty="{{ entries is empty }}"
                emptyText="{{ 'aacp.localization.empty'|trans }}">
                <twig:block name="rows">
                    {% for entry in entries %}
                        <tr data-localization-row
                            data-group="{{ entry.group }}"
                            data-key="{{ entry.key }}"
                            data-incomplete="{{ entry.incomplete ? '1' : '0' }}"
                            data-missing="{{ entry.values|filter(v => v|trim == '')|keys|join(' ') }}">
                            <td>
                                <span class="badge badge-neutral font-mono">{{ entry.group }}</span>
                            </td>
                            <td class="font-mono text-fs-xs !text-primary-400">{{ entry.key }}</td>

                            {% for locale in locales %}
                                {% set value = entry.values[locale.code]|default('') %}
                                <td data-localization-cell
                                    data-locale="{{ locale.code }}"
                                    class="cursor-text align-top{{ value|trim == '' ? ' !bg-warning-500/5' : '' }}"
                                    title="{{ 'aacp.localization.cell_hint'|trans }}">
                                    <span data-localization-value>{{ value }}</span>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:cp:table>
        </twig:cp:card>
    </div>
{% endblock %}
