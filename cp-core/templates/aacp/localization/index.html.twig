{#
    AACP translation editor. One language at a time, next to the text it translates:

        [ language to edit ]  [ compare with ]   [ all | missing | translated ]  [ search ] [ group ]

        original text (read only)            |  translation (edit, saves when you leave the box)

    Rows are drawn by aacp-localization.js from the JSON below, 40 at a time, so a few thousand strings
    never become a few thousand table rows.

    Expected variables: entries, locales, groups, focusLocale, csrf_token
#}
{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.localization.header'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ cp_asset('styles/aacp-localization.css') }}">
{% endblock %}

{% block header_actions %}
    <a href="{{ path('aacp_languages_index') }}" class="btn btn-sm btn-neutral">{{ 'aacp.localization.v2.back_to_languages'|trans }}</a>
    <details class="cpl-more">
        <summary class="btn btn-sm btn-neutral">{{ 'aacp.localization.v2.import_export'|trans }}</summary>
        <div class="cpl-more__menu">
            <a href="{{ path('aacp_localization_export', {format: 'yaml'}) }}" download>{{ 'aacp.localization.export_yaml'|trans }}</a>
            <a href="{{ path('aacp_localization_export', {format: 'json'}) }}" download>{{ 'aacp.localization.export_json'|trans }}</a>
            <button type="button" data-localization-import-trigger>{{ 'aacp.localization.import_action'|trans }}</button>
        </div>
    </details>
    <form data-localization-import-form class="hidden">
        <input type="file" data-localization-import-input accept=".json,.yaml,.yml">
    </form>
{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'aacp-localization']) }}
{% endblock %}

{% block body %}
    <div class="cpl" data-localization-root
         data-localization-csrf="{{ csrf_token }}"
         data-localization-update-url="{{ path('aacp_localization_update') }}"
         data-localization-import-url="{{ path('aacp_localization_import') }}"
         data-localization-focus="{{ focusLocale ?? '' }}"
         data-i18n-saved="{{ 'aacp.localization.v2.saved'|trans }}"
         data-i18n-error="{{ 'aacp.localization.v2.error'|trans }}"
         data-i18n-empty="{{ 'aacp.localization.v2.empty_filter'|trans }}"
         data-i18n-more="{{ 'aacp.localization.v2.load_more'|trans }}"
         data-i18n-shown="{{ 'aacp.localization.v2.shown'|trans({shown: '{shown}', total: '{total}'}) }}"
         data-i18n-placeholder="{{ 'aacp.localization.v2.placeholder'|trans }}"
         data-i18n-source-empty="{{ 'aacp.localization.v2.source_empty'|trans }}">

        <div class="cpl-bar">
            <label class="cpl-field">
                <span>{{ 'aacp.localization.v2.edit_language'|trans }}</span>
                <select data-cpl-target></select>
            </label>
            <label class="cpl-field">
                <span>{{ 'aacp.localization.v2.compare_with'|trans }}</span>
                <select data-cpl-source></select>
            </label>
            <div class="cpl-progress" aria-live="polite">
                <div class="cpl-progress__track"><div class="cpl-progress__bar" data-cpl-bar></div></div>
                <span data-cpl-progress-text></span>
            </div>
        </div>

        {% if focusLocale %}
            <p class="cpl-note">{{ 'aacp.localization.v2.focus_notice'|trans({locale: focusLocale}) }}</p>
        {% endif %}

        <div class="cpl-filters">
            <div class="cpl-seg" role="group" aria-label="{{ 'aacp.localization.v2.status'|trans }}" data-cpl-status>
                <button type="button" data-value="all">{{ 'aacp.localization.v2.status_all'|trans }}</button>
                <button type="button" data-value="missing">{{ 'aacp.localization.v2.status_missing'|trans }} <b data-cpl-missing-count></b></button>
                <button type="button" data-value="done">{{ 'aacp.localization.v2.status_done'|trans }}</button>
            </div>
            <input type="search" data-localization-filter placeholder="{{ 'aacp.localization.search_placeholder'|trans }}" aria-label="{{ 'aacp.localization.search_placeholder'|trans }}">
            <select data-localization-group-filter aria-label="{{ 'aacp.localization.all_groups'|trans }}">
                <option value="">{{ 'aacp.localization.all_groups'|trans }}</option>
                {% for group in groups %}
                    <option value="{{ group }}">{{ group|replace({'core:': '', 'messages+intl-icu': 'messages'}) }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="cpl-list" data-cpl-list></div>
        <div class="cpl-foot">
            <span data-localization-count></span>
            <button type="button" class="cpl-btn" data-cpl-more hidden></button>
        </div>
    </div>

    {# JSON, not markup: values are read with textContent in the script, never parsed as HTML. #}
    <script type="application/json" data-cpl-data>{{ {
        locales: locales|map(l => {code: l.code, name: l.nativeName, default: l.isDefault}),
        entries: entries|map(e => {g: e.group, k: e.key, v: e.values}),
    }|json_encode(15)|raw }}</script>
{% endblock %}
