{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ vocabulary ? 'aacp.taxonomy.form.header_edit'|trans : 'aacp.taxonomy.form.header_create'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-xl">
        <twig:cp:card>
            <form method="post"
                  action="{{ vocabulary ? path('aacp_taxonomy_vocabulary_edit', {machineName: vocabulary.machineName}) : path('aacp_taxonomy_vocabulary_new') }}"
                  class="space-y-sp-sm">
                <input type="hidden" name="_token" value="{{ csrf_token('aacp_taxonomy_vocabulary') }}">

                <div>
                    <label for="machine_name" class="form-label">{{ 'aacp.taxonomy.form.machine_name'|trans }}</label>
                    {% if vocabulary %}
                        <input type="text" id="machine_name" class="form-control !border-white/10 !bg-dark-1 font-mono !text-slate-500" value="{{ formValues.machine_name }}" disabled>
                        <p class="mt-1 text-fs-xs !text-slate-600">{{ 'aacp.taxonomy.form.machine_name_immutable'|trans }}</p>
                    {% else %}
                        <input type="text" id="machine_name" name="machine_name" value="{{ formValues.machine_name }}"
                               placeholder="{{ 'aacp.taxonomy.form.machine_name_placeholder'|trans }}"
                               class="form-control !border-white/10 !bg-dark-1 font-mono !text-slate-100">
                        <p class="mt-1 text-fs-xs !text-slate-600">{{ 'aacp.taxonomy.form.machine_name_help'|trans }}</p>
                    {% endif %}
                </div>

                <div>
                    <label for="label" class="form-label">{{ 'aacp.taxonomy.form.label'|trans }}</label>
                    <input type="text" id="label" name="label" required value="{{ formValues.label }}"
                           class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                </div>

                <div>
                    <label for="description" class="form-label">{{ 'aacp.taxonomy.form.description'|trans }}</label>
                    <textarea id="description" name="description" rows="2"
                              class="form-control !border-white/10 !bg-dark-1 !text-slate-100">{{ formValues.description }}</textarea>
                </div>

                <div class="flex items-center gap-2">
                    <input type="checkbox" id="hierarchical" name="hierarchical" value="1" {{ formValues.hierarchical ? 'checked' : '' }}
                           class="form-check-input">
                    <label for="hierarchical" class="form-label !mb-0">{{ 'aacp.taxonomy.form.hierarchical'|trans }}</label>
                </div>
                <p class="text-fs-xs !text-slate-600">{{ 'aacp.taxonomy.form.hierarchical_help'|trans }}</p>

                <div>
                    <label for="weight" class="form-label">{{ 'aacp.taxonomy.form.weight'|trans }}</label>
                    <input type="number" id="weight" name="weight" value="{{ formValues.weight }}"
                           class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                </div>

                <div class="flex items-center gap-3 border-t border-white/10 pt-sp-sm">
                    <button type="submit" class="btn btn-primary">
                        {{ vocabulary ? 'aacp.taxonomy.form.submit_edit'|trans : 'aacp.taxonomy.form.submit_create'|trans }}
                    </button>
                    <a href="{{ path('aacp_taxonomy_index') }}" class="text-fs-sm font-medium !text-slate-500 hover:!text-slate-200">
                        {{ 'aacp.users.form.cancel'|trans }}
                    </a>
                </div>
            </form>
        </twig:cp:card>
    </div>
{% endblock %}
