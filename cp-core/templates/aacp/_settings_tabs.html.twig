{#
    Tab bar between Module Settings and Plugin Settings sub-pages.

    Expects: active ('modules'|'plugins') — which tab appears selected.
#}
<div class="flex border-b border-white/10">
    <a href="{{ path('aacp_settings_modules') }}"
       class="border-b-2 px-sp-sm py-2.5 text-fs-sm font-medium {{ active == 'modules' ? 'border-primary-500 text-primary-400' : 'border-transparent text-slate-500 hover:text-slate-300' }}">
        {{ 'aacp.settings.tab_modules'|trans }}
    </a>
    <a href="{{ path('aacp_settings_plugins') }}"
       class="border-b-2 px-sp-sm py-2.5 text-fs-sm font-medium {{ active == 'plugins' ? 'border-primary-500 text-primary-400' : 'border-transparent text-slate-500 hover:text-slate-300' }}">
        {{ 'aacp.settings.tab_plugins'|trans }}
    </a>
</div>
