{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.performance.header'|trans }}{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'aacp-performance']) }}
{% endblock %}

{% block body %}
    <div class="space-y-sp-md">
        {{ include('aacp/performance/_backend_card.html.twig', {
            backendId: 'cpalius',
            title: 'aacp.performance.backend.cpalius'|trans,
            intro: 'aacp.performance.backend.cpalius_intro'|trans,
            fields: [
                {key: 'ttl', label: 'aacp.performance.field.ttl'|trans, hint: 'aacp.performance.field.ttl_origin_hint'|trans},
                {key: 'excludes', label: 'aacp.performance.field.excludes'|trans, type: 'textarea', hint: 'aacp.performance.field.excludes_origin_hint'|trans, wide: true},
                {key: 'minify', label: 'aacp.performance.field.minify'|trans, type: 'checkbox', hint: 'aacp.performance.field.minify_hint'|trans, wide: true},
                {key: 'compress_assets', label: 'aacp.performance.field.compress_assets'|trans, type: 'checkbox', hint: 'aacp.performance.field.compress_assets_hint'|trans, wide: true},
                {key: 'compress_images', label: 'aacp.performance.field.compress_images'|trans, type: 'checkbox', hint: 'aacp.performance.field.compress_images_hint'|trans, wide: true},
                {key: 'shield', label: 'aacp.performance.field.shield'|trans, type: 'checkbox', hint: 'aacp.performance.field.shield_hint'|trans, wide: true},
            ],
            config: sections.cpalius.config,
            status: sections.cpalius.status,
            csrf_token: csrf_token,
            purgeUrl: path('aacp_performance_cpalius_purge'),
        }) }}
        {{ include('aacp/performance/_backend_card.html.twig', {
            backendId: 'redis',
            title: 'aacp.performance.backend.redis'|trans,
            fields: [
                {key: 'host', label: 'aacp.performance.field.host'|trans},
                {key: 'port', label: 'aacp.performance.field.port'|trans},
                {key: 'password', label: 'aacp.performance.field.password'|trans},
                {key: 'timeout', label: 'aacp.performance.field.timeout'|trans},
            ],
            config: sections.redis.config,
            status: sections.redis.status,
            csrf_token: csrf_token,
        }) }}

        {{ include('aacp/performance/_backend_card.html.twig', {
            backendId: 'memcached',
            title: 'aacp.performance.backend.memcached'|trans,
            fields: [
                {key: 'host', label: 'aacp.performance.field.host'|trans},
                {key: 'port', label: 'aacp.performance.field.port'|trans},
                {key: 'timeout', label: 'aacp.performance.field.timeout'|trans},
            ],
            config: sections.memcached.config,
            status: sections.memcached.status,
            csrf_token: csrf_token,
        }) }}

        {{ include('aacp/performance/_backend_card.html.twig', {
            backendId: 'varnish',
            title: 'aacp.performance.backend.varnish'|trans,
            fields: [
                {key: 'backend_url', label: 'aacp.performance.field.backend_url'|trans},
                {key: 'port', label: 'aacp.performance.field.port'|trans},
                {key: 'ttl', label: 'aacp.performance.field.ttl'|trans},
                {key: 'timeout', label: 'aacp.performance.field.timeout'|trans},
                {key: 'excludes', label: 'aacp.performance.field.excludes'|trans, type: 'textarea', hint: 'aacp.performance.field.excludes_hint'|trans, wide: true},
            ],
            config: sections.varnish.config,
            status: sections.varnish.status,
            csrf_token: csrf_token,
        }) }}

        {{ include('aacp/performance/_backend_card.html.twig', {
            backendId: 'pagespeed',
            title: 'aacp.performance.backend.pagespeed'|trans,
            fields: [
                {key: 'check_url', label: 'aacp.performance.field.check_url'|trans},
                {key: 'timeout', label: 'aacp.performance.field.timeout'|trans},
            ],
            config: sections.pagespeed.config,
            status: sections.pagespeed.status,
            csrf_token: csrf_token,
        }) }}
    </div>
{% endblock %}
