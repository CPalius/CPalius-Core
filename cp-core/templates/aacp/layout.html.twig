<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'aacp.layout.title.default'|trans }}{% endblock %}</title>
        <meta name="robots" content="noindex, nofollow">

        {# One importmap() call only; extra calls break the browser. #}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {{ importmap(['app', 'studio-quick-cache-clear']) }}
        {% endblock %}
    </head>
    <body class="aacp-shell h-full bg-dark-1 text-slate-100 antialiased text-fs-base font-sans">
        <div class="flex h-full">
            <div data-sidebar-overlay class="sidebar-overlay"></div>

            <aside data-sidebar class="sidebar !bg-dark-2 border-e border-white/10">
                <button type="button" data-sidebar-close class="sidebar-close-btn !border-white/20 !text-slate-300">
                    <twig:ux:icon name="tabler:x" class="h-3.5 w-3.5" />
                </button>

                <div class="sidebar-logo !border-white/10">
                    <img src="/CPalius.png" alt="CPalius" class="h-6 w-auto shrink-0">
                    <div class="leading-tight">
                        <p class="text-fs-sm font-semibold text-slate-100">{{ 'aacp.layout.brand.name'|trans }}</p>
                        <p class="text-fs-xs text-slate-500">{{ 'aacp.layout.brand.subtitle'|trans }}</p>
                    </div>
                </div>

                <nav class="sidebar-menu-area !border-white/10">
                    <ul class="sidebar-menu" id="sidebar-menu">
                        {% set currentGroup = null %}
                        {% for item in cp_admin_menu('aacp') %}
                            {% if item.group is not null and item.group != currentGroup %}
                                <li class="sidebar-menu-group-title !text-slate-600">{{ item.group|trans }}</li>
                                {% set currentGroup = item.group %}
                            {% endif %}

                            {% set currentRoute = app.request.attributes.get('_route') %}
                            {% set itemActive = currentRoute == item.routeName or (item.routePrefix != item.routeName and currentRoute starts with item.routePrefix) %}
                            {% set childActive = false %}
                            {% for child in item.children %}
                                {% if currentRoute == child.routeName or (child.routePrefix != child.routeName and currentRoute starts with child.routePrefix) %}
                                    {% set childActive = true %}
                                {% endif %}
                            {% endfor %}

                            {% set isHub = item.hub|default(false) %}
                            <li{% if item.children is not empty %} class="dropdown{{ (itemActive or childActive) ? ' open' : '' }}"{% endif %}>
                                <a href="{{ isHub ? '#' : path(item.routeName) }}"
                                   {% if isHub %}data-sidebar-dropdown-trigger{% endif %}
                                   class="{{ (itemActive or (isHub and childActive)) ? 'active-page' : '!text-slate-400 hover:!bg-white/5 hover:!text-slate-200' }}{{ item.children is not empty ? ' has-submenu-trigger' : '' }}">
                                    <twig:ux:icon name="{{ item.icon }}" class="menu-icon shrink-0" />
                                    <span>{{ item.label|trans }}</span>
                                    {% if item.children is not empty %}
                                        <span data-sidebar-dropdown-trigger class="submenu-caret ms-auto">
                                            <twig:ux:icon name="tabler:chevron-down" class="h-3.5 w-3.5 shrink-0" />
                                        </span>
                                    {% endif %}
                                </a>

                                {% if item.children is not empty %}
                                    <ul class="sidebar-submenu{{ (itemActive or childActive) ? ' open' : '' }}">
                                        {% for child in item.children %}
                                            {% set isChildActive = currentRoute == child.routeName or (child.routePrefix != child.routeName and currentRoute starts with child.routePrefix) %}
                                            <li{% if isChildActive %} class="active-page"{% endif %}>
                                                <a href="{{ path(child.routeName) }}"
                                                   class="{{ isChildActive ? '!bg-primary-500/10 !text-primary-300' : '!text-slate-500 hover:!text-slate-300' }}">
                                                    <twig:ux:icon name="{{ child.icon }}" class="h-3.5 w-3.5 shrink-0" />
                                                    <span>{{ child.label|trans }}</span>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </nav>

                <div class="border-t border-white/10 px-sp-sm py-sp-xs text-fs-xs text-slate-600 font-mono">
                    {{ cp_app_name|default('CPalius CMF') }} · v{{ cp_app_version|default('1.0.0') }}
                </div>
            </aside>

            <main data-sidebar-main class="dashboard-main">
                <header class="navbar-header !bg-dark-2 !border-white/10">
                    <div class="flex min-w-0 items-center gap-3">
                        <button type="button" data-sidebar-toggle class="sidebar-toggle !text-slate-300">
                            <twig:ux:icon name="tabler:menu-2" class="h-5 w-5" />
                        </button>
                        <button type="button" data-sidebar-mobile-toggle class="sidebar-mobile-toggle !text-slate-300">
                            <twig:ux:icon name="tabler:menu-2" class="h-5 w-5" />
                        </button>
                        <h1 class="min-w-0 truncate text-fs-md font-semibold text-slate-200">{% block header %}{{ 'aacp.layout.header.default'|trans }}{% endblock %}</h1>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            {% block header_actions %}{% endblock %}
                        </div>
                        <a href="{{ path('theme_cpalius_website_home') }}"
                           target="_blank"
                           rel="noopener"
                           title="{{ 'aacp.layout.header.go_website'|trans }}"
                           class="header-icon-btn !bg-dark-1 !text-slate-300 hover:!bg-white/5">
                            <twig:ux:icon name="tabler:external-link" class="h-5 w-5" />
                        </a>
                        <button type="button"
                                data-quick-cache-clear-trigger
                                data-quick-cache-clear-url="{{ path('aacp_cache_rebuild_clear_symfony') }}"
                                data-quick-cache-clear-csrf="{{ csrf_token('aacp_cache_rebuild') }}"
                                title="{{ 'studio.layout.clear_cache'|trans }}"
                                class="header-icon-btn !bg-dark-1 !text-slate-300 hover:!bg-white/5">
                            <twig:ux:icon name="heroicons:bolt" class="h-5 w-5" />
                        </button>
                        {{ include('aacp/_header_actions.html.twig') }}
                    </div>
                </header>

                <div data-quick-cache-clear-modal class="modal-overlay">
                    <div class="modal-panel !bg-dark-2 !text-slate-100 shadow-2xl">
                        <div class="modal-header !border-white/10">
                            <h2 class="text-fs-md font-semibold text-slate-100">{{ 'studio.layout.clear_cache_modal.title'|trans }}</h2>
                            <button type="button" data-quick-cache-clear-modal-close class="text-slate-400 hover:text-slate-200">
                                <twig:ux:icon name="tabler:x" class="h-5 w-5" />
                            </button>
                        </div>
                        <div class="modal-body">
                            <p data-quick-cache-clear-modal-status
                               data-running-text="{{ 'studio.layout.clear_cache_modal.running'|trans }}"
                               data-success-text="{{ 'studio.layout.clear_cache_modal.success'|trans }}"
                               data-error-text="{{ 'studio.layout.clear_cache_modal.error'|trans }}"
                               data-request-failed="{{ 'aacp.cache_rebuild.log.request_failed'|trans({error: '{error}'}) }}"
                               data-not-json="{{ 'aacp.cache_rebuild.log.not_json'|trans({status: '{status}'}) }}"
                               class="mb-3 text-fs-sm text-slate-400">
                                {{ 'studio.layout.clear_cache_modal.running'|trans }}
                            </p>
                            <div data-quick-cache-clear-modal-log class="space-y-1"></div>
                        </div>
                        <div class="modal-footer !border-white/10">
                            <button type="button" data-quick-cache-clear-modal-close class="btn btn-sm btn-neutral">
                                {{ 'studio.layout.clear_cache_modal.close'|trans }}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pointer-events-none fixed right-sp-md top-[5.25rem] z-40 flex flex-col gap-2" data-toast-stack>
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="toast {{ label == 'error' ? 'toast-error !border-danger-500/40 !bg-danger-500/10 !text-danger-300' : 'toast-success !border-success-500/40 !bg-success-500/10 !text-success-300' }}">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>

                <div class="p-sp-md">
                    <div class="aacp-main-content">
                        {% block body %}{% endblock %}
                    </div>
                </div>
            </main>
        </div>
    </body>
</html>
