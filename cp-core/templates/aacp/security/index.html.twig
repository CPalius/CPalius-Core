{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.security.header'|trans }}{% endblock %}

{% block body %}
    {% set severityStyle = {
        'critical': '!border-danger-500/30 !bg-danger-500/10 !text-danger-300',
        'high': '!border-danger-500/20 !bg-danger-500/5 !text-danger-200',
        'medium': '!border-warning-500/30 !bg-warning-500/10 !text-warning-300',
        'low': '!border-white/10 !bg-white/5 !text-slate-300',
        'pass': '!border-success-500/30 !bg-success-500/10 !text-success-300',
    } %}
    {% set scoreTone = score >= 90 ? 'is-good' : (score >= 70 ? 'is-warn' : 'is-bad') %}
    {% set issueTotal = (summary.critical|default(0)) + (summary.high|default(0)) + (summary.medium|default(0)) + (summary.low|default(0)) %}
    {% set maxSeverity = [summary.critical|default(0), summary.high|default(0), summary.medium|default(0), summary.low|default(0), summary.pass|default(0)]|sort|last %}
    {% if maxSeverity < 1 %}{% set maxSeverity = 1 %}{% endif %}

    <div class="space-y-sp-md" data-aacp-security data-aacp-security-score="{{ score }}">
        {% if app.request.query.get('ban_error') %}
            <div class="rounded-lg border border-danger-500/30 bg-danger-500/10 px-sp-sm py-3 text-fs-sm !text-danger-300">
                {{ 'aacp.security.ban_rejected'|trans }}
            </div>
        {% endif %}

        <twig:cp:card padded="{{ true }}">
            <div class="aacp-security-posture">
                <div class="aacp-security-gauge {{ scoreTone }}"
                     style="--aacp-score: {{ score }}"
                     aria-label="{{ 'aacp.security.posture_score'|trans }}: {{ score }}/100">
                    <div class="aacp-security-gauge-ring" aria-hidden="true"></div>
                    <div class="aacp-security-gauge-value">
                        <span class="aacp-security-gauge-number" data-aacp-security-score-text>{{ score }}</span>
                        <span class="aacp-security-gauge-denom">/100</span>
                    </div>
                </div>

                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-start justify-between gap-sp-sm">
                        <div>
                            <p class="text-fs-sm font-semibold !text-slate-200">{{ 'aacp.security.posture_title'|trans }}</p>
                            <p class="mt-1 text-fs-sm !text-slate-400">{{ 'aacp.security.posture_desc'|trans }}</p>
                        </div>
                        <a href="{{ path('aacp_advanced_management', {tab: 'security'}) }}" class="btn btn-secondary btn-sm">
                            <twig:ux:icon name="heroicons:cog-6-tooth" class="h-4 w-4" />
                            {{ 'aacp.security.settings_cta'|trans }}
                        </a>
                    </div>

                    <div class="mt-sp-sm grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-5">
                        {% for severity, count in summary %}
                            {% set barPct = ((count / maxSeverity) * 100)|round %}
                            <div class="aacp-security-sev {{ severity }}">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-fs-xs font-medium uppercase tracking-wider opacity-80">{{ ('aacp.security.severity.' ~ severity)|trans }}</p>
                                    <p class="text-fs-lg font-semibold leading-none">{{ count }}</p>
                                </div>
                                <div class="aacp-security-sev-track" aria-hidden="true">
                                    <span class="aacp-security-sev-fill" style="width: {{ barPct }}%"></span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <p class="mt-sp-sm font-mono text-fs-xs !text-slate-500">
                        {{ 'aacp.security.posture_summary'|trans({'score': score, 'issues': issueTotal, 'passes': summary.pass|default(0)}) }}
                    </p>
                </div>
            </div>
        </twig:cp:card>

        <twig:cp:card title="{{ 'aacp.security.findings_title'|trans }}" padded="{{ false }}">
            <twig:cp:table headers="{{ [
                'aacp.security.column.severity'|trans,
                'aacp.security.column.check'|trans,
                'aacp.security.column.detail'|trans,
            ] }}" empty="{{ findings is empty }}" emptyText="{{ 'aacp.security.findings_empty'|trans }}">
                <twig:block name="rows">
                    {% for finding in findings %}
                        <tr>
                            <td class="align-top">
                                <span class="badge rounded-md border px-2 py-0.5 text-fs-xs {{ severityStyle[finding.severity]|default('') }}">
                                    {{ ('aacp.security.severity.' ~ finding.severity)|trans }}
                                </span>
                            </td>
                            <td class="align-top">
                                <span class="block font-medium !text-slate-200">{{ finding.titleKey|trans }}</span>
                                <span class="mt-0.5 block font-mono text-fs-xs !text-slate-500">{{ finding.id }}</span>
                            </td>
                            <td class="align-top !text-slate-400">{{ finding.detailKey|trans(finding.parameters) }}</td>
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:cp:table>
        </twig:cp:card>

        <twig:cp:card title="{{ 'aacp.security.twofactor_self_title'|trans }}">
            <p class="text-fs-sm !text-slate-400">
                {{ twoFactorEnrolled ? 'aacp.security.twofactor_self_on'|trans : 'aacp.security.twofactor_self_off'|trans }}
            </p>
            <p class="mt-sp-sm">
                <a href="/hesap/iki-adimli-kurulum" class="btn btn-secondary btn-sm">
                    <twig:ux:icon name="heroicons:device-phone-mobile" class="h-4 w-4" />
                    {{ twoFactorEnrolled ? 'aacp.security.twofactor_manage'|trans : 'aacp.security.twofactor_enroll'|trans }}
                </a>
            </p>
        </twig:cp:card>

        <div id="bans">
            <twig:cp:card title="{{ 'aacp.security.bans_title'|trans }}">
                <p class="mb-sp-sm text-fs-sm !text-slate-400">
                    {{ 'aacp.security.bans_desc'|trans({'total': banStats.total, 'automatic': banStats.automatic, 'expiring': banStats.expiring}) }}
                </p>

                <form method="post" action="{{ path('aacp_security_center_ban') }}" class="mb-sp-sm flex flex-wrap items-end gap-3">
                    <input type="hidden" name="_token" value="{{ action_token }}">
                    <div class="min-w-[200px] flex-1">
                        <label class="form-label !text-slate-400" for="ban-pattern">{{ 'aacp.security.ban_pattern'|trans }}</label>
                        <input type="text" id="ban-pattern" name="pattern" required placeholder="203.0.113.7 / 203.0.113.0/24"
                               class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                    </div>
                    <div class="w-32">
                        <label class="form-label !text-slate-400" for="ban-minutes">{{ 'aacp.security.ban_minutes'|trans }}</label>
                        <input type="number" id="ban-minutes" name="minutes" min="0" step="1" value="0"
                               class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                    </div>
                    <div class="min-w-[160px] flex-1">
                        <label class="form-label !text-slate-400" for="ban-reason">{{ 'aacp.security.ban_reason'|trans }}</label>
                        <input type="text" id="ban-reason" name="reason" maxlength="255"
                               class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                    </div>
                    <button type="submit" class="btn btn-danger">
                        <twig:ux:icon name="heroicons:no-symbol" class="h-4 w-4" />
                        {{ 'aacp.security.ban_submit'|trans }}
                    </button>
                </form>

                <twig:cp:table headers="{{ [
                    'aacp.security.column.pattern'|trans,
                    'aacp.security.column.source'|trans,
                    'aacp.security.column.reason'|trans,
                    'aacp.security.column.hits'|trans,
                    'aacp.security.column.expires'|trans,
                    'aacp.security.column.actions'|trans,
                ] }}" empty="{{ bans is empty }}" emptyText="{{ 'aacp.security.bans_empty'|trans }}">
                    <twig:block name="rows">
                        {% for ban in bans %}
                            <tr>
                                <td><span class="font-mono text-fs-xs !text-slate-200">{{ ban.ip_address }}</span></td>
                                <td>
                                    <span class="badge rounded-md border px-2 py-0.5 text-fs-xs {{ ban.source == 'auto' ? '!border-warning-500/30 !bg-warning-500/10 !text-warning-300' : '!border-white/10 !bg-white/5 !text-slate-300' }}">
                                        {{ ('aacp.security.source.' ~ ban.source)|trans }}
                                    </span>
                                </td>
                                <td class="!text-slate-400">{{ ban.reason|default('—') }}</td>
                                <td class="!text-slate-400">{{ ban.hit_count }}</td>
                                <td class="!text-slate-400">{{ ban.expires_at ?? 'aacp.security.ban_permanent'|trans }}</td>
                                <td>
                                    <form method="post" action="{{ path('aacp_security_center_unban', {id: ban.id}) }}">
                                        <input type="hidden" name="_token" value="{{ action_token }}">
                                        <button type="submit" class="text-fs-xs font-medium !text-slate-400 hover:!text-success-300">
                                            {{ 'aacp.security.unban'|trans }}
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </twig:block>
                </twig:cp:table>
            </twig:cp:card>
        </div>

        <div id="sessions">
            <twig:cp:card title="{{ 'aacp.security.sessions_title'|trans }}">
                <p class="mb-sp-sm text-fs-sm !text-slate-400">
                    {{ 'aacp.security.sessions_desc'|trans({'count': sessionCount}) }}
                </p>

                <twig:cp:table headers="{{ [
                    'aacp.security.column.user'|trans,
                    'aacp.security.column.ip'|trans,
                    'aacp.security.column.agent'|trans,
                    'aacp.security.column.last_seen'|trans,
                    'aacp.security.column.actions'|trans,
                ] }}" empty="{{ sessions is empty }}" emptyText="{{ 'aacp.security.sessions_empty'|trans }}">
                    <twig:block name="rows">
                        {% for session in sessions %}
                            <tr>
                                <td class="!text-slate-200">{{ session.email|default('—') }}</td>
                                <td><span class="font-mono text-fs-xs !text-slate-400">{{ session.ip_address }}</span></td>
                                <td class="max-w-[280px] truncate !text-slate-500" title="{{ session.user_agent }}">{{ session.user_agent }}</td>
                                <td class="!text-slate-400">{{ session.last_seen_at }}</td>
                                <td>
                                    <form method="post" action="{{ path('aacp_security_center_revoke_session', {id: session.id}) }}">
                                        <input type="hidden" name="_token" value="{{ action_token }}">
                                        <button type="submit" class="text-fs-xs font-medium !text-slate-400 hover:!text-danger-300">
                                            {{ 'aacp.security.revoke_session'|trans }}
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </twig:block>
                </twig:cp:table>
            </twig:cp:card>
        </div>
    </div>
{% endblock %}
