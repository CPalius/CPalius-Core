{#
    Studio appearance: the one place an administrator sets the look every
    Studio user sees: a theme (with a picture of it), light/dark, an accent
    colour and a typeface. Nothing here is per-user.
#}
{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.menu.studio_appearance'|trans }}{% endblock %}

{% set themeAccent = {premium: '#0F8F7E', classic: '#487FFF', ledger: '#1389B6'} %}

{% block body %}
    {% include 'aacp/_appearance_nav.html.twig' %}
    <style{{ csp_nonce_attr() }}>
        .pv { --pv: #0F8F7E; position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 10px; font-size: 0; }
        .pv * { box-sizing: border-box; }
        .pv i { position: absolute; display: block; font-style: normal; }
        /* Premium: ink rail, porcelain surface, soft cards. */
        .pv-premium { background: #f3f6f6; }
        .pv-premium .rail { inset: 0 auto 0 0; width: 24%; background: #1d2630; }
        .pv-premium .nav { left: 9%; width: 12%; height: 5%; border-radius: 3px; background: #ffffff22; }
        .pv-premium .nav.on { background: #ffffff26; box-shadow: inset 0 0 0 1px #ffffff12; }
        .pv-premium .dot { left: 20%; width: 2.2%; aspect-ratio: 1; border-radius: 50%; background: var(--pv); }
        .pv-premium .head { left: 24%; right: 0; top: 0; height: 13%; border-bottom: 1px solid #dfe5e6; background: #f3f6f6; }
        .pv-premium .ttl { left: 28%; top: 5%; width: 18%; height: 3.4%; border-radius: 3px; background: #1d2630; }
        .pv-premium .btn { right: 5%; top: 3.5%; width: 13%; height: 6.5%; border-radius: 4px; background: var(--pv); }
        .pv-premium .card { background: #fff; border: 1px solid #e3e8e9; border-radius: 6px; box-shadow: 0 1px 2px #1d263012, 0 6px 14px -8px #1d263030; }
        .pv-premium .row { height: 2.4%; border-radius: 2px; background: #dfe5e6; }
        .pv-premium .hl { background: color-mix(in oklab, var(--pv) 14%, white); border-radius: 4px; }
        /* Classic: light rail, filled pill, flat grey page. */
        .pv-classic { background: #f5f6fa; }
        .pv-classic .rail { inset: 0 auto 0 0; width: 24%; background: #fff; border-right: 1px solid #ebecef; }
        .pv-classic .nav { left: 8%; width: 14%; height: 5%; border-radius: 4px; background: #ebecef; }
        .pv-classic .nav.on { background: var(--pv); }
        .pv-classic .head { left: 24%; right: 0; top: 0; height: 13%; background: #fff; border-bottom: 1px solid #ebecef; }
        .pv-classic .ttl { left: 28%; top: 5%; width: 18%; height: 3.4%; border-radius: 3px; background: #374151; }
        .pv-classic .btn { right: 5%; top: 3.5%; width: 13%; height: 6.5%; border-radius: 5px; background: var(--pv); }
        .pv-classic .card { background: #fff; border: 1px solid #ebecef; border-radius: 6px; box-shadow: 0 1px 2px #0000000d; }
        .pv-classic .row { height: 2.4%; border-radius: 2px; background: #ebecef; }
        .pv-classic .hl { background: color-mix(in oklab, var(--pv) 14%, white); border-radius: 3px; }
        /* Ledger: ruled compartments, filled square marker. */
        .pv-ledger { background: #f9fafb; }
        .pv-ledger .rail { inset: 0 auto 0 0; width: 24%; background: #f1f3f4; border-right: 1px solid #cfc6a8; }
        .pv-ledger .nav { left: 12%; width: 11%; height: 3.4%; background: #d9dcde; }
        .pv-ledger .nav.on { background: #fff; box-shadow: inset 0 0 0 1px #d9d2bb; }
        .pv-ledger .dot { left: 7%; width: 2%; aspect-ratio: 1; background: var(--pv); }
        .pv-ledger .head { left: 24%; right: 0; top: 0; height: 13%; border-bottom: 1px solid #cfc6a8; }
        .pv-ledger .ttl { left: 28%; top: 5%; width: 18%; height: 3.4%; background: #20262b; }
        .pv-ledger .btn { right: 5%; top: 3.5%; width: 13%; height: 6.5%; border-radius: 1px; background: var(--pv); }
        .pv-ledger .card { background: transparent; border: 1px solid #cfc6a8; }
        .pv-ledger .row { height: 1px; background: #d9d2bb; }
        .pv-ledger .hl { background: color-mix(in oklab, var(--pv) 12%, transparent); }
        .st-theme:has(input:checked) { border-color: #35c2ae; box-shadow: 0 0 0 1px #35c2ae; }
        .st-swatch { display: block; width: 2rem; height: 2rem; border-radius: 50%; border: 0; }
        .st-pal:has(input:checked) .st-swatch { box-shadow: 0 0 0 2px #0f172a, 0 0 0 4px currentColor; }
        .pv-premium { --pv: {{ themeAccent.premium }}; }
        .pv-classic { --pv: {{ themeAccent.classic }}; }
        .pv-ledger { --pv: {{ themeAccent.ledger }}; }
        {% for id, hex in palettes %}
        #st-form:has(input[name=accent][value="{{ hex }}"]:checked) .pv { --pv: {{ hex }}; }
        {% endfor %}
    </style>

    <div class="space-y-sp-md">
        {% if saved %}
            <div class="rounded-lg border border-success-500/30 bg-success-500/10 px-sp-sm py-3 text-fs-sm !text-success-200">
                {{ 'aacp.studio_appearance.flash.saved'|trans }}
            </div>
        {% endif %}

        <form id="st-form" method="post" action="{{ path('aacp_studio_appearance_save') }}" class="space-y-sp-md">
            <input type="hidden" name="_token" value="{{ csrf_token }}">

            <twig:cp:card title="{{ 'aacp.studio_appearance.theme_title'|trans }}">
                <p class="mb-sp-sm text-fs-sm !text-slate-400">{{ 'aacp.studio_appearance.theme_desc'|trans }}</p>
                <div class="grid gap-sp-sm md:grid-cols-3">
                    {% for theme in themes %}
                        <label class="st-theme flex cursor-pointer flex-col gap-3 rounded-xl border border-white/10 p-3 transition hover:border-white/25">
                            <span class="pv pv-{{ theme }}" aria-hidden="true">
                                <i class="rail"></i><i class="head"></i><i class="ttl"></i><i class="btn"></i>
                                <i class="nav on" style="top: 20%"></i><i class="nav" style="top: 28%"></i><i class="nav" style="top: 36%"></i><i class="nav" style="top: 44%"></i>
                                {% if theme != 'classic' %}<i class="dot" style="top: 21.2%"></i>{% endif %}
                                <i class="card" style="left: 28%; top: 20%; width: 42%; height: 46%"></i>
                                <i class="row" style="left: 31%; top: 25%; width: 20%"></i>
                                <i class="row" style="left: 31%; top: 33%; width: 34%"></i>
                                <i class="row" style="left: 31%; top: 40%; width: 30%"></i>
                                <i class="row" style="left: 31%; top: 47%; width: 34%"></i>
                                <i class="row" style="left: 31%; top: 54%; width: 26%"></i>
                                <i class="card" style="left: 73%; top: 20%; width: 22%; height: 21%"></i>
                                <i class="hl" style="left: 74%; top: 24%; width: 20%; height: 6%"></i>
                                <i class="row" style="left: 75.5%; top: 34%; width: 12%"></i>
                                <i class="card" style="left: 73%; top: 45%; width: 22%; height: 21%"></i>
                                <i class="row" style="left: 75.5%; top: 50%; width: 14%"></i>
                                <i class="row" style="left: 75.5%; top: 57%; width: 10%"></i>
                            </span>
                            <span class="flex items-start gap-2">
                                <input type="radio" name="theme" value="{{ theme }}" class="mt-1" {{ current.theme == theme ? 'checked' : '' }}>
                                <span>
                                    <span class="block text-fs-sm font-semibold !text-slate-100">{{ ('aacp.studio_appearance.theme.' ~ theme)|trans }}</span>
                                    <span class="block text-fs-xs !text-slate-500">{{ ('aacp.studio_appearance.theme.' ~ theme ~ '_hint')|trans }}</span>
                                </span>
                            </span>
                        </label>
                    {% endfor %}
                </div>
            </twig:cp:card>

            <twig:cp:card title="{{ 'aacp.studio_appearance.palette_title'|trans }}">
                <p class="mb-sp-sm text-fs-sm !text-slate-400">{{ 'aacp.studio_appearance.palette_desc'|trans }}</p>
                {% set isPreset = false %}
                {% for id, hex in palettes %}{% if current.accent == hex %}{% set isPreset = true %}{% endif %}{% endfor %}
                <div class="flex flex-wrap items-start gap-sp-sm">
                    <label class="st-pal flex w-16 cursor-pointer flex-col items-center gap-1 text-center text-fs-xs" style="color: #94a3b8">
                        <input type="radio" name="accent" value="" class="sr-only" {{ current.accent == '' ? 'checked' : '' }}>
                        <span class="st-swatch" style="background: repeating-linear-gradient(45deg, #64748b 0 4px, #334155 4px 8px)"></span>
                        <span class="!text-slate-400">{{ 'aacp.studio_appearance.palette.default'|trans }}</span>
                    </label>
                    {% for id, hex in palettes %}
                        <label class="st-pal flex w-16 cursor-pointer flex-col items-center gap-1 text-center text-fs-xs" style="color: {{ hex }}">
                            <input type="radio" name="accent" value="{{ hex }}" class="sr-only" {{ current.accent == hex ? 'checked' : '' }}>
                            <span class="st-swatch" style="background: {{ hex }}"></span>
                            <span class="!text-slate-400">{{ ('aacp.studio_appearance.palette.' ~ id)|trans }}</span>
                        </label>
                    {% endfor %}
                    <label class="st-pal flex w-16 cursor-pointer flex-col items-center gap-1 text-center text-fs-xs" style="color: {{ current.accent ?: '#94a3b8' }}">
                        <input type="radio" name="accent" value="custom" class="sr-only" {{ current.accent != '' and not isPreset ? 'checked' : '' }}>
                        <input type="color" name="accent_custom" value="{{ (current.accent ?: '#0F8F7E')|lower }}" class="st-swatch cursor-pointer bg-transparent p-0">
                        <span class="!text-slate-400">{{ 'aacp.studio_appearance.palette.custom'|trans }}</span>
                    </label>
                </div>
            </twig:cp:card>

            <div class="grid gap-sp-md md:grid-cols-2">
                <twig:cp:card title="{{ 'aacp.studio_appearance.mode_title'|trans }}">
                    <div class="flex flex-wrap gap-sp-sm">
                        {% for mode in modes %}
                            <label class="flex cursor-pointer items-center gap-2 text-fs-sm !text-slate-200">
                                <input type="radio" name="mode" value="{{ mode }}" {{ current.mode == mode ? 'checked' : '' }}>
                                {{ ('aacp.studio_appearance.mode.' ~ mode)|trans }}
                            </label>
                        {% endfor %}
                    </div>
                    <p class="mt-2 text-fs-xs !text-slate-500">{{ 'aacp.studio_appearance.mode_hint'|trans }}</p>
                </twig:cp:card>

                <twig:cp:card title="{{ 'aacp.studio_appearance.font_title'|trans }}">
                    <select name="font" class="form-select w-full !border-white/10 !bg-dark-1 !text-slate-100">
                        <option value="">{{ 'aacp.studio_appearance.font.default'|trans }}</option>
                        {% for family in families %}
                            <option value="{{ family.slug }}" {{ current.font == family.slug ? 'selected' : '' }}>{{ family.name }}</option>
                        {% endfor %}
                    </select>
                    <p class="mt-2 text-fs-xs !text-slate-500">
                        {{ 'aacp.studio_appearance.font_hint'|trans }}
                        <a href="{{ path('aacp_fonts') }}" class="underline">{{ 'aacp.menu.fonts'|trans }}</a>
                    </p>
                </twig:cp:card>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="btn btn-primary">
                    <twig:ux:icon name="heroicons:check" class="h-4 w-4" />
                    {{ 'aacp.settings.save'|trans }}
                </button>
            </div>
        </form>
    </div>
{% endblock %}
