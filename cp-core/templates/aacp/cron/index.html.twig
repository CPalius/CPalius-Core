{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.cron.header'|trans }}{% endblock %}

{% block body %}
    <div class="space-y-sp-md">
        {% if app.request.query.get('errors') %}
            <div class="rounded-lg border border-danger-500/40 bg-danger-500/10 p-sp-sm text-fs-sm !text-danger-200">
                {{ app.request.query.get('errors') }}
            </div>
        {% endif %}
        {% if app.request.query.get('schedule_saved') or app.request.query.get('schedule_reset') %}
            <div class="rounded-lg border border-success-500/40 bg-success-500/10 p-sp-sm text-fs-sm !text-success-200">
                {{ 'aacp.cron.schedule_saved'|trans }}
            </div>
        {% endif %}

        <twig:cp:card title="{{ 'aacp.cron.endpoint.heading'|trans }}">
            <p class="text-fs-sm !text-slate-400">{{ 'aacp.cron.endpoint.intro'|trans }}</p>

            {% if endpoint.configured %}
                <div class="mt-sp-sm space-y-sp-sm">
                    <div>
                        <label class="mb-1 block text-fs-xs font-semibold uppercase tracking-wide !text-slate-500">
                            {{ 'aacp.cron.endpoint.url_label'|trans }}
                        </label>
                        <div class="flex gap-2">
                            <input type="text" readonly value="{{ endpoint.url }}"
                                   class="w-full rounded-lg bg-dark-1 px-sp-sm py-2 font-mono text-fs-xs !text-slate-300"
                                   data-cron-copy-source>
                            <button type="button" class="btn btn-secondary shrink-0" data-cron-copy>
                                {{ 'aacp.cron.endpoint.copy'|trans }}
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="mb-1 block text-fs-xs font-semibold uppercase tracking-wide !text-slate-500">
                            {{ 'aacp.cron.endpoint.crontab_label'|trans }}
                        </label>
                        <pre class="overflow-auto rounded-lg bg-dark-1 p-sp-sm font-mono text-fs-xs !text-slate-300">{{ endpoint.crontab }}</pre>
                        <p class="mt-1 text-fs-xs !text-slate-500">{{ 'aacp.cron.endpoint.crontab_hint'|trans }}</p>
                    </div>

                    <div>
                        <label class="mb-1 block text-fs-xs font-semibold uppercase tracking-wide !text-slate-500">
                            {{ 'aacp.cron.endpoint.cli_label'|trans }}
                        </label>
                        <pre class="overflow-auto rounded-lg bg-dark-1 p-sp-sm font-mono text-fs-xs !text-slate-300">{{ endpoint.cli }}</pre>
                    </div>
                </div>
            {% else %}
                <div class="mt-sp-sm rounded-lg border border-warning-500/40 bg-warning-500/10 p-sp-sm text-fs-sm !text-warning-200">
                    {{ 'aacp.cron.endpoint.token_missing'|trans }}
                </div>
            {% endif %}
        </twig:cp:card>

        <div class="flex justify-end">
            <a href="{{ path('aacp_cron_new') }}" class="btn btn-primary">
                {{ 'aacp.cron.new_job'|trans }}
            </a>
        </div>

        <twig:cp:card title="{{ 'aacp.cron.registered_tasks'|trans }}" padded="{{ false }}">
            <twig:cp:table headers="{{ [
                'aacp.cron.column.name'|trans,
                'aacp.cron.column.source'|trans,
                'aacp.cron.column.command'|trans,
                'aacp.cron.column.schedule'|trans,
                'aacp.cron.column.last_run'|trans,
                'aacp.cron.column.status'|trans,
                '',
            ] }}" empty="{{ tasks is empty }}">
                <twig:block name="rows">
                    {% for task in tasks %}
                        <tr data-cron-row="{{ task.codeBased ? 'code:' ~ task.jobName : 'db:' ~ task.id }}">
                            <td class="!text-slate-200">
                                {% if task.codeBased %}
                                    {% set cronLabelKey = 'aacp.cron.job.' ~ task.jobName %}
                                    {% set cronLabel = cronLabelKey|trans %}
                                    <span class="block">{{ cronLabel != cronLabelKey ? cronLabel : task.description|default(task.name) }}</span>
                                    <span class="mt-0.5 block font-mono text-fs-xs !text-slate-500">{{ task.jobName }}</span>
                                {% else %}
                                    <a href="{{ path('aacp_cron_edit', {id: task.id}) }}" class="hover:text-primary-400">{{ task.name }}</a>
                                {% endif %}
                            </td>
                            <td>
                                {% if task.codeBased %}
                                    <span class="badge badge-info">{{ 'aacp.cron.source_code'|trans }}</span>
                                {% else %}
                                    <span class="badge badge-neutral">{{ 'aacp.cron.source_manual'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="font-mono text-fs-xs !text-slate-500">
                                {% if task.codeBased %}
                                    {{ task.sourceDetail }}
                                {% else %}
                                    {{ task.commandName }}
                                {% endif %}
                            </td>
                            <td class="font-mono text-fs-xs !text-slate-400">
                                {% if task.codeBased %}
                                    {# The command stays in code; when it runs is the operator's call. #}
                                    <form method="post" action="{{ path('aacp_cron_code_schedule', {jobName: task.jobName}) }}"
                                          class="flex flex-wrap items-center gap-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                                        <input type="text" name="cron_expression" value="{{ task.cronExpression }}"
                                               placeholder="{{ task.declaredExpression }}"
                                               class="w-28 rounded bg-dark-1 px-2 py-1 font-mono text-fs-xs !text-slate-200">
                                        <label class="flex items-center gap-1 text-fs-xs !text-slate-400">
                                            <input type="checkbox" name="active" value="1" {{ task.active ? 'checked' : '' }}>
                                            {{ 'aacp.cron.active'|trans }}
                                        </label>
                                        <button type="submit" class="text-fs-xs font-medium !text-primary-400 hover:!text-success-300">
                                            {{ 'aacp.cron.save_schedule'|trans }}
                                        </button>
                                    </form>
                                    {% if task.rescheduled %}
                                        <form method="post" action="{{ path('aacp_cron_code_reset', {jobName: task.jobName}) }}" class="mt-1">
                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                            <button type="submit" class="text-fs-xs !text-slate-500 hover:!text-slate-300">
                                                {{ 'aacp.cron.reset_schedule'|trans({'default': task.declaredExpression}) }}
                                            </button>
                                        </form>
                                    {% endif %}
                                {% else %}
                                    {{ task.cronExpression }}
                                {% endif %}
                            </td>
                            <td class="text-fs-xs !text-slate-500" data-cron-last-run>
                                {% if task.codeBased %}
                                    {{ 'aacp.cron.not_tracked'|trans }}
                                {% else %}
                                    {{ task.lastRunAt ? task.lastRunAt|date('d.m.Y H:i') : 'aacp.cron.never_run'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <twig:cp:badge status="{{ task.active ? 'active' : 'inactive' }}" />
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-3">
                                    <button type="button"
                                            data-cron-run-button
                                            data-cron-type="{{ task.codeBased ? 'code' : 'db' }}"
                                            data-cron-id="{{ task.codeBased ? '' : task.id }}"
                                            data-cron-job-name="{{ task.codeBased ? task.jobName : '' }}"
                                            class="text-fs-xs font-medium !text-primary-400 hover:!text-success-300">
                                        {{ 'aacp.cron.run_now'|trans }}
                                    </button>
                                    {% if not task.codeBased %}
                                        <a href="{{ path('aacp_cron_edit', {id: task.id}) }}" class="text-fs-xs font-medium !text-slate-400 hover:!text-slate-200">
                                            {{ 'aacp.users.edit_action'|trans }}
                                        </a>
                                        <form method="post" action="{{ path('aacp_cron_delete', {id: task.id}) }}"
                                              onsubmit="return confirm('&quot;' + {{ task.name|json_encode|raw }} + '&quot; {{ 'aacp.cron.delete_confirm_suffix'|trans }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                                            <button type="submit" class="text-fs-xs font-medium !text-slate-400 hover:!text-danger-300">
                                                {{ 'aacp.cron.delete'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:cp:table>
        </twig:cp:card>

        <twig:cp:card title="{{ 'aacp.cron.run_console'|trans }}" padded="{{ true }}">
            <pre id="cp-cron-console" class="max-h-96 min-h-[6rem] overflow-auto whitespace-pre-wrap rounded-lg bg-dark-1 p-sp-sm font-mono text-fs-xs text-success-400">{{ 'aacp.cron.console_hint'|trans }}</pre>
        </twig:cp:card>
    </div>

    <script{{ csp_nonce_attr() }}>
        (function () {
            const copyButton = document.querySelector('[data-cron-copy]');
            const copySource = document.querySelector('[data-cron-copy-source]');
            if (copyButton && copySource) {
                const copiedLabel = {{ 'aacp.cron.endpoint.copied'|trans|json_encode|raw }};
                copyButton.addEventListener('click', function () {
                    copySource.select();
                    // execCommand is the fallback: navigator.clipboard needs a
                    // secure context, and plenty of these panels run on plain http.
                    const done = navigator.clipboard
                        ? navigator.clipboard.writeText(copySource.value)
                        : Promise.resolve(document.execCommand('copy'));
                    Promise.resolve(done).then(function () {
                        const original = copyButton.textContent;
                        copyButton.textContent = copiedLabel;
                        setTimeout(function () { copyButton.textContent = original; }, 1500);
                    });
                });
            }

            const csrfToken = {{ csrf_token|json_encode|raw }};
            const consoleEl = document.getElementById('cp-cron-console');
            const runningLabel = {{ 'aacp.cron.js.running'|trans|json_encode|raw }};
            const executingLabel = {{ 'aacp.cron.js.executing'|trans|json_encode|raw }};
            const successLabel = {{ 'aacp.cron.js.success'|trans|json_encode|raw }};
            const failureLabel = {{ 'aacp.cron.js.failure'|trans|json_encode|raw }};
            const noOutputLabel = {{ 'aacp.cron.js.no_output'|trans|json_encode|raw }};
            const requestFailedLabel = {{ 'aacp.cron.js.request_failed'|trans|json_encode|raw }};

            document.querySelectorAll('[data-cron-run-button]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const type = button.getAttribute('data-cron-type');
                    const id = button.getAttribute('data-cron-id');
                    const jobName = button.getAttribute('data-cron-job-name');
                    const row = button.closest('[data-cron-row]');

                    button.disabled = true;
                    const originalText = button.textContent;
                    button.textContent = runningLabel;
                    consoleEl.textContent = executingLabel + ' ' + (type === 'code' ? jobName : ('#' + id)) + ' ...';

                    const body = new URLSearchParams();
                    body.set('_token', csrfToken);
                    body.set('type', type);
                    if (type === 'db') {
                        body.set('id', id);
                    } else {
                        body.set('jobName', jobName);
                    }

                    fetch('{{ path('aacp_cron_run_now_ajax') }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString(),
                    })
                        .then(function (response) { return response.json(); })
                        .then(function (data) {
                            consoleEl.textContent = (data.success ? '[' + successLabel + ']\n' : '[' + failureLabel + ']\n') + (data.output || noOutputLabel);
                            if (data.lastRunAt && row) {
                                const lastRunCell = row.querySelector('[data-cron-last-run]');
                                if (lastRunCell) {
                                    lastRunCell.textContent = data.lastRunAt;
                                }
                            }
                        })
                        .catch(function (error) {
                            consoleEl.textContent = requestFailedLabel + ': ' + error;
                        })
                        .finally(function () {
                            button.disabled = false;
                            button.textContent = originalText;
                        });
                });
            });
        })();
    </script>
{% endblock %}
