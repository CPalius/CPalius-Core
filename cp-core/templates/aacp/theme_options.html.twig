{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.menu.theme_options'|trans }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('aacp_themes') }}" class="btn btn-sm btn-neutral">{{ 'aacp.menu.themes'|trans }}</a>
{% endblock %}

{% block body %}
    {% if saved %}
        <p class="mb-4 text-fs-sm text-emerald-300">{{ 'aacp.appearance.saved'|trans }}</p>
    {% endif %}
    {% if error %}
        <p class="mb-4 text-fs-sm text-red-300">{{ error|trans }}</p>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="space-y-sp-md lg:w-[61.8%]">
        <input type="hidden" name="_token" value="{{ csrf_token }}">

        <twig:cp:card title="{{ 'aacp.appearance.brand'|trans }}">
            <div class="grid gap-4">
                {% for slot in ['logo', 'favicon', 'og'] %}
                    <div>
                        <label class="form-label">{{ ('aacp.appearance.' ~ slot)|trans }}</label>
                        {% if appearance[slot] %}
                            <img src="{{ appearance[slot] }}" alt="" class="mb-2 max-h-16 rounded bg-white p-1">
                        {% endif %}
                        <input type="file" name="{{ slot }}" accept="image/png,image/jpeg,image/webp,image/gif,image/x-icon" class="form-control">
                        {% if slot != 'og' or appearance.og %}
                            <label class="mt-2 flex items-center gap-2 text-fs-xs !text-slate-400">
                                <input type="checkbox" name="clear_{{ slot }}" value="1"> {{ 'aacp.appearance.clear'|trans }}
                            </label>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </twig:cp:card>

        <twig:cp:card title="{{ 'aacp.appearance.layout'|trans }}">
            <div class="grid gap-3 sm:grid-cols-2">
                {% for name, meta in metrics %}
                    <label>
                        <span class="form-label">{{ ('aacp.appearance.metric.' ~ name)|trans }}</span>
                        <input type="number" name="metrics[{{ name }}]" value="{{ appearance.metrics[name] }}" min="{{ meta.min }}" max="{{ meta.max }}" class="form-control">
                    </label>
                {% endfor %}
            </div>
            <p class="mt-3 text-fs-xs !text-slate-400">{{ 'aacp.appearance.metric.logo_width_help'|trans }}</p>
        </twig:cp:card>

        {% set groups = {accent: 'aacp.appearance.group.accent', surface: 'aacp.appearance.group.surface', text: 'aacp.appearance.group.text', status: 'aacp.appearance.group.status'} %}
        {% for group, label in groups %}
            <twig:cp:card title="{{ label|trans }}">
                <div class="grid gap-3 sm:grid-cols-2">
                    {% for name, meta in palette %}
                        {% if meta.group == group %}
                            <label class="flex items-center justify-between gap-3 rounded-lg border border-white/10 px-3 py-2">
                                <span class="text-fs-sm !text-slate-200">{{ ('aacp.appearance.color.' ~ name)|trans }}</span>
                                <input type="color" name="colors[{{ name }}]" value="{{ appearance.colors[name] }}">
                            </label>
                        {% endif %}
                    {% endfor %}
                </div>
            </twig:cp:card>
        {% endfor %}

        <button type="submit" class="btn btn-primary">{{ 'aacp.settings.save'|trans }}</button>
    </form>
{% endblock %}
