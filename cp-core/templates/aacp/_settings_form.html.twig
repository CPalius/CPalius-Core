{#
    "Modül Ayarları" ve "Eklenti Ayarları" ekranlarının paylaştığı ortak
    form gövdesi (eskiden tek "aacp/settings.html.twig" olan içerik burada
    tek bir yerde toplanır, iki sayfa arasında kopyala-yapıştır tekrarı
    OLMAZ).

    Beklenen değişkenler (çağıran şablon tarafından sağlanır):
      settingGroups (array<string, list<SettingDefinition>>)
      currentValues (array<string, mixed>)
      csrf_token    (string)
      redirectTo    (string) Kaydettikten sonra dönülecek yol (bu sayfanın kendisi).
#}
<form method="post" action="{{ path('aacp_settings_update') }}" class="space-y-sp-md lg:w-[61.8%]">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <input type="hidden" name="_redirect" value="{{ redirectTo }}">

    {% if app.request.query.get('invalid_setting') %}
        <div class="toast toast-error">
            {{ 'aacp.settings.invalid_value'|trans({key: app.request.query.get('invalid_setting')}) }}
        </div>
    {% endif %}

    {% if settingGroups is empty %}
        <twig:cp:card>
            <p class="text-fs-sm text-slate-500">{{ 'aacp.settings.no_settings'|trans }}</p>
        </twig:cp:card>
    {% endif %}

    {% for groupName, settingDefs in settingGroups %}
        <twig:cp:card title="{{ groupName|capitalize }}">
            <div class="space-y-sp-sm">
                {% for setting in settingDefs %}
                    <div>
                        <label class="form-label !text-slate-400">{{ setting.label }}</label>

                        {% if setting.type == 'checkbox' %}
                            <label class="inline-flex items-center gap-2 text-fs-sm !text-slate-300">
                                <input type="checkbox" name="settings[{{ setting.key }}]" value="1"
                                       {{ currentValues[setting.key] ? 'checked' : '' }}
                                       class="form-check-input h-4 w-4 !border-white/10 !bg-dark-1 text-primary-500 focus:ring-primary-500/40">
                            </label>
                        {% elseif setting.type == 'select' %}
                            <select name="settings[{{ setting.key }}]"
                                    class="form-select !border-white/10 !bg-dark-1 !text-slate-100">
                                {% for value, label in setting.variants %}
                                    <option value="{{ value }}" {{ currentValues[setting.key] == value ? 'selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        {% elseif setting.type == 'textarea' %}
                            <textarea name="settings[{{ setting.key }}]" rows="3"
                                      class="form-control !border-white/10 !bg-dark-1 !text-slate-100">{{ currentValues[setting.key] }}</textarea>
                        {% elseif setting.type == 'integer' %}
                            <input type="number" step="1" name="settings[{{ setting.key }}]" value="{{ currentValues[setting.key] }}"
                                   class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                        {% else %}
                            <input type="text" name="settings[{{ setting.key }}]" value="{{ currentValues[setting.key] }}"
                                   class="form-control !border-white/10 !bg-dark-1 !text-slate-100">
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </twig:cp:card>
    {% endfor %}

    <button type="submit" class="btn btn-primary">
        {{ 'aacp.settings.save'|trans }}
    </button>
</form>
