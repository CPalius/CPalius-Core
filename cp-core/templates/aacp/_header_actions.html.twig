{#
    AACP chrome: search, locale, notifications, profile. Included outside
    header_actions so page buttons cannot hide the menu.
#}
{{ include('admin/_live_search.html.twig', {panel: 'aacp', dark: true}) }}

<div class="dropdown">
    <button type="button" data-dropdown-trigger="aacp-locale-menu"
            class="header-icon-btn !bg-dark-1 !text-slate-300 hover:!bg-white/5" title="{{ 'aacp.layout.header.locale'|trans }}">
        <twig:ux:icon name="tabler:language" class="h-5 w-5" />
    </button>
    <div id="aacp-locale-menu" class="dropdown-menu !bg-dark-2 !border !border-white/10 end-0">
        {% for locale in cp_locales() %}
            <a href="{{ path('aacp_locale_switch', {locale: locale.code}) }}"
               class="!text-slate-300 hover:!bg-white/5{{ app.request.locale == locale.code ? ' !text-primary-300' : '' }}"
               lang="{{ locale.code }}">
                {{ locale.nativeName }}
                <span class="ms-1 font-mono text-fs-xs uppercase !text-slate-600">{{ locale.code }}</span>
            </a>
        {% endfor %}
    </div>
</div>

{{ include('admin/_notification_bell.html.twig', {dark: true}) }}

<div class="dropdown">
    <button type="button" data-dropdown-trigger="aacp-profile-menu"
            class="flex items-center gap-2 rounded-full !bg-dark-1 !border !border-white/10 py-1 pe-3 ps-1 hover:!bg-white/5">
        {% set avatarUrl = cp_current_user_avatar_url() %}
        {% if avatarUrl %}
            <img src="{{ avatarUrl }}" alt="" class="h-7 w-7 rounded-full object-cover">
        {% else %}
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary-500/20 text-fs-xs font-semibold text-primary-300">
                {{ app.user ? app.user.fullName|slice(0, 1)|upper : '?' }}
            </span>
        {% endif %}
        <span class="hidden text-fs-sm text-slate-300 sm:inline">{{ app.user ? app.user.fullName : '' }}</span>
    </button>
    <div id="aacp-profile-menu" class="dropdown-menu !bg-dark-2 !border !border-white/10 end-0">
        <a href="{{ path('aacp_users_profile') }}" class="!text-slate-300 hover:!bg-white/5">
            <twig:ux:icon name="tabler:user-circle" class="h-4 w-4" />
            {{ 'aacp.layout.header.my_profile'|trans }}
        </a>
        <a href="{{ path('site_home') }}" target="_blank" rel="noopener" class="!text-slate-300 hover:!bg-white/5">
            <twig:ux:icon name="tabler:external-link" class="h-4 w-4" />
            {{ 'aacp.layout.header.go_website'|trans }}
        </a>
        {% if is_granted('admin.access') %}
            <a href="{{ path('admin_dashboard') }}" class="!text-slate-300 hover:!bg-white/5">
                <twig:ux:icon name="tabler:layout-dashboard" class="h-4 w-4" />
                {{ 'aacp.layout.header.go_studio'|trans }}
            </a>
        {% endif %}
        <a href="{{ path('admin_logout') }}" class="!text-danger-400 hover:!bg-danger-500/10">
            <twig:ux:icon name="tabler:logout" class="h-4 w-4" />
            {{ 'aacp.layout.header.logout'|trans }}
        </a>
    </div>
</div>
