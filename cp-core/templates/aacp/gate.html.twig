{#
    Panel gate question. Deliberately standalone: the AACP layout renders the
    admin menu, and the point of this screen is that the panel is not open yet.
#}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ 'aacp.gate.title'|trans }}</title>
        <meta name="robots" content="noindex, nofollow">
        <link rel="stylesheet" href="{{ cp_asset('styles/app.css') }}">
    </head>
    <body class="h-full bg-dark-1 text-slate-100 antialiased text-fs-base font-sans">
        <main class="flex min-h-full items-center justify-center px-sp-sm py-sp-lg">
            <div class="w-full max-w-md space-y-sp-sm">
                <div class="flex items-center gap-3">
                    <img src="/CPalius.png" alt="CPalius" class="h-7 w-auto shrink-0">
                    <div class="leading-tight">
                        <p class="text-fs-sm font-semibold !text-slate-100">{{ 'aacp.layout.brand.name'|trans }}</p>
                        <p class="text-fs-xs !text-slate-500">{{ 'aacp.gate.subtitle'|trans }}</p>
                    </div>
                </div>

                <div class="rounded-xl border border-white/10 !bg-dark-2 p-sp-md shadow-lg">
                    <h1 class="text-fs-lg font-semibold !text-slate-100">{{ 'aacp.gate.heading'|trans }}</h1>
                    <p class="mt-1 text-fs-sm !text-slate-400">{{ 'aacp.gate.desc'|trans }}</p>

                    {% if error %}
                        <p class="mt-sp-sm rounded-lg border border-danger-500/30 !bg-danger-500/10 px-3 py-2 text-fs-sm !text-danger-200">
                            {{ error }}
                            {% if lockedMinutes > 0 %}
                                {{ 'aacp.gate.locked_minutes'|trans({'minutes': lockedMinutes}) }}
                            {% endif %}
                        </p>
                    {% endif %}

                    {% if lockedMinutes > 0 %}
                        <p class="mt-sp-sm text-fs-sm !text-slate-400">{{ 'aacp.gate.locked_hint'|trans }}</p>
                    {% else %}
                        <form method="post" action="{{ path('aacp_gate') }}" class="mt-sp-sm space-y-sp-sm">
                            <div>
                                <label class="form-label !text-slate-400" for="aacp-gate-answer">{{ question }}</label>
                                <input type="text"
                                       id="aacp-gate-answer"
                                       name="answer"
                                       required
                                       autofocus
                                       autocomplete="off"
                                       spellcheck="false"
                                       class="form-control w-full !border-white/10 !bg-dark-1 !text-slate-100">
                            </div>

                            <input type="hidden" name="_token" value="{{ csrf_token }}">
                            <input type="hidden" name="next" value="{{ next }}">

                            <div class="flex items-center justify-between gap-3">
                                <p class="text-fs-xs !text-slate-500">
                                    {% if remaining > 0 %}{{ 'aacp.gate.remaining'|trans({'count': remaining}) }}{% endif %}
                                </p>
                                <button type="submit" class="btn btn-primary">{{ 'aacp.gate.submit'|trans }}</button>
                            </div>
                        </form>
                    {% endif %}
                </div>

                <p class="text-center text-fs-xs !text-slate-600">
                    <a href="{{ path('admin_logout') }}" class="!text-slate-500 hover:!text-slate-300 underline">{{ 'aacp.gate.sign_out'|trans }}</a>
                </p>
            </div>
        </main>
    </body>
</html>
