{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.plugins.header'|trans }}{% endblock %}

{% block javascripts %}
    {{ importmap(['app', 'studio-quick-cache-clear', 'aacp-plugins']) }}
{% endblock %}

{% block body %}
    <div class="space-y-sp-md" data-plugin-toggle-root data-plugin-toggle-csrf="{{ csrf_token }}"
         data-i18n-active="{{ 'aacp.plugins.active'|trans }}"
         data-i18n-inactive="{{ 'aacp.plugins.inactive'|trans }}"
         data-i18n-deactivate="{{ 'aacp.plugins.deactivate'|trans }}"
         data-i18n-activate="{{ 'aacp.plugins.activate'|trans }}">
        <twig:cp:card title="{{ 'aacp.plugins.registered_plugins'|trans }}" padded="{{ false }}">
            <twig:cp:table headers="{{ [
                'aacp.plugins.column.name'|trans,
                'aacp.plugins.column.identifier'|trans,
                'aacp.plugins.column.status'|trans,
                '',
            ] }}" empty="{{ plugins is empty }}">
                <twig:block name="rows">
                    {% for plugin in plugins %}
                        <tr data-plugin-row="{{ plugin.name }}">
                            <td class="!text-slate-200">{{ plugin.label|trans }}</td>
                            <td class="font-mono text-fs-xs !text-slate-500">{{ plugin.name }}</td>
                            <td>
                                <span data-plugin-status class="badge {{ plugin.active ? 'badge-success' : 'badge-neutral' }}">
                                    {{ plugin.active ? 'aacp.plugins.active'|trans : 'aacp.plugins.inactive'|trans }}
                                </span>
                            </td>
                            <td class="text-right">
                                <button type="button"
                                        data-plugin-toggle
                                        data-plugin-name="{{ plugin.name }}"
                                        data-plugin-active="{{ plugin.active ? '1' : '0' }}"
                                        class="text-fs-xs font-medium {{ plugin.active ? '!text-slate-400 hover:!text-danger-300' : '!text-primary-400 hover:!text-success-300' }}">
                                    {{ plugin.active ? 'aacp.plugins.deactivate'|trans : 'aacp.plugins.activate'|trans }}
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:cp:table>
        </twig:cp:card>
    </div>
{% endblock %}
