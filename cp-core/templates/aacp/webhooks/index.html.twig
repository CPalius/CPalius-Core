{% extends 'aacp/layout.html.twig' %}

{% block header %}{{ 'aacp.webhooks.header'|trans }}{% endblock %}

{% block body %}
    <div class="space-y-sp-md">
        {% if revealedSecret %}
            <div class="rounded-lg border border-primary-500/40 bg-primary-500/5 p-sp-sm">
                <p class="text-fs-xs font-semibold uppercase tracking-wide !text-primary-400">{{ 'aacp.webhooks.reveal_notice'|trans }}</p>
                <p class="mt-2 break-all rounded-lg bg-dark-1 px-3 py-2 font-mono text-fs-sm text-slate-100">{{ revealedSecret }}</p>
                <p class="mt-2 text-fs-xs !text-slate-500">{{ 'aacp.webhooks.reveal_hint'|trans }}</p>
            </div>
        {% endif %}

        {% if app.request.query.get('error') %}
            <div class="toast toast-error">{{ app.request.query.get('error') }}</div>
        {% endif %}

        <div class="flex items-center justify-between">
            <p class="text-fs-sm !text-slate-500">{{ 'aacp.webhooks.intro'|trans }}</p>
            <a href="{{ path('aacp_webhooks_new') }}" class="btn btn-primary">{{ 'aacp.webhooks.new_action'|trans }}</a>
        </div>

        <twig:cp:card title="{{ 'aacp.webhooks.registered'|trans }}" padded="{{ false }}">
            <twig:cp:table headers="{{ [
                'aacp.webhooks.column.label'|trans,
                'aacp.webhooks.column.url'|trans,
                'aacp.webhooks.column.events'|trans,
                'aacp.webhooks.column.secret'|trans,
                'aacp.webhooks.column.status'|trans,
                '',
            ] }}" empty="{{ subscriptions is empty }}" emptyText="{{ 'aacp.webhooks.empty'|trans }}">
                <twig:block name="rows">
                    {% for subscription in subscriptions %}
                        <tr class="{{ subscription.id == revealedForId ? 'bg-primary-500/5' : '' }}">
                            <td class="!text-slate-200">
                                <a href="{{ path('aacp_webhooks_edit', {id: subscription.id}) }}" class="hover:text-primary-400">{{ subscription.label }}</a>
                            </td>
                            <td class="max-w-xs truncate font-mono text-fs-xs !text-slate-500" title="{{ subscription.url }}">{{ subscription.url }}</td>
                            <td class="text-fs-xs !text-slate-400">
                                <div class="flex flex-wrap gap-1">
                                    {% for event in subscription.events %}
                                        <span class="badge badge-neutral font-mono">{{ event }}</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="font-mono text-fs-xs !text-slate-500">••••{{ subscription.secretLast4 }}</td>
                            <td>
                                {% if subscription.quarantined %}
                                    <twig:cp:badge status="quarantined" label="{{ 'aacp.webhooks.status.quarantined'|trans }}" />
                                    <span class="ml-1 text-fs-xs !text-slate-500">({{ subscription.consecutiveFailures }})</span>
                                {% elseif subscription.active %}
                                    <twig:cp:badge status="active" label="{{ 'aacp.webhooks.status.active'|trans }}" />
                                {% else %}
                                    <twig:cp:badge status="inactive" label="{{ 'aacp.webhooks.status.inactive'|trans }}" />
                                {% endif %}
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-3">
                                    <a href="{{ path('aacp_webhooks_edit', {id: subscription.id}) }}" class="text-fs-xs font-medium !text-slate-400 hover:!text-slate-200">
                                        {{ 'aacp.users.edit_action'|trans }}
                                    </a>
                                    <form method="post" action="{{ path('aacp_webhooks_rotate', {id: subscription.id}) }}"
                                          onsubmit="return confirm({{ 'aacp.webhooks.rotate_confirm'|trans|json_encode|raw }});">
                                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                                        <button type="submit" class="text-fs-xs font-medium !text-slate-400 hover:!text-primary-300">{{ 'aacp.webhooks.rotate_action'|trans }}</button>
                                    </form>
                                    <form method="post" action="{{ path('aacp_webhooks_toggle', {id: subscription.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                                        <button type="submit" class="text-fs-xs font-medium {{ subscription.active ? '!text-slate-400 hover:!text-danger-300' : '!text-primary-400 hover:!text-success-300' }}">
                                            {{ subscription.active ? 'aacp.webhooks.deactivate'|trans : 'aacp.webhooks.activate'|trans }}
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('aacp_webhooks_delete', {id: subscription.id}) }}"
                                          onsubmit="return confirm({{ 'aacp.webhooks.delete_confirm'|trans|json_encode|raw }});">
                                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                                        <button type="submit" class="text-fs-xs font-medium !text-slate-400 hover:!text-danger-300">{{ 'aacp.webhooks.delete'|trans }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </twig:block>
            </twig:cp:table>
        </twig:cp:card>

        <p class="text-fs-xs !text-slate-600">{{ 'aacp.webhooks.quarantine_note'|trans({'count': quarantineAfter}) }}</p>
    </div>
{% endblock %}
