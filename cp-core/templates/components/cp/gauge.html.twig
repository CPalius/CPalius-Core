{#
    <twig:cp:gauge value="{{ 42.5 }}" max="{{ 100 }}" label="CPU" unit="%" />

    htop-style thin bar gauge for AACP dark/terminal aesthetic — threshold-based glow colors.

    Props: value, max, label, unit
#}
{% props value = 0, max = 100, label = null, unit = '' %}

{% set pct = max > 0 ? min(100, (value / max) * 100) : 0 %}
{% set barColor = pct > 85
    ? 'bg-danger-500 shadow-[0_0_8px_rgba(239,68,68,0.6)]'
    : (pct > 60 ? 'bg-warning-400 shadow-[0_0_6px_rgba(251,191,36,0.5)]' : 'bg-primary-500 shadow-[0_0_8px_rgba(72,127,255,0.55)]') %}

<div {{ attributes.defaults({class: 'space-y-1.5'}) }}>
    {% if label %}
        <div class="flex items-center justify-between text-fs-xs uppercase tracking-wide text-slate-500">
            <span>{{ label }}</span>
            <span class="font-mono text-slate-300">{{ value }}{{ unit }}</span>
        </div>
    {% endif %}
    <div class="h-2 w-full overflow-hidden rounded-full bg-dark-1 ring-1 ring-white/10">
        <div class="h-full rounded-full transition-all duration-500 {{ barColor }}" style="width: {{ pct }}%"></div>
    </div>
</div>
