{#
    <twig:studio:table headers="['Title', 'Status', '']">...</twig:studio:table>

    Studio (light theme) counterpart of twig:cp:table — see studio/card isolation note.

    Props: headers, empty, emptyText
#}
{% props headers = [], empty = false, emptyText = null %}

<div {{ attributes.defaults({class: 'table-responsive'}) }}>
    <table class="table">
        {% if headers is not empty %}
            <thead>
                <tr>
                    {% for header in headers %}
                        <th>{{ header }}</th>
                    {% endfor %}
                </tr>
            </thead>
        {% endif %}
        <tbody>
            {% if empty %}
                <tr>
                    <td colspan="{{ headers|length > 0 ? headers|length : 1 }}" class="py-6 text-center text-fs-sm text-neutral-500">
                        {{ emptyText ?? 'studio.table.empty_default'|trans }}
                    </td>
                </tr>
            {% else %}
                {% block rows %}{% endblock %}
            {% endif %}
        </tbody>
    </table>
</div>
