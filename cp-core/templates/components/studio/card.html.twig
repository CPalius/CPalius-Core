{#
    <twig:studio:card title="Posts">...</twig:studio:card>

    Light-theme counterpart of twig:cp:card — separate files, not variants (AACP/Studio isolation).

    Props: title, variant ('default'|'danger'), padded
#}
{% props title = null, variant = 'default', padded = true %}

<div {{ attributes.defaults({class: 'card ' ~ (variant == 'danger' ? '!border-danger-300' : '') }) }}>
    {% if title is not null %}
        <div class="card-header {{ variant == 'danger' ? '!bg-danger-50' : '' }}">
            <h3 class="text-fs-sm font-semibold tracking-wide {{ variant == 'danger' ? 'text-danger-700' : 'text-neutral-900' }}">
                {{ title }}
            </h3>
            {% block actions %}{% endblock %}
        </div>
    {% endif %}

    <div class="{{ padded ? 'card-body' : '' }}">
        {% block content %}{% endblock %}
    </div>
</div>
