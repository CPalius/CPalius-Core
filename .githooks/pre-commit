#!/bin/sh
#
# CPalius CMF — pre-commit guard
#
# WHY THIS EXISTS
# A bulk-edit script once wrote the null result of a failed regex over thirteen
# integration test files, emptying every one of them. Nothing caught it: the
# files were untracked, so git had no earlier copy, and PHP still parses an
# empty file without complaint. The work was gone.
#
# This hook makes that specific accident impossible to commit, and blocks the
# two other ways real content gets destroyed quietly: a secret going public,
# and a source file collapsing to a fraction of its size.
#
# Install once:
#     git config core.hooksPath .githooks
#
# Bypass (only when you genuinely mean it):
#     git commit --no-verify

set -eu

fail() {
    printf '\n\033[41;37m COMMIT BLOCKED \033[0m %s\n\n' "$1" >&2
    exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACM)

[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------
# 1. Empty files that are not meant to be empty.
#
# A .php, .twig, .yaml or .neon file with no bytes is never intentional here;
# it is the signature of a write that received null or an interrupted process.
# ---------------------------------------------------------------------------
emptied=""
for file in $staged; do
    case "$file" in
        *.php|*.twig|*.yaml|*.yml|*.neon|*.md) ;;
        *) continue ;;
    esac

    [ -f "$file" ] || continue

    if [ ! -s "$file" ]; then
        emptied="$emptied  $file\n"
    fi
done

if [ -n "$emptied" ]; then
    printf '\n\033[41;37m COMMIT BLOCKED \033[0m These staged files are empty (0 bytes):\n\n' >&2
    printf "$emptied" >&2
    printf '\nAn empty source file is almost always a failed write, not a decision.\n' >&2
    printf 'Restore them, or use --no-verify if you really mean to commit nothing.\n\n' >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 1b. Anything before the PHP open tag.
#
# A single space before "<?php" makes the file fatal ("strict_types declaration
# must be the very first statement") while looking perfectly normal in an
# editor. It has happened three times in this repository, each time costing a
# confusing debugging session, and each time introduced by a tool rather than a
# person. One byte is all it takes.
# ---------------------------------------------------------------------------
dirty=""
for file in $staged; do
    case "$file" in
        *.php) ;;
        *) continue ;;
    esac

    [ -f "$file" ] || continue

    first=$(head -c 1 "$file" | od -An -tx1 | tr -d ' \n')

    # 3c is "<". Anything else means a byte-order mark or stray whitespace.
    if [ "$first" != "3c" ]; then
        dirty="$dirty  $file (first byte 0x$first)\n"
    fi
done

if [ -n "$dirty" ]; then
    printf '\n\033[41;37m COMMIT BLOCKED \033[0m These PHP files have something before the open tag:\n\n' >&2
    printf "$dirty" >&2
    printf '\nPHP will refuse to parse them. Strip the leading bytes.\n\n' >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Secrets.
#
# .env is gitignored, but an ignore rule only protects the paths someone
# thought of. This catches the file itself arriving under any name.
# ---------------------------------------------------------------------------
for file in $staged; do
    case "$file" in
        .env|.env.local|.env.*.local|*/.env|*.pem|*.key|*.p12|*.pfx)
            fail "Refusing to commit what looks like a secret: $file"
            ;;
    esac
done

# ---------------------------------------------------------------------------
# 3. Tracked files that lost most of their content.
#
# A file shrinking by more than 80% is either a deliberate rewrite or the same
# failed-write accident caught above, one step earlier. Either way it deserves
# a human's eyes before it enters history.
# ---------------------------------------------------------------------------
shrunk=""
for file in $staged; do
    case "$file" in
        *.php|*.twig|*.yaml|*.yml) ;;
        *) continue ;;
    esac

    git cat-file -e "HEAD:$file" 2>/dev/null || continue

    before=$(git cat-file -s "HEAD:$file" 2>/dev/null || echo 0)
    after=$(git cat-file -s ":$file" 2>/dev/null || echo 0)

    # Ignore small files: percentages are meaningless at a few hundred bytes.
    [ "$before" -lt 500 ] && continue

    if [ "$((after * 5))" -lt "$before" ]; then
        shrunk="$shrunk  $file ($before -> $after bytes)\n"
    fi
done

if [ -n "$shrunk" ]; then
    printf '\n\033[43;30m COMMIT BLOCKED \033[0m These files lost over 80%% of their content:\n\n' >&2
    printf "$shrunk" >&2
    printf '\nIf this is a deliberate rewrite, commit with --no-verify.\n\n' >&2
    exit 1
fi

exit 0
