###> CPALIUS: SYSTEM SETTINGS <###
CP_APP_NAME="CPalius CMF"
CP_APP_VERSION="1.0.0"
# verbose (hata veren modülleri detaylı göster) | safe (hata vereni sessizce karantinaya al)
# Canlıda "safe" kullanın: "verbose" modül hatalarının ayrıntısını dışarıya gösterir.
CP_APP_DEBUG_LEVEL="safe"

# AACP kurtarma token'ı. Boşsa kapı kapalıdır. Üret: php -r "echo bin2hex(random_bytes(32));"
AACP_RECOVERY_TOKEN=

# HTTP cron token'ı. Boşsa uç kapalıdır. Üret: php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=
###< CPALIUS: SYSTEM SETTINGS <###

###> SYMFONY: SYSTEM ENVIRONMENT <###
# Varsayılan prod. Yerel geliştirme için "dev" yapın; canlıda ASLA "dev" bırakmayın.
APP_ENV=prod
APP_DEBUG=0

# Uygulama Güvenlik Anahtarı (En az 32 karakterli rastgele bir string olmalı)
# Canlıya geçerken mutlaka değiştirilmelidir!
# Üret: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# CLI komutlarında (ör. URL üretimi) kullanılacak varsayılan adres
DEFAULT_URI=https://cpalius-cmf.test
###< SYMFONY: SYSTEM ENVIRONMENT <###

###> CPALIUS: CUSTOM PATHS <###
# Özel klasör yapımızın Symfony çekirdeği ve servisleri tarafından bilinmesi için tanımlar
CP_CORE_DIR="%kernel.project_dir%/cp-core"
CP_CONTENT_DIR="%kernel.project_dir%/cp-content"
CP_MODULES_DIR="%kernel.project_dir%/cp-content/modules"
CP_THEMES_DIR="%kernel.project_dir%/cp-content/themes"
CP_UPLOADS_DIR="%kernel.project_dir%/public/uploads"
###< CPALIUS: CUSTOM PATHS <###
###> CPALIUS: LOCALIZATION (FAZ 3) <###
# Çoklu dil motorunun FALLBACK zinciri. Normal koşulda aktif diller
# veritabanındaki cp_locales tablosundan (AACP > Yönetim > Diller) okunur;
# aşağıdaki değerler SADECE veritabanı erişilemez olduğunda veya tablo
# henüz boşken devreye girer (bkz. LocaleProvider).
#
# Ayrıca rota kısıtlarında kullanılan %cpalius.locales_pattern% parametresi,
# derleme anında veritabanına ulaşılamıyorsa bu listeden üretilir
# (bkz. LocalesPatternPass). Bu listeyi değiştirdikten sonra önbelleği
# yenileyin: php cp-core/bin/console cache:clear
CPALIUS_LOCALES="tr,en"
CPALIUS_DEFAULT_LOCALE="tr"
###< CPALIUS: LOCALIZATION (FAZ 3) <###


###> DOCTRINE: DATABASE CONFIGURATION <###
# SQLite kullanımı (Geliştirme aşamasında kurulum gerektirmez, jet hızındadır)
# DATABASE_URL="sqlite:///%kernel.project_dir%/cp-core/var/data.db"

# MySQL / MariaDB Kullanımı (Canlı ortam veya daha büyük projeler için - yorum satırını kaldırarak aktif edebilirsin)
#
# DİKKAT — serverVersion sunucunun GERÇEK sürümünü söylemelidir. DBAL platformu
# yalnızca bu dizeye bakarak seçer (AbstractMySQLDriver: stripos($v,'mariadb'));
# bağlanıp sunucuya sormaz. MariaDB'ye "8.0.32" derseniz DBAL MySQL platformunu
# kullanır ve sessizce yanlış davranır: MariaDB, DEFAULT NULL'u information_schema
# içinde 'NULL' METNİ olarak bildirir (MDEV-10134) ve bu metni gerçek null'a
# yalnızca MariaDB platformu çevirir. Sonuç kapanmayan bir şema farkı ve her
# istekte "The metadata storage is not up to date" hatasıdır.
#
# MySQL   : serverVersion=8.0.32           (kendi sürümünüz)
# MariaDB : serverVersion=mariadb-11.4.12  (kendi sürümünüz; SELECT VERSION() ile bakın)
DATABASE_URL="mysql://kullanici:parola@127.0.0.1:3306/cpalius?serverVersion=8.0.32&charset=utf8mb4"

# PostgreSQL Kullanımı
# DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/cpalius_db?serverVersion=16&charset=utf8"
###< DOCTRINE: DATABASE CONFIGURATION <###

###> SYMFONY: MAILER CONFIGURATION <###
# E-posta gönderim ayarları (Şimdilik boş bırakabilir veya Mailtrap/SMTP bağlayabilirsin)
MAILER_DSN=null://default
# MAILER_DSN=smtp://user:pass@smtp.mailtrap.io:2525?encryption=tls&auth_mode=login
###< SYMFONY: MAILER CONFIGURATION <###

###> SYMFONY: MESSENGER (QUEUE) CONFIGURATION <###
# Son tanımlanan DSN geçerlidir. auto_setup=0: tabloyu Doctrine migrations yönetir.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< SYMFONY: MESSENGER (QUEUE) CONFIGURATION <###

###> symfony/cache (redis) ###
# App/Doctrine/session cache. timeout=0.3: Redis kapalıyken 30sn beklemeyi önler, dosya fallback'e düşer.
REDIS_URL=redis://127.0.0.1:6379?timeout=0.3
###< symfony/cache (redis) ###

###> symfony/cache (memcached) ###
# Yalnızca HTTP fragment/ESI cache. Genel app ve Doctrine cache Redis'te.
MEMCACHED_DSN=memcached://127.0.0.1:11211
###< symfony/cache (memcached) ###
