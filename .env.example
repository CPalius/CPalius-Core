# ==============================================================================
# CPalius CMF — environment template
# Copy to .env (or .env.local) and fill in real values. Never commit secrets.
# ==============================================================================

###> CPALIUS: SYSTEM SETTINGS <###
CP_APP_NAME="CPalius CMF"
CP_APP_VERSION="1.0.0"
CP_APP_DEBUG_LEVEL="verbose"

# Recovery console: /aacp/recovery?token=...  (empty = disabled)
AACP_RECOVERY_TOKEN=

# HTTP cron trigger: /cron/execute?token=...  (empty = disabled)
CRON_TOKEN=
###< CPALIUS: SYSTEM SETTINGS <###

###> SYMFONY: SYSTEM ENVIRONMENT <###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_32_char_string
DEFAULT_URI=http://localhost
###< SYMFONY: SYSTEM ENVIRONMENT <###

###> CPALIUS: CUSTOM PATHS <###
CP_CORE_DIR="%kernel.project_dir%/cp-core"
CP_CONTENT_DIR="%kernel.project_dir%/cp-content"
CP_MODULES_DIR="%kernel.project_dir%/cp-content/modules"
CP_THEMES_DIR="%kernel.project_dir%/cp-content/themes"
CP_UPLOADS_DIR="%kernel.project_dir%/public/uploads"
###< CPALIUS: CUSTOM PATHS <###

###> DOCTRINE: DATABASE CONFIGURATION <###
# SQLite (zero-setup local default)
DATABASE_URL="sqlite:///%kernel.project_dir%/cp-core/var/data.db"

# MySQL / MariaDB
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/cpalius?serverVersion=8.0.32&charset=utf8mb4"

# PostgreSQL
# DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/cpalius?serverVersion=16&charset=utf8"
###< DOCTRINE: DATABASE CONFIGURATION <###

###> SYMFONY: MAILER CONFIGURATION <###
MAILER_DSN=null://default
###< SYMFONY: MAILER CONFIGURATION <###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/cache (redis) ###
REDIS_URL=redis://127.0.0.1:6379?timeout=0.3
###< symfony/cache (redis) ###

###> symfony/cache (memcached) ###
MEMCACHED_DSN=memcached://127.0.0.1:11211
###< symfony/cache (memcached) ###
